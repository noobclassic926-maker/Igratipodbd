        <string name="Name">BlackoutServer</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local PathfindingService = game:GetService("PathfindingService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Debris = game:GetService("Debris")

local vec, rgb = Vector3.new, Color3.fromRGB
local palette = {
    wall = rgb(42, 47, 53), metal = rgb(27, 31, 37), concrete = rgb(63, 65, 67),
    asphalt = rgb(33, 36, 41), soil = rgb(44, 48, 48), wood = rgb(68, 56, 48),
    rust = rgb(96, 65, 55), red = rgb(253, 62, 73), darkRed = rgb(112, 34, 42),
    amber = rgb(255, 172, 70), off = rgb(65, 48, 41), green = rgb(117, 229, 177),
    ice = rgb(174, 206, 224), text = rgb(237, 235, 223), black = rgb(18, 20, 25),
}
local METAL, CONCRETE, NEON = Enum.Material.Metal, Enum.Material.Concrete, Enum.Material.Neon
local MAX_PLAYERS, MATCH_TIME, PRACTICE_TIME = 5, 330, 300
local BLOCK_TIME, RESULT_TIME = 9, 8
local ATTACK_COOLDOWN, ATTACK_RANGE = 1.7, 8.5
local random = Random.new(701)

local function container(class, name, parent)
    local object = Instance.new(class)
    object.Name = name
    object.Parent = parent
    return object
end

local function block(parent, name, size, position, color, material, solid)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = typeof(position) == "Vector3" and CFrame.new(position) or position
    p.Anchored = true
    p.Color = color or palette.metal
    p.Material = material or METAL
    p.CanCollide = solid ~= false
    p.CanQuery = solid ~= false
    p.CanTouch = false
    p.Parent = parent
    return p
end

local function strut(parent, name, a, b, thickness, color, material, solid)
    return block(parent, name, vec(thickness, thickness, (b - a).Magnitude),
        CFrame.lookAt((a + b) / 2, b), color, material, solid)
end

local function marker(parent, name, position)
    local p = block(parent, name, vec(0.3, 0.3, 0.3), position, palette.black, METAL, false)
    p.Transparency = 1
    p.CastShadow = false
    return p
end

local function light(host, color, brightness, range)
    local bulb = container("PointLight", "Glow", host)
    bulb.Color = color
    bulb.Brightness = brightness
    bulb.Range = range
    return bulb
end

local function sign(host, text, color, width, height, distance, offset)
    local gui = container("BillboardGui", "Sign", host)
    gui.Size = UDim2.fromScale(width, height)
    gui.StudsOffsetWorldSpace = offset or Vector3.zero
    gui.MaxDistance = distance
    gui.LightInfluence = 0
    local label = container("TextLabel", "Text", gui)
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = palette.black
    label.BackgroundTransparency = 0.18
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Text = text
    local pad = container("UIPadding", "Inset", label)
    pad.PaddingLeft = UDim.new(0.055, 0)
    pad.PaddingRight = UDim.new(0.055, 0)
    return label
end

Lighting.ClockTime = 1.7
Lighting.Brightness = 1.55
Lighting.Ambient = rgb(67, 72, 83)
Lighting.OutdoorAmbient = rgb(83, 91, 103)
Lighting.EnvironmentDiffuseScale = 0.32
Lighting.EnvironmentSpecularScale = 0.45
Lighting.GlobalShadows = true
Lighting.FogColor = rgb(44, 49, 59)
Lighting.FogStart = 42
Lighting.FogEnd = 188
local grade = container("ColorCorrectionEffect", "Blackout Grade", Lighting)
grade.Contrast = 0.11
grade.Saturation = -0.22
grade.TintColor = rgb(237, 240, 255)
local bloom = container("BloomEffect", "Signal Glow", Lighting)
bloom.Intensity = 0.24
bloom.Size = 25
bloom.Threshold = 1.08

local arena = container("Model", "Site 07 - Runtime Map", workspace)
local lobby = container("Model", "Control Room - Lobby", workspace)
local effects = container("Folder", "Blackout Effects", workspace)
local ground = workspace:FindFirstChild("SiteGround")
if not ground then
    ground = block(workspace, "SiteGround", vec(262, 3, 248), vec(0, -1.5, 0), palette.soil)
end
ground.Material = Enum.Material.Slate
ground.Color = palette.soil
ground.TopSurface = Enum.SurfaceType.Smooth
ground.BottomSurface = Enum.SurfaceType.Smooth

local generators, gates, cells = {}, {}, {}

local function fence(ax, az, bx, bz)
    local a, b = vec(ax, 0, az), vec(bx, 0, bz)
    local length = (b - a).Magnitude
    local face = CFrame.lookAt((a + b) / 2, b)
    local invisible = block(arena, "Fence Collision", vec(0.8, 10, length), face + vec(0, 5, 0))
    invisible.Transparency = 1
    invisible.CastShadow = false
    block(arena, "Fence Base", vec(2.2, 1.6, length), face + vec(0, 0.8, 0), palette.concrete, CONCRETE, false)
    for _, y in ipairs({2.6, 6.4, 9.1}) do
        block(arena, "Fence Rail", vec(0.4, 0.36, length), face + vec(0, y, 0), palette.wall, METAL, false)
    end
    local count = math.floor(length / 3.8)
    for i = 0, count do
        local pos = a:Lerp(b, i / count)
        block(arena, "Fence Picket", vec(0.31, 8.5, 0.31), pos + vec(0, 5.3, 0), palette.metal, METAL, false)
    end
end

local function shed(name, x, z, w, d, number)
    local model = container("Model", name, arena)
    local height = 12
    local opening = 12
    block(model, "Foundation", vec(w, 0.2, d), vec(x, 0.05, z), palette.concrete, CONCRETE, false)
    for _, sx in ipairs({-1, 1}) do
        block(model, "Side Wall", vec(1, height, d), vec(x + sx * w / 2, height / 2, z), palette.wall, Enum.Material.CorrodedMetal)
        for _, sz in ipairs({-1, 1}) do
            block(model, "End Wall", vec((w - opening) / 2, height, 1),
                vec(x + sx * (w + opening) / 4, height / 2, z + sz * d / 2), palette.wall, Enum.Material.CorrodedMetal)
        end
        local beam = block(model, "Roof Panel", vec(w / 2 + 1.2, 0.75, d + 3),
            CFrame.new(x + sx * w / 4, 13, z) * CFrame.Angles(0, 0, math.rad(-6 * sx)), palette.metal, METAL)
        beam.CastShadow = true
        for _, sz in ipairs({-1, 1}) do
            local column = vec(x + sx * (opening / 2 + 0.35), 5.4, z + sz * (d / 2 + 0.15))
            block(model, "Door Jamb", vec(0.8, 10.8, 0.9), column, palette.rust, METAL, false)
            block(model, "Corner Column", vec(1.2, 12, 1.2),
                vec(x + sx * w / 2, 6, z + sz * d / 2), palette.metal, METAL, false)
        end
    end
    for _, sz in ipairs({-1, 1}) do
        block(model, "Lintel", vec(opening, 2.5, 0.9), vec(x, 10.75, z + sz * d / 2), palette.metal, METAL)
        local plate = marker(model, "Door Number", vec(x, 10.6, z + sz * (d / 2 + 1)))
        sign(plate, number .. " / " .. name, palette.ice, 10, 1.65, 65)
        local tube = block(model, "Door Light", vec(5.2, 0.18, 0.25),
            vec(x, 8.9, z + sz * (d / 2 + 0.55)), palette.ice, NEON, false)
        light(tube, palette.ice, 1.0, 21)
    end
    local inside = block(model, "Work Light", vec(5.6, 0.24, 0.34), vec(x, 10.2, z), palette.amber, NEON, false)
    light(inside, palette.amber, 1.4, 24)
end

local function crate(x, z, width, height, depth, rotated)
    local model = container("Model", "Freight", arena)
    local pose = CFrame.new(x, height / 2, z) * CFrame.Angles(0, math.rad(rotated or 0), 0)
    block(model, "Cargo", vec(width, height, depth), pose, palette.wood, Enum.Material.WoodPlanks)
    for _, sx in ipairs({-1, 1}) do
        block(model, "Strap", vec(0.35, height + 0.15, depth + 0.15),
            pose * CFrame.new(sx * width / 3, 0, 0), palette.metal, METAL, false)
    end
    block(model, "Marking", vec(width * 0.62, 0.35, 0.06), pose * CFrame.new(0, height / 4, -depth / 2 - 0.04), palette.rust, METAL, false)
end

local function tower(x, z, color)
    local model = container("Model", "Signal Post", arena)
    block(model, "Footing", vec(3, 1.1, 3), vec(x, 0.55, z), palette.concrete, CONCRETE)
    block(model, "Mast", vec(0.65, 13, 0.65), vec(x, 6.5, z), palette.metal)
    block(model, "Beam", vec(4.3, 0.5, 0.55), vec(x + 1.7, 12.1, z), palette.metal, METAL, false)
    local emitter = block(model, "Lamp", vec(2.4, 0.38, 1), vec(x + 2.55, 11.68, z), color, NEON, false)
    light(emitter, color, 1.8, 29)
end

local function tree(x, z, solid)
    local model = container("Model", "Pine", arena)
    local height = random:NextNumber(16, 27)
    local trunk = vec(x, height * 0.45, z)
    block(model, "Trunk", vec(1.35, height * 0.9, 1.35), trunk, rgb(45, 43, 44), Enum.Material.Wood, solid)
    for i = 0, 3 do
        local w = height * (0.39 - i * 0.064)
        local leaf = 35 + 3 * i + random:NextInteger(-6, 5)
        block(model, "Canopy", vec(w, height * 0.19, w),
            CFrame.new(x, height * (0.51 + i * 0.153), z) * CFrame.Angles(0, math.rad(45 + i * 20), 0),
            rgb(leaf - 9, leaf + 3, leaf), Enum.Material.Grass, false)
    end
end

local function generator(x, z, number)
    local model = container("Model", "Generator " .. number, arena)
    block(model, "Skid", vec(6.6, 0.44, 4.2), vec(x, 0.22, z), palette.metal, Enum.Material.DiamondPlate)
    block(model, "Housing", vec(5.55, 3.1, 3.15), vec(x, 1.88, z), palette.rust, Enum.Material.CorrodedMetal)
    block(model, "Service Panel", vec(4, 2.1, 0.18), vec(x, 1.85, z + 1.66), palette.black, METAL, false)
    for index = -3, 3 do
        block(model, "Vent", vec(0.31, 0.78, 0.11), vec(x + index * 0.44, 1.52, z + 1.79), palette.wall, METAL, false)
    end
    local lamps = {}
    for i = 1, 3 do
        lamps[i] = block(model, "Circuit " .. i, vec(0.68, 0.23, 0.12),
            vec(x + (i - 2) * 0.92, 2.57, z + 1.82), palette.off, METAL, false)
    end
    local hazard = block(model, "Beacon", vec(0.62, 0.45, 0.62), vec(x + 2.2, 3.62, z), palette.amber, NEON, false)
    local spot = light(hazard, palette.amber, 0.8, 12)
    local anchor = marker(model, "Service Point", vec(x, 3.75, z))
    local label = sign(anchor, "ГЕНЕРАТОР " .. number, palette.amber, 6.9, 1.15, 45, vec(0, 2, 0))
    table.insert(generators, {anchor = anchor, lamps = lamps, bulb = hazard, light = spot, label = label, number = number, steps = 0})
end

local function makeGate(x, z, code, direction, terminalSide)
    local model = container("Model", "Exit " .. code, arena)
    for _, side in ipairs({-1, 1}) do
        block(model, "Gate Frame", vec(1.8, 14, 2.4), vec(x + side * 7.5, 7, z), palette.concrete, CONCRETE)
        block(model, "Exit Channel", vec(0.8, 8, 22), vec(x + side * 7.7, 4, z + direction * 11), palette.wall)
    end
    block(model, "Header", vec(17, 2.2, 2.1), vec(x, 13.1, z), palette.metal)
    block(model, "End Stop", vec(16, 6, 1.2), vec(x, 3, z + direction * 21), palette.wall)
    local door = block(model, "Roller Shutter", vec(13.4, 10.7, 1.3), vec(x, 5.35, z), palette.wall, Enum.Material.DiamondPlate)
    local lamp = block(model, "Gate Signal", vec(9, 0.32, 0.58), vec(x, 11.6, z - direction * 1.12), palette.red, NEON, false)
    local glow = light(lamp, palette.red, 1.8, 26)
    local label = sign(lamp, "ВЫХОД " .. code .. " / НЕТ ПИТАНИЯ", palette.red, 13, 1.6, 82, vec(0, 3.4, 0))
    local tx, tz = x + terminalSide * 10.6, z - direction * 6.5
    block(model, "Terminal", vec(2.05, 3.35, 1.65), vec(tx, 1.67, tz), palette.metal, Enum.Material.DiamondPlate)
    local panel = block(model, "Terminal Signal", vec(1.1, 0.4, 0.51), vec(tx, 3.45, tz), palette.red, NEON, false)
    local anchor = marker(model, "Gate Control", vec(tx, 3.8, tz))
    table.insert(gates, {
        code = code, x = x, z = z, dir = direction, door = door, closed = door.CFrame, lamp = lamp,
        panel = panel, light = glow, label = label, anchor = anchor, open = false,
    })
end

local function makeCell(x, z, number)
    local model = container("Model", "Containment " .. number, arena)
    block(model, "Cell Floor", vec(9, 0.42, 8.8), vec(x, 0.15, z), palette.concrete, CONCRETE, false)
    for _, side in ipairs({-1, 1}) do
        for i = -2, 2 do
            block(model, "Cage Bar", vec(0.28, 8.1, 0.28), vec(x + side * 4.2, 4.1, z + i * 1.95), palette.wall, METAL, false)
        end
        block(model, "Cell Post", vec(0.85, 8.3, 0.85), vec(x + side * 4.2, 4.15, z + 4.2), palette.metal)
    end
    for i = -2, 2 do
        block(model, "Cage Back", vec(0.28, 8.1, 0.28), vec(x + i * 1.8, 4.1, z + 4.2), palette.wall, METAL, false)
    end
    block(model, "Cell Canopy", vec(9, 0.5, 9.05), vec(x, 8.12, z), palette.metal)
    local lamp = block(model, "Cell Signal", vec(4.2, 0.24, 0.4), vec(x, 7.9, z - 4.55), palette.darkRed, NEON, false)
    local glow = light(lamp, palette.red, 0.45, 16)
    sign(lamp, "ИЗОЛЯТОР " .. number, palette.red, 7.1, 1.18, 49, vec(0, 1.3, 0))
    table.insert(cells, {x = x, z = z, lamp = lamp, light = glow})
end

do
    fence(-109, -94, -109, 94)
    fence(109, -94, 109, 94)
    fence(-109, -94, -63.5, -94)
    fence(-48.5, -94, 109, -94)
    fence(-109, 94, 49.5, 94)
    fence(64.5, 94, 109, 94)
    makeGate(-56, -94, "A", -1, 1)
    makeGate(57, 94, "B", 1, -1)

    for _, z in ipairs({-27, 14, 61}) do
        block(arena, "Service Lane", vec(209, 0.05, 10), vec(0, 0.033, z), palette.asphalt, Enum.Material.Asphalt, false)
        for x = -94, 94, 12 do
            block(arena, "Lane Marking", vec(4.7, 0.03, 0.15), vec(x, 0.069, z), palette.concrete, CONCRETE, false)
        end
    end
    shed("МАШЗАЛ", 0, -12, 44, 32, "02")
    shed("ЦЕХ", -56, 32, 35, 30, "01")
    shed("ПОДСТАНЦИЯ", 56, -48, 32, 24, "03")
    crate(-18, -12, 4, 6, 6, 4)
    crate(17, -18, 5, 5.7, 5.8, -8)
    crate(-44, 34, 5, 5, 5.5, 0)
    crate(65, -40, 4.5, 6, 5.4, 0)
    crate(53, 42, 15, 7.3, 4.4, 0)
    crate(65, 54, 5, 5.2, 12.5, -4)
    crate(48, 54, 5, 4.1, 6.5, 9)
    crate(-72, -59, 12, 5.5, 4.5, -9)
    crate(-81, -42, 4.4, 5.1, 7.3, 6)
    crate(-11, 36, 7, 5.2, 6.2, 15)
    crate(29, -65, 6.1, 5.7, 8.2, 7)
    crate(87, -9, 9.4, 6.4, 7, -9)
    crate(5, 71, 13, 5.8, 4, 7)
    crate(-49, 67, 8.2, 7.6, 5.8, 0)

    generator(-66, 32, "01")
    generator(8, -12, "02")
    generator(55, -49, "03")
    generator(56, 49, "04")
    generator(-68, -50, "05")

    makeCell(-28, -45, "01")
    makeCell(27, 30, "02")
    makeCell(-83, 67, "03")
    tower(-61, -47, palette.amber)
    tower(-25, 19, palette.ice)
    tower(40, 53, palette.amber)
    tower(30, -76, palette.ice)
    tower(89, 28, palette.red)
    tower(-86, 40, palette.ice)
    tower(3, 82, palette.ice)

    for z = -94, 94, 15 do
        tree(-120 + random:NextNumber(-3, 2), z + random:NextNumber(-3, 2), false)
        tree(120 + random:NextNumber(-3, 2), z + random:NextNumber(-3, 2), false)
    end
    for x = -99, 100, 17 do
        if math.abs(x + 56) > 12 then tree(x, -112, false) end
        if math.abs(x - 57) > 12 then tree(x + 2, 114, false) end
    end
    for _, p in ipairs({{-97, -71}, {-91, -60}, {-92, -5}, {-88, 0}, {-99, 57}, {-97, 71},
        {91, -58}, {95, -62}, {99, 56}, {90, 60}, {77, 75}, {8, -66}, {-14, -78}, {-62, 79}}) do
        tree(p[1], p[2], true)
    end
end

local lobbyPosition = vec(0, 3.25, 298)
local lobbyFacing = vec(0, 3.25, 281)
local spawn = Instance.new("SpawnLocation")
spawn.Name = "ControlRoomSpawn"
spawn.Size = vec(8, 0.28, 7)
spawn.CFrame = CFrame.new(0, 0.1, 298)
spawn.Neutral = true
spawn.Enabled = true
