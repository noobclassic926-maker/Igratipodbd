        light(lamp, palette.ice, 1.8, 48)
        block(lobby, "Guide Stripe", vec(0.32, 0.04, 38), vec(side * 8.5, 0.03, 290), palette.rust, METAL, false)
    end
    block(lobby, "Console", vec(15, 2.8, 3.3), vec(0, 1.4, 277), palette.black, Enum.Material.DiamondPlate)
