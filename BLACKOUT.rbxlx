        block(lobby, "Long Wall", vec(1.4, 13, 42), vec(side * 27.7, 6.5, 290), palette.wall, CONCRETE)
        block(lobby, "End Wall", vec(56, 13, 1.4), vec(0, 6.5, 290 + side * 20.4), palette.metal, CONCRETE)
