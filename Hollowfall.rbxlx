	P("LeftHand", "Block", { 0.1, 0.5, 0.1 }, { 0, -0.4, 0 }, Z, "dark"),
	P("LeftHand", "Block", { 0.62, 0.12, 0.62 }, { 0, -0.7, 0 }, Z, "dark", "Metal"),
	P("LeftHand", "Block", { 0.5, 0.7, 0.5 }, { 0, -1.1, 0 }, Z, "glow", "Neon", { tr = 0.2, light = "#ffb347", range = 20 }),
	P("LeftHand", "Block", { 0.62, 0.12, 0.62 }, { 0, -1.5, 0 }, Z, "dark", "Metal"),
} }

Cosmetics.Accessories = A

--// ------------------------------------------------------------------ ЦВЕТА / МАТЕРИАЛЫ
local NAMED = {
	dark = "#15151a", bone = "#d9d2c1", steel = "#aab4c0", white = "#f4f4f5", gold = "#e0b030", wood = "#3b2a1a",
}
local function colorOf(key, pal)
	if key == "glow" then
		return Color3.fromHex(pal.acc or "#ffffff")
	end
	local hex = pal[key] or NAMED[key]
	if hex then
		return Color3.fromHex(hex)
	end
	if string.sub(key, 1, 1) == "#" then
		return Color3.fromHex(key)
	end
	return Color3.fromRGB(120, 120, 120)
end

local function materialOf(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	if ok and m then
		return m
	end
	return Enum.Material.Fabric
end

--// ------------------------------------------------------------------ ПРИМЕНЕНИЕ
local function buildPart(model, folder, spec, pal, k)
	local att = model:FindFirstChild(spec[1])
	if not att or not att:IsA("BasePart") then
		return
	end
	local shape = spec[2]
	local p
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
	end
	local size = spec[3]
	p.Size = Vector3.new(math.max(size[1] * k, 0.05), math.max(size[2] * k, 0.05), math.max(size[3] * k, 0.05))
	p.Color = colorOf(spec[6], pal)
	p.Material = materialOf(spec[7])
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local opt = spec[8]
	if opt and opt.tr then
		p.Transparency = opt.tr
	end
	if shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	if opt and opt.light then
		local l = Instance.new("PointLight")
		l.Color = Color3.fromHex(opt.light)
		l.Range = opt.range or 14
		l.Brightness = 1.2
		l.Shadows = false
		l.Parent = p
	end
	local pos, rot = spec[4], spec[5]
	local w = Instance.new("Weld")
	w.Part0 = att
	w.Part1 = p
	w.C0 = CFrame.new(pos[1] * k, pos[2] * k, pos[3] * k) * CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
	w.Parent = p
	p.Parent = folder
end

local function setColor(model, names, color)
	for _, n in ipairs(names) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			p.Color = color
		end
	end
end

function Cosmetics.SetScale(model, k)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	for _, n in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }) do
		local v = hum:FindFirstChild(n)
		if v and v:IsA("NumberValue") then
			v.Value = k
		end
	end
end

function Cosmetics.GetScale(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local v = hum and hum:FindFirstChild("BodyHeightScale")
	if v and v:IsA("NumberValue") then
		return v.Value
	end
	return 1
end

--// Список косметики для персонажа: скин + выбранные аксессуары (замена по слотам)
function Cosmetics.ResolveItems(charId, skinId, equippedAcc, isKiller)
	local skin = Config.SkinById[skinId] or Config.SkinById[Config.DefaultSkinFor(charId)]
	local items = {}
	for _, id in ipairs(skin.items) do
		table.insert(items, id)
	end
	if equippedAcc and not isKiller then
		for slot, itemId in pairs(equippedAcc) do
			local it = Config.Items[itemId]
			if it and it.cos and A[it.cos] then
				local filtered = {}
				for _, id in ipairs(items) do
					if not (A[id] and A[id].slot == slot) then
						table.insert(filtered, id)
					end
				end
				table.insert(filtered, it.cos)
				items = filtered
			end
		end
	end
	return items, skin
end

--// Эффекты-частицы
local FX = {
	fx_blood = { rate = 9, life = NumberRange.new(0.8, 1.4), speed = NumberRange.new(0.5, 2), size = 0.16, accel = Vector3.new(0, -28, 0), spread = 40, light = 0, tr = 0 },
	fx_ember = { rate = 16, life = NumberRange.new(1.0, 1.8), speed = NumberRange.new(1, 3), size = 0.24, accel = Vector3.new(0, 5, 0), spread = 180, light = 1, tr = 0.1 },
	fx_mist = { rate = 8, life = NumberRange.new(1.8, 2.6), speed = NumberRange.new(0.5, 1.5), size = 2.6, accel = Vector3.new(0, 0.6, 0), spread = 180, light = 0, tr = 0.7 },
	fx_ghost = { rate = 9, life = NumberRange.new(1.6, 2.4), speed = NumberRange.new(1, 2.5), size = 0.6, accel = Vector3.new(0, 3, 0), spread = 180, light = 1, tr = 0.35 },
	fx_neon = { rate = 22, life = NumberRange.new(0.8, 1.3), speed = NumberRange.new(3, 6), size = 0.3, accel = Vector3.new(0, 0, 0), spread = 180, light = 1, tr = 0.1 },
	fx_stars = { rate = 20, life = NumberRange.new(1.2, 2), speed = NumberRange.new(1, 3), size = 0.42, accel = Vector3.new(0, 1.5, 0), spread = 180, light = 1, tr = 0 },
}

function Cosmetics.ClearFx(model)
	local t = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
	if t then
		for _, c in ipairs(t:GetChildren()) do
			if c.Name == "HFFx" then
				c:Destroy()
			end
		end
	end
end

function Cosmetics.AddFx(model, fxId, hex)
	local def = FX[fxId]
	local t = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
	if not t then
		return
	end
	local color
	if hex then
		color = Color3.fromHex(hex)
	elseif Config.Effects[fxId] then
		color = Color3.fromHex(Config.Effects[fxId].color)
	else
		color = Color3.new(1, 1, 1)
	end
	if not def then
		def = FX.fx_stars
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "HFFx"
	e.Rate = def.rate
	e.Lifetime = def.life
	e.Speed = def.speed
	e.Acceleration = def.accel
	e.SpreadAngle = Vector2.new(def.spread, def.spread)
	e.LightEmission = def.light
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, def.size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, def.tr), NumberSequenceKeypoint.new(0.7, def.tr + (1 - def.tr) * 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Rotation = NumberRange.new(0, 360)
	e.Parent = t
end

--// Главная функция. opts: { scale, effect, showFx, isKiller }
function Cosmetics.Apply(model, charId, skinId, equippedAcc, opts)
	opts = opts or {}
	local cfg = Config.GetChar(charId)
	if not cfg then
		return
	end
	local isKiller = Config.Killers[charId] ~= nil
	local old = model:FindFirstChild("Costume")
	if old then
		old:Destroy()
	end
	Cosmetics.ClearFx(model)

	local k = opts.scale or cfg.scale or 1
	Cosmetics.SetScale(model, k)

	local items, skin = Cosmetics.ResolveItems(charId, skinId, equippedAcc, isKiller)
	local pal = skin.pal
	local skinC, shirtC, pantsC, shoeC = Color3.fromHex(pal.skin), Color3.fromHex(pal.shirt), Color3.fromHex(pal.pants), Color3.fromHex(pal.shoes)

	setColor(model, { "Head" }, skinC)
	setColor(model, { "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm" }, shirtC)
	setColor(model, { "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" }, skinC)
	setColor(model, { "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg" }, pantsC)
	setColor(model, { "LeftFoot", "RightFoot" }, shoeC)
	local bc = model:FindFirstChildOfClass("BodyColors")
	if bc then
		bc.HeadColor3 = skinC
		bc.TorsoColor3 = shirtC
		bc.LeftArmColor3 = skinC
		bc.RightArmColor3 = skinC
		bc.LeftLegColor3 = pantsC
		bc.RightLegColor3 = pantsC
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Accessory") then
			d:Destroy()
		end
	end

	local head = model:FindFirstChild("Head")
	if head then
		local face = head:FindFirstChildOfClass("Decal")
		if not face then
			face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = head
		end
		face.Transparency = isKiller and 1 or 0
	end

	local folder = Instance.new("Folder")
	folder.Name = "Costume"
	for _, id in ipairs(items) do
		local acc = A[id]
		if acc then
			for _, spec in ipairs(acc.parts) do
				buildPart(model, folder, spec, pal, k)
			end
		end
	end
	folder.Parent = model

	if opts.showFx then
		if opts.effect and opts.effect ~= "" and Config.Effects[opts.effect] then
			Cosmetics.AddFx(model, opts.effect)
		end
		if skin.aura then
			Cosmetics.AddFx(model, "fx_stars", skin.aura)
		end
	end
	model:SetAttribute("CharId", charId)
	model:SetAttribute("SkinId", skin.id)
end

--// Убийцы получают вечную эффектную ауру только из скина (без выбора игрока) — см. MatchService
return Cosmetics
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24">
        <Properties>
          <string name="Name">LightingFx</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Shared/LightingFx — применение настроек освещения/атмосферы (сервер: лобби, клиент: карты матча)
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LightingFx = {}

local function ensure(class, name)
	local o = Lighting:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = Lighting
	end
	return o
end

function LightingFx.Apply(L, instant)
	local atm = ensure("Atmosphere", "HFAtmosphere")
	local cc = ensure("ColorCorrectionEffect", "HFColor")
	local bloom = ensure("BloomEffect", "HFBloom")
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.StarCount = 3500
		sky.CelestialBodiesShown = true
		sky.Parent = Lighting
	end
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.ExposureCompensation = 0
	atm.Glare = 0
	atm.Haze = 1.6
	atm.Offset = 0.2
	atm.Decay = Color3.fromRGB(70, 60, 90)
	bloom.Size = 24
	bloom.Threshold = 1.1

	local lightProps = {
		ClockTime = L.clock, Ambient = L.ambient, OutdoorAmbient = L.outdoor, Brightness = L.brightness,
		FogColor = L.fog, FogStart = L.fogStart, FogEnd = L.fogEnd,
	}
	local atmProps = { Density = L.density, Color = L.atm }
	local ccProps = { TintColor = L.tint, Saturation = L.saturation, Contrast = L.contrast }
	local bloomProps = { Intensity = L.bloom }
	if instant then
		for k, v in pairs(lightProps) do
			(Lighting :: any)[k] = v
		end
		for k, v in pairs(atmProps) do
			(atm :: any)[k] = v
		end
		for k, v in pairs(ccProps) do
			(cc :: any)[k] = v
		end
		for k, v in pairs(bloomProps) do
			(bloom :: any)[k] = v
		end
	else
		local ti = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(Lighting, ti, lightProps):Play()
		TweenService:Create(atm, ti, atmProps):Play()
		TweenService:Create(cc, ti, ccProps):Play()
		TweenService:Create(bloom, ti, bloomProps):Play()
	end
end

return LightingFx
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX25">
        <Properties>
          <string name="Name">Net</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Shared/Net
--// Централизованный доступ к RemoteEvent / RemoteFunction. Сервер создаёт недостающие, клиент ждёт их появления.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}
Net.EventNames = {"Notify","ProfileUpdate","QueueUpdate","LobbyState","MatchStart","MatchState","MatchEnd","ToLobby","AbilityFx","InteractUpdate","SkillCheck","Vault","Sfx","QueueJoin","QueueLeave","VoteMap","StartNow","Ability","Interact","Attack","SetStance","SkillCheckResult","PlayEmote","SaveSettings"}
Net.FunctionNames = {"GetProfile","Purchase","Equip","ClaimDaily"}

local isServer = RunService:IsServer()
local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	if isServer then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
end

local function get(name, class)
	local r = folder:FindFirstChild(name)
	if not r then
		if isServer then
			r = Instance.new(class)
			r.Name = name
			r.Parent = folder
		else
			r = folder:WaitForChild(name)
		end
	end
	return r
end

function Net.E(name)
	return get(name, "RemoteEvent")
end

function Net.F(name)
	return get(name, "RemoteFunction")
end

if isServer then
	for _, n in ipairs(Net.EventNames) do
		get(n, "RemoteEvent")
	end
	for _, n in ipairs(Net.FunctionNames) do
		get(n, "RemoteFunction")
	end
end

return Net
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX26">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX27">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">1</token>
        <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: точка входа сервера
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

Players.CharacterAutoLoads = false

local Server = script.Parent:WaitForChild("Server")
local Shared = ReplicatedStorage:WaitForChild("Shared")

require(Shared:WaitForChild("Net")) -- создаёт недостающие RemoteEvent/RemoteFunction
local Data = require(Server:WaitForChild("DataService"))
local Shop = require(Server:WaitForChild("ShopService"))
local Match = require(Server:WaitForChild("MatchService"))

Data.Init()
Shop.Init()
Match.Init()

print("[Hollowfall] Сервер запущен. Игроков: " .. #Players:GetPlayers())
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX28">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX29">
        <Properties>
          <string name="Name">BotService</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: BotService — ИИ выживших и убийцы (используют те же серверные действия, что и игроки)
local PathfindingService = game:GetService("PathfindingService")

local Bots = {}
local rng = Random.new()

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end
local function objPos(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return (inst :: BasePart).Position
end
local function alive(a)
	return a.state ~= "Dead" and a.state ~= "Escaped"
end
local function ownSurv(a)
	return a.state == "Healthy" or a.state == "Injured"
end

--// Движение с поиском пути
local function goTo(a, pos)
	local now = os.clock()
	local hd = flat(a.root.Position - pos).Magnitude
	if hd < 5 then
		a.hum:MoveTo(pos)
		a.wps = nil
		return
	end
	if not a.wps or now - (a.pathT or 0) > 1.8 or (a.pathGoal and (a.pathGoal - pos).Magnitude > 10) then
		a.pathT = now
		a.pathGoal = pos
		local path = PathfindingService:CreatePath({ AgentRadius = 2.2, AgentHeight = 5.5, AgentCanJump = false, WaypointSpacing = 6 })
		local ok = pcall(function()
			path:ComputeAsync(a.root.Position - Vector3.new(0, 2.5, 0), pos)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			a.wps = path:GetWaypoints()
			a.wi = 2
		else
			a.wps = nil
		end
	end
	if a.wps then
		local wp = a.wps[a.wi]
		while wp and flat(a.root.Position - wp.Position).Magnitude < 3.5 do
			a.wi += 1
			wp = a.wps[a.wi]
		end
		a.hum:MoveTo(wp and wp.Position or pos)
	else
		a.hum:MoveTo(pos)
	end
end

local function nearest(list, a, maxD, filter)
	local best, bd = nil, maxD
	for _, o in ipairs(list) do
		if not filter or filter(o) then
			local d = flat(a.root.Position - objPos(o)).Magnitude
			if d < bd then
				best, bd = o, d
			end
		end
	end
	return best, bd
end

--// ---------------------------------------------------------------- ВЫЖИВШИЙ
local function survivorThink(M, match, a)
	local k = match.killer
	local reg = match.K.reg
	local kd = alive(k) and flat(a.root.Position - k.root.Position).Magnitude or 999
	local danger = kd < 28 and os.clock() >= k.veilUntil
	if a.state == "Downed" or a.state == "Hooked" or a.state == "Carried" or a.state == "Hiding" then
		a.reqSprint = false
		return
	end
	if a.busy then
		if danger and kd < 20 then
			M.Stop(a)
		else
			return
		end
	end
	if danger then
		a.reqSprint = true
		a.reqCrouch = false
		if kd < 12 then
			local p = nearest(reg.pallets, a, 9, function(x)
				return x:GetAttribute("State") == "Up"
			end)
			if p and M.Do(a, "Drop", p) then
				return
			end
			local w = nearest(reg.windows, a, 6, function(x)
				return (x:GetAttribute("Busy") or 0) < os.clock()
			end)
			if w and rng:NextNumber() < 0.6 and M.Do(a, "Vault", w) then
				return
			end
			if a.charId == "kai" or a.charId == "alex" or a.charId == "lina" or a.charId == "eva" then
				M.Ability(a)
			end
		end
		-- убегаем к цели, максимально далёкой от убийцы
		local best, bs = nil, -1e9
		for _, g in ipairs(reg.generators) do
			if not g:GetAttribute("Done") then
				local gp = objPos(g)
				local score = flat(gp - k.root.Position).Magnitude - 0.6 * flat(gp - a.root.Position).Magnitude
				if score > bs then
					best, bs = gp, score
				end
			end
		end
		for _, h in ipairs(reg.pallets) do
			if h:GetAttribute("State") == "Up" then
				local hp = objPos(h)
				local score = flat(hp - k.root.Position).Magnitude - 0.9 * flat(hp - a.root.Position).Magnitude + 15
				if score > bs and flat(hp - a.root.Position).Magnitude < 60 then
					best, bs = hp, score
				end
			end
		end
		goTo(a, best or (a.root.Position + flat(a.root.Position - k.root.Position).Unit * 30))
		return
	end
	a.reqSprint = false
	a.reqCrouch = false
	if a.state == "Injured" and kd > 40 and rng:NextNumber() < 0.3 and M.Do(a, "Heal", nil) then
		return
	end
	-- спасение
	for _, s in ipairs(match.survivors) do
		if s ~= a and s.state == "Hooked" and s.hookObj and flat(s.hookObj:GetPivot().Position - k.root.Position).Magnitude > 38 then
			local hp = s.hookObj:GetPivot().Position
			if flat(a.root.Position - hp).Magnitude < 7 then
				M.Do(a, "Unhook", s.model)
			else
				goTo(a, hp + Vector3.new(0, 0, 0))
			end
			return
		end
		if s ~= a and s.state == "Injured" and rng:NextNumber() < 0.15 and flat(a.root.Position - s.root.Position).Magnitude < 6 then
			M.Do(a, "Heal", s.model)
			return
		end
	end
	-- побег
	if match.powered then
		local gate = nearest(reg.gates, a, 1e9, function(x)
			return true
		end)
		if gate then
			if gate:GetAttribute("Open") then
				local zone = gate:FindFirstChild("EscapeZone")
				if zone and zone:IsA("BasePart") then
					a.reqSprint = true
					goTo(a, zone.Position)
				end
			else
				local gp = gate.PrimaryPart and gate.PrimaryPart.Position or gate:GetPivot().Position
				if flat(a.root.Position - gp).Magnitude < 6.5 then
					M.Do(a, "OpenGate", gate)
				else
					goTo(a, gp)
				end
			end
		end
		return
	end
	-- генераторы
	local best, bs = nil, 1e9
	for _, g in ipairs(reg.generators) do
		if not g:GetAttribute("Done") then
			local gp = objPos(g)
			local score = flat(gp - a.root.Position).Magnitude + ((a.id * 17 + g:GetAttribute("Id") * 11) % 40)
			if kd < 999 then
				score = score + math.max(0, 70 - flat(gp - k.root.Position).Magnitude)
			end
			if score < bs then
				best, bs = g, score
			end
		end
	end
	if best then
		local gp = objPos(best)
		if flat(a.root.Position - gp).Magnitude < 5.5 then
			if not M.Do(a, "Repair", best) then
				goTo(a, gp)
			end
		else
			goTo(a, gp + Vector3.new(0, 0, 3))
		end
	end
end

--// ---------------------------------------------------------------- УБИЙЦА
local function killerThink(M, match, a)
	local reg = match.K.reg
	local now = os.clock()
	if a.busy or now < a.stunUntil or now < a.vaultUntil then
		return
	end
	if a.carrying then
		local hook, bd = nil, 1e9
		for _, h in ipairs(reg.hooks) do
			if not h:GetAttribute("Occupied") then
				local d = flat(a.root.Position - objPos(h)).Magnitude
				if d < bd then
					hook, bd = h, d
				end
			end
		end
		if hook then
			if bd < 6 then
				M.Do(a, "Hook", hook)
			else
				goTo(a, objPos(hook) + Vector3.new(0, 0, 0))
			end
		end
		return
	end
	-- цель
	local target, td = nil, 1e9
	for _, s in ipairs(match.survivors) do
		if (ownSurv(s) or s.state == "Downed") and not s.carriedBy then
			local d = flat(a.root.Position - s.root.Position).Magnitude
			local score = d
			if s.state == "Downed" then
				score = d - 20
			end
			if d < 85 and score < td then
				target, td = s, score
			end
		end
	end
	if target then
		local d = flat(a.root.Position - target.root.Position).Magnitude
		local tp = target.root.Position
		if target.state == "Downed" then
			if d < 5 then
				M.Do(a, "Pickup", target.model)
			else
				goTo(a, tp)
			end
			return
		end
		if d < 6.8 then
			a.root.CFrame = CFrame.lookAt(a.root.Position, Vector3.new(tp.X, a.root.Position.Y, tp.Z))
			M.Attack(a)
		else
			goTo(a, tp)
		end
		local id = a.cfg.ability.id
		if id == "harvest" and d > 12 and d < 30 then
			a.root.CFrame = CFrame.lookAt(a.root.Position, Vector3.new(tp.X, a.root.Position.Y, tp.Z))
			M.Ability(a)
		elseif id == "snare" and d > 14 and rng:NextNumber() < 0.25 then
			M.Ability(a)
		end
		-- ломаем баррикаду на пути
		local p = nearest(reg.pallets, a, 5, function(x)
			return x:GetAttribute("State") == "Dropped"
		end)
		if p and d > 8 and rng:NextNumber() < 0.6 then
			M.Do(a, "Break", p)
		end
		local w = nearest(reg.windows, a, 4.5, function(x)
			return (x:GetAttribute("Busy") or 0) < now
		end)
		if w and d > 6 and d < 25 and rng:NextNumber() < 0.25 then
			M.Do(a, "Vault", w)
		end
		return
	end
	-- патруль по генераторам
	local id = a.cfg.ability.id
	if id == "sight" or id == "veil" then
		M.Ability(a)
	end
	local g, gd = nil, 1e9
	for _, o in ipairs(reg.generators) do
		if not o:GetAttribute("Done") then
			local d = flat(a.root.Position - objPos(o)).Magnitude - o:GetAttribute("Progress") * 0.6 + ((a.patrolSeed or 0) * (o:GetAttribute("Id") or 1)) % 25
			if d < gd then
				g, gd = o, d
			end
		end
	end
	if not a.patrolSeed or rng:NextNumber() < 0.03 then
		a.patrolSeed = rng:NextInteger(1, 50)
	end
	if g then
		local gp = objPos(g)
		if flat(a.root.Position - gp).Magnitude < 5.5 then
			if g:GetAttribute("Progress") > 15 then
				M.Do(a, "Sabotage", g)
			else
				a.patrolSeed = rng:NextInteger(1, 50)
				if a.cfg.ability.id == "snare" then
					M.Ability(a)
				end
			end
		else
			goTo(a, gp + Vector3.new(0, 0, 4))
		end
	end
end

function Bots.Think(M, match, a)
	if match.over or not alive(a) then
		return
	end
	if a.kind == "Survivor" then
		survivorThink(M, match, a)
	else
		killerThink(M, match, a)
	end
end

return Bots
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2A">
        <Properties>
          <string name="Name">CharService</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: CharService — создание R15-персонажей (игроки и боты), костюмы, коллизионные группы
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local CharService = {}

function CharService.Init()
	for _, g in ipairs({ "Survivors", "Killers", "Ghost" }) do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(g)
		end)
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable("Survivors", "Survivors", false)
		PhysicsService:CollisionGroupSetCollidable("Ghost", "Default", false)
		PhysicsService:CollisionGroupSetCollidable("Ghost", "Survivors", false)
		PhysicsService:CollisionGroupSetCollidable("Ghost", "Killers", false)
		PhysicsService:CollisionGroupSetCollidable("Ghost", "Ghost", false)
	end)
end

function CharService.SetGroup(model, group)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

function CharService.CreateModel(name, canJump)
	local desc = Instance.new("HumanoidDescription")
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	desc:Destroy()
	if not ok or not model then
		warn("[Hollowfall] Не удалось создать модель персонажа: " .. tostring(model))
		return nil
	end
	model.Name = name
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.MaxHealth = 1000000
		hum.Health = 1000000
		hum.UseJumpPower = true
		hum.JumpPower = canJump and 42 or 0
		hum.WalkSpeed = 14
		hum.BreakJointsOnDeath = false
		hum.RequiresNeck = false
	end
	CollectionService:AddTag(model, "HFChar")
	return model
end

--// Создаёт персонажа игрока в точке cf. opts: showFx, canJump, group
function CharService.Spawn(player, cf, charId, profile, opts)
	opts = opts or {}
	local model = CharService.CreateModel(player.Name, opts.canJump)
	if not model or not player.Parent then
		return nil
	end
	model:PivotTo(cf)
	local old = player.Character
	model.Parent = workspace
	player.Character = model
	if old and old ~= model then
		old:Destroy()
	end
	local eq = profile.equipped
	local skinId = eq.skins[charId] or Config.DefaultSkinFor(charId)
	Cosmetics.Apply(model, charId, skinId, eq.acc, { showFx = opts.showFx, effect = eq.effect })
	model:SetAttribute("Style", eq.style or "")
	model:SetAttribute("Role", Config.Killers[charId] and "Killer" or "Survivor")
	if opts.group then
		CharService.SetGroup(model, opts.group)
	end
	return model
end

function CharService.SpawnBot(name, cf, charId, skinId)
	local model = CharService.CreateModel(name, false)
	if not model then
		return nil
	end
	model:PivotTo(cf)
	model.Parent = workspace
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root:SetNetworkOwner(nil)
	end
	Cosmetics.Apply(model, charId, skinId, nil, { showFx = Config.Killers[charId] ~= nil })
	model:SetAttribute("IsBot", true)
	model:SetAttribute("Role", Config.Killers[charId] and "Killer" or "Survivor")
	return model
end

return CharService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2B">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: DataService — загрузка/сохранение профилей игроков (DataStore)
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local DataService = {}
local profiles = {}
local loading = {}
local dirty = {}
local store = nil

do
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = s
	end
end

local function keyOf(player)
	return "u_" .. tostring(player.UserId)
end

local function reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			if type(v) == "table" then
				local copy = {}
				reconcile(copy, v)
				target[k] = copy
			else
				target[k] = v
			end
		elseif type(v) == "table" and type(target[k]) == "table" and k ~= "owned" and k ~= "skins" and k ~= "acc" then
			reconcile(target[k], v)
		end
	end
end

local function deepCopy(t)
	local c = {}
	for k, v in pairs(t) do
		if type(v) == "table" then
			c[k] = deepCopy(v)
		else
			c[k] = v
		end
	end
	return c
end

local function load(player)
	local default = Config.DefaultProfile()
	if not store then
		default._temp = true
		return default
	end
	local data, ok
	for attempt = 1, 3 do
		ok, data = pcall(function()
			return store:GetAsync(keyOf(player))
		end)
		if ok then
			break
		end
		local msg = tostring(data)
		if string.find(msg, "Studio access") or string.find(msg, "not allowed") or string.find(msg, "403") then
			break -- доступ к API выключен: повторы бессмысленны
		end
		task.wait(1 * attempt)
	end
	if not ok then
		warn("[Hollowfall] DataStore недоступен (" .. tostring(data) .. ") — используется временный профиль без сохранения.")
		default._temp = true
		return default
	end
	if type(data) ~= "table" then
		return default
	end
	reconcile(data, default)
	for id, _ in pairs(default.owned) do
		data.owned[id] = true
	end
	return data
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.Wait(player, timeout)
	local t0 = os.clock()
	while player.Parent and not profiles[player] do
		if timeout and os.clock() - t0 > timeout then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.MarkDirty(player)
	dirty[player] = true
end

function DataService.Push(player)
	local p = profiles[player]
	if p then
		Net.E("ProfileUpdate"):FireClient(player, p)
	end
end

function DataService.Save(player)
	local p = profiles[player]
	if not p or p._temp or not store then
		return false
	end
	local snapshot = deepCopy(p)
	local ok, err = pcall(function()
		store:UpdateAsync(keyOf(player), function()
			return snapshot
		end)
	end)
	if not ok then
		warn("[Hollowfall] Не удалось сохранить профиль " .. player.Name .. ": " .. tostring(err))
		return false
	end
	dirty[player] = nil
	return true
end

function DataService.Init()
	local function onAdded(player)
		if loading[player] or profiles[player] then
			return
		end
		loading[player] = true
		local p = load(player)
		loading[player] = nil
		if player.Parent then
			profiles[player] = p
			DataService.Push(player)
		end
	end
	Players.PlayerAdded:Connect(onAdded)
	for _, pl in ipairs(Players:GetPlayers()) do
		task.spawn(onAdded, pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		dirty[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(90)
			for player, _ in pairs(dirty) do
				if player.Parent then
					task.spawn(DataService.Save, player)
				end
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.Save, player)
		end
		task.wait(3)
	end)
	Net.F("GetProfile").OnServerInvoke = function(player)
		return DataService.Wait(player, 15)
	end
end

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2C">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: LobbyBuilder — атмосферное 3D-лобби с костром, порталами (магазин / персонажи / коллекция / матч)
local MapKit = require(script.Parent:WaitForChild("MapKit"))
local M = Enum.Material

local Lobby = {}
Lobby.spawns = {}
Lobby.center = Vector3.new(0, 0, 0)

Lobby.lighting = {
	clock = 0, ambient = Color3.fromRGB(46, 42, 66), outdoor = Color3.fromRGB(38, 40, 66), brightness = 0.55,
	fog = Color3.fromRGB(16, 14, 26), fogStart = 40, fogEnd = 320, density = 0.3, atm = Color3.fromRGB(130, 120, 190),
	tint = Color3.fromRGB(235, 225, 255), saturation = -0.05, contrast = 0.1, bloom = 0.8, wind = 0.5,
}

local function titleFont()
	local ok, f = pcall(function()
		return Enum.Font.Creepster
	end)
	if ok and f then
		return f
	end
	return Enum.Font.GothamBlack
end

local function part(parent, size, cf, color, mat, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = type(color) == "string" and Color3.fromHex(color) or color
	p.Material = mat or M.Slate
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function label(adornee, text, color, offsetY, size)
	local gui = Instance.new("BillboardGui")
	gui.Adornee = adornee
	gui.Size = UDim2.fromOffset(size or 260, 54)
	gui.StudsOffset = Vector3.new(0, offsetY or 0, 0)
	gui.MaxDistance = 120
	gui.AlwaysOnTop = false
	gui.Parent = adornee
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color
	t.Font = titleFont()
	t.TextSize = 38
	t.TextStrokeTransparency = 0.3
	t.Parent = gui
end

local function portal(K, parent, x, z, text, key, color, hint)
	local ry = math.deg(math.atan2(x, z))
	local base = K:cf(x, 0, z, ry)
	local stone, dark = "#4a4a54", "#2c2c34"
	part(parent, Vector3.new(4, 17, 4), base * CFrame.new(-7, 8.5, 0), stone, M.Cobblestone)
	part(parent, Vector3.new(4, 17, 4), base * CFrame.new(7, 8.5, 0), stone, M.Cobblestone)
	part(parent, Vector3.new(18, 3.5, 4.4), base * CFrame.new(0, 18, 0), dark, M.Slate)
	part(parent, Vector3.new(6, 1.4, 6), base * CFrame.new(-7, 0.7, 0), dark, M.Slate)
	part(parent, Vector3.new(6, 1.4, 6), base * CFrame.new(7, 0.7, 0), dark, M.Slate)
	local inner = part(parent, Vector3.new(10, 15.4, 0.5), base * CFrame.new(0, 8.5, 0), color, M.Neon)
	inner.Transparency = 0.45
	inner.CanCollide = false
	inner.Name = "PortalSurface"
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = 30
	l.Brightness = 2
	l.Shadows = false
	l.Parent = inner
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 24
	pe.Lifetime = NumberRange.new(1.2, 2.2)
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = inner
	local step = part(parent, Vector3.new(14, 0.6, 8), base * CFrame.new(0, 0.3, -4), dark, M.Slate)
	step.CanCollide = true
	local pr = Instance.new("ProximityPrompt")
	pr.Name = "PortalPrompt"
	pr.ActionText = hint
	pr.ObjectText = text
	pr.HoldDuration = 0
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	pr.KeyboardKeyCode = Enum.KeyCode.E
	pr:SetAttribute("Portal", key)
	pr.Parent = inner
	label(inner, text, color, 11, 300)
	-- череп-факелы
	for _, sx in ipairs({ -10.5, 10.5 }) do
		local torch = part(parent, Vector3.new(0.7, 4, 0.7), base * CFrame.new(sx, 2, -2), "#3a2a1a", M.Wood)
		local flame = part(parent, Vector3.new(1.1, 1.3, 1.1), base * CFrame.new(sx, 4.6, -2), "#ff8a2a", M.Neon, Enum.PartType.Ball)
		flame.CanCollide = false
		torch.CanCollide = false
		local fl = Instance.new("PointLight")
		fl.Color = Color3.fromRGB(255, 150, 70)
		fl.Range = 18
		fl.Brightness = 1.6
		fl.Shadows = false
		fl.Parent = flame
	end
end

function Lobby.Build()
	local K = MapKit.new(Vector3.new(0, 0, 0))
	K.model.Name = "Lobby"
	local parent = K.groups.Structures
	-- земля
	local ground = part(K.groups.Ground, Vector3.new(4, 260, 260), CFrame.new(0, -2, 0) * CFrame.Angles(0, 0, math.rad(90)), "#1a2018", M.Grass, Enum.PartType.Cylinder)
	ground.Name = "LobbyGround"
	local plat = part(K.groups.Ground, Vector3.new(1.4, 70, 70), CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)), "#3a3a42", M.Cobblestone, Enum.PartType.Cylinder)
	plat.Name = "Platform"
	part(K.groups.Ground, Vector3.new(0.4, 40, 40), CFrame.new(0, 1.45, 0) * CFrame.Angles(0, 0, math.rad(90)), "#2a2a30", M.Slate, Enum.PartType.Cylinder)
	-- костёр и брёвна
	K:fire(0, 0)
	K:block(0, 2.3, 0, 7, 0.5, 7, "#1a1a1a", M.Slate, 45, { g = "Props", c = false })
	for i = 0, 5 do
		local a = math.rad(i * 60 + 20)
		K:log(math.cos(a) * 9, math.sin(a) * 9, 7, -math.deg(a) + 90)
	end
	-- спавн-кольцо
	Lobby.spawns = {}
	for i = 0, 11 do
		local a = math.rad(i * 30 + 15)
		local pos = Vector3.new(math.cos(a) * 17, 4.2, math.sin(a) * 17)
		local look = Vector3.new(0, 4.2, 0)
		table.insert(Lobby.spawns, CFrame.lookAt(pos, look))
	end
	-- портал-арки
	portal(K, parent, -52, -34, "МАГАЗИН", "Shop", Color3.fromRGB(245, 190, 70), "Войти")
	portal(K, parent, -18, -56, "КОЛЛЕКЦИЯ", "Inventory", Color3.fromRGB(80, 200, 140), "Открыть")
	portal(K, parent, 18, -56, "ПЕРСОНАЖИ", "Characters", Color3.fromRGB(120, 140, 255), "Выбрать")
	portal(K, parent, 52, -34, "ПОИСК МАТЧА", "Queue", Color3.fromRGB(230, 50, 70), "Начать охоту")
	-- руины с вывеской
	part(parent, Vector3.new(120, 34, 4), CFrame.new(0, 17, -92), "#26262e", M.Brick)
	for _, x in ipairs({ -50, -26, 26, 50 }) do
		part(parent, Vector3.new(10, 44, 10), CFrame.new(x, 22, -92), "#2c2c36", M.Slate)
	end
	local sign = part(parent, Vector3.new(60, 14, 1), CFrame.new(0, 26, -89.5), "#101014", M.Metal)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = sign
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Text = "HOLLOWFALL"
	title.TextColor3 = Color3.fromRGB(210, 40, 55)
	title.Font = titleFont()
	title.TextScaled = true
	title.TextStrokeTransparency = 0.4
	title.Parent = sg
	local sl = Instance.new("PointLight")
	sl.Color = Color3.fromRGB(255, 60, 70)
	sl.Range = 40
	sl.Brightness = 1.2
	sl.Shadows = false
	sl.Parent = sign
	-- кладбище и деревья по кругу
	for i = 0, 27 do
		local a = math.rad(i * (360 / 28))
		local r = 80 + K:rand(-4, 12)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if z > -70 then
			K:tree(x, z, K:rand(1.2, 1.9), i % 3 == 0)
		end
	end
	for i = 0, 17 do
		local a = math.rad(i * 20 + 5)
		local r = 56 + K:rand(0, 14)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if z > -20 or math.abs(x) > 70 then
			if i % 3 == 0 then
				K:rock(x, z, K:rand(0.9, 1.6))
			else
				K:tomb(x, z, math.deg(a) + 90 + K:rand(-15, 15))
			end
		end
	end
	for _, p in ipairs({ { -30, 30 }, { 30, 30 }, { -60, 0 }, { 60, 0 }, { 0, 55 }, { -28, -20 }, { 28, -20 } }) do
		K:lamp(p[1], p[2], "#ffc27a", 32, 10)
	end
	-- забор вокруг платформы (ограничитель лобби)
	local fence = K.groups.Invisible
	for i = 0, 15 do
		local a = math.rad(i * 22.5)
		local p = part(fence, Vector3.new(60, 80, 3), CFrame.new(math.cos(a) * 118, 40, math.sin(a) * 118) * CFrame.Angles(0, -a + math.rad(90), 0), "#000000", M.SmoothPlastic)
		p.Transparency = 1
	end
	K.model.Parent = workspace
	Lobby.model = K.model
	Lobby.flicker = K.flicker
	return K
end

function Lobby.SpawnCFrame(i)
	if #Lobby.spawns == 0 then
		return CFrame.new(0, 6, 20)
	end
	return Lobby.spawns[((i - 1) % #Lobby.spawns) + 1]
end

return Lobby
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2D">
        <Properties>
          <string name="Name">MapKit</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: MapKit — конструктор карт (стены с проёмами, здания, пропсы, интерактивные объекты)
local CollectionService = game:GetService("CollectionService")

local M = Enum.Material
local C3 = Color3.fromHex

local K = {}
K.__index = K

function K.new(origin)
	local self = setmetatable({}, K)
	self.origin = origin
	self.model = Instance.new("Model")
	self.model.Name = "Map"
	self.groups = {}
	for _, g in ipairs({ "Ground", "Structures", "Props", "Lights", "Interact", "Invisible" }) do
		local f = Instance.new("Folder")
		f.Name = g
		f.Parent = self.model
		self.groups[g] = f
	end
	self.count = 0
	self.rng = Random.new(math.floor(os.clock() * 100000) % 2147483647)
	self.reg = { generators = {}, hooks = {}, lockers = {}, pallets = {}, windows = {}, gates = {}, spawns = {}, killer = Vector3.zero }
	self.blocked = {}
	self.flicker = {}
	self.lights = 0
	self.half = 150
	self.lighting = {}
	return self
end

function K:rand(a, b)
	return self.rng:NextNumber(a, b)
end

function K:pick(list)
	return list[self.rng:NextInteger(1, #list)]
end

function K:world(x, y, z)
	return self.origin + Vector3.new(x, y, z)
end

function K:cf(x, y, z, ry)
	return CFrame.new(self.origin + Vector3.new(x, y, z)) * CFrame.Angles(0, math.rad(ry or 0), 0)
end

--// Базовая деталь. o: g(группа), n(имя), tr, c(коллизия), shape, rx, rz, cast, neon
function K:block(x, y, z, sx, sy, sz, color, mat, ry, o)
	o = o or {}
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(sx, sy, sz)
	p.Color = type(color) == "string" and C3(color) or color
	p.Material = mat or M.SmoothPlastic
	p.CFrame = CFrame.new(self.origin + Vector3.new(x, y, z)) * CFrame.Angles(math.rad(o.rx or 0), math.rad(ry or 0), math.rad(o.rz or 0))
	if o.shape then
		p.Shape = o.shape
	end
	if o.tr then
		p.Transparency = o.tr
	end
	p.CanCollide = o.c ~= false
	if o.cast ~= nil then
		p.CastShadow = o.cast
	else
		p.CastShadow = math.min(sx, sy, sz) > 1.2
	end
	if o.n then
		p.Name = o.n
	end
	p.Parent = o.parent or self.groups[o.g or "Structures"]
	self.count += 1
	if self.count % 400 == 0 then
		task.wait()
	end
	return p
end

function K:cyl(x, y, z, len, dia, color, mat, ry, o)
	o = o or {}
	o.shape = Enum.PartType.Cylinder
	return self:block(x, y, z, len, dia, dia, color, mat, ry, o)
end

function K:ball(x, y, z, d, color, mat, o)
	o = o or {}
	o.shape = Enum.PartType.Ball
	return self:block(x, y, z, d, d, d, color, mat, 0, o)
end

function K:ground(half, color, mat)
	self.half = half
	local g = self:block(0, -2, 0, half * 2 + 120, 4, half * 2 + 120, color, mat or M.Grass, 0, { g = "Ground", cast = false, n = "Ground" })
	return g
end

--// Невидимые границы карты
function K:bounds(ceiling)
	local h = self.half + 14
	local o = { g = "Invisible", tr = 1, cast = false }
	self:block(0, 40, -h, h * 2 + 20, 100, 4, "#000000", M.SmoothPlastic, 0, o)
	self:block(0, 40, h, h * 2 + 20, 100, 4, "#000000", M.SmoothPlastic, 0, o)
	self:block(-h, 40, 0, 4, 100, h * 2 + 20, "#000000", M.SmoothPlastic, 0, o)
	self:block(h, 40, 0, 4, 100, h * 2 + 20, "#000000", M.SmoothPlastic, 0, o)
	self:block(0, ceiling or 90, 0, h * 2 + 20, 4, h * 2 + 20, "#000000", M.SmoothPlastic, 0, o)
end

function K:reserve(cx, cz, w, d)
	table.insert(self.blocked, { cx - w / 2, cz - d / 2, cx + w / 2, cz + d / 2 })
end

function K:free(x, z, r)
	if math.abs(x) > self.half - 6 or math.abs(z) > self.half - 6 then
		return false
	end
	for _, b in ipairs(self.blocked) do
		if x > b[1] - r and x < b[3] + r and z > b[2] - r and z < b[4] + r then
			return false
		end
	end
	return true
end

function K:scatter(n, r, fn)
	local placed, tries = 0, 0
	while placed < n and tries < n * 14 do
		tries += 1
		local x = self:rand(-self.half + 8, self.half - 8)
		local z = self:rand(-self.half + 8, self.half - 8)
		if self:free(x, z, r) then
			fn(x, z)
			table.insert(self.blocked, { x - r, z - r, x + r, z + r })
			placed += 1
		end
	end
end

--// ------------------------------------------------------------ СТЕНЫ И ЗДАНИЯ
--// axis "x": стена вдоль X на z=fixed; axis "z": вдоль Z на x=fixed. gaps: {a,b,kind}
function K:wall(axis, fixed, a, b, y0, h, thick, color, mat, gaps)
	local function seg(p, q, yy, hh)
		if q - p < 0.05 or hh < 0.05 then
			return
		end
		if axis == "x" then
			self:block((p + q) / 2, y0 + yy + hh / 2, fixed, q - p, hh, thick, color, mat)
		else
			self:block(fixed, y0 + yy + hh / 2, (p + q) / 2, thick, hh, q - p, color, mat)
		end
	end
	table.sort(gaps or {}, function(g1, g2)
		return g1[1] < g2[1]
	end)
	local cur = a
	for _, g in ipairs(gaps or {}) do
		if g[1] > cur then
			seg(cur, g[1], 0, h)
		end
		local kind = g[3]
		local sill = kind == "window" and 3.2 or 0
		local top = kind == "window" and 6.6 or (kind == "gate" and h + 1 or 7.6)
		if sill > 0 then
			seg(g[1], g[2], 0, sill)
		end
		if top < h then
			seg(g[1], g[2], top, h - top)
		end
		if kind == "window" then
			self:window(axis, fixed, (g[1] + g[2]) / 2, g[2] - g[1])
			-- рама окна
			local fc = "#2a2a2e"
			if axis == "x" then
				self:block((g[1] + g[2]) / 2, 4.9, fixed, g[2] - g[1] + 0.4, 0.25, thick + 0.3, fc, M.Wood, 0, { c = false })
			else
				self:block(fixed, 4.9, (g[1] + g[2]) / 2, thick + 0.3, 0.25, g[2] - g[1] + 0.4, fc, M.Wood, 0, { c = false })
			end
		end
		cur = math.max(cur, g[2])
	end
	if cur < b then
		seg(cur, b, 0, h)
	end
end

--// Здание. o: h, t, col, mat, floor, floorMat, roof, roofCol, doors{N,S,E,W}, wins{N,S,E,W}, lights, lightColor
function K:building(cx, cz, w, d, o)
	o = o or {}
	local h, t = o.h or 11, o.t or 1.2
	local col, mat = o.col or "#6b6b6b", o.mat or M.Concrete
	self:reserve(cx, cz, w + 2, d + 2)
	self:block(cx, 0.15, cz, w, 0.3, d, o.floor or "#3a3a3e", o.floorMat or M.Concrete, 0, { g = "Ground", cast = false })
	local function gaps(list, base, width, kind)
		local out = {}
		for _, off in ipairs(list or {}) do
			table.insert(out, { base + off - width / 2, base + off + width / 2, kind })
		end
		return out
	end
	local function side(doors, wins, base)
		local g = gaps(doors, base, 5.2, "door")
		for _, x in ipairs(gaps(wins, base, 4, "window")) do
			table.insert(g, x)
		end
		return g
	end
	local D, W = o.doors or {}, o.wins or {}
	self:wall("x", cz - d / 2, cx - w / 2 - t / 2, cx + w / 2 + t / 2, 0, h, t, col, mat, side(D.N, W.N, cx))
	self:wall("x", cz + d / 2, cx - w / 2 - t / 2, cx + w / 2 + t / 2, 0, h, t, col, mat, side(D.S, W.S, cx))
	self:wall("z", cx - w / 2, cz - d / 2 + t / 2, cz + d / 2 - t / 2, 0, h, t, col, mat, side(D.W, W.W, cz))
	self:wall("z", cx + w / 2, cz - d / 2 + t / 2, cz + d / 2 - t / 2, 0, h, t, col, mat, side(D.E, W.E, cz))
	if o.roof ~= false then
		self:block(cx, h + 0.4, cz, w + 1.6, 0.8, d + 1.6, o.roofCol or "#25252a", o.roofMat or M.Slate)
	end
	local n = o.lights or 0
	if n > 0 then
		local cols = math.max(1, math.ceil(math.sqrt(n * w / d)))
		local rows = math.max(1, math.ceil(n / cols))
		for i = 0, cols - 1 do
			for j = 0, rows - 1 do
				if i * rows + j < n then
					local lx = cx - w / 2 + w * (i + 0.5) / cols
					local lz = cz - d / 2 + d * (j + 0.5) / rows
					self:lampCeil(lx, h - 0.35, lz, o.lightColor or "#cfe8ff", o.lightRange or 26)
				end
			end
		end
	end
end

function K:lampCeil(x, y, z, color, range)
	local p = self:block(x, y, z, 1.6, 0.25, 1.6, color, M.Neon, 0, { g = "Lights", c = false, cast = false })
	local l = Instance.new("PointLight")
	l.Color = C3(color)
	l.Range = range or 24
	l.Brightness = 1.1
	l.Shadows = false
	l.Parent = p
	self.lights += 1
	if self.rng:NextNumber() < 0.35 then
		table.insert(self.flicker, { light = l, part = p, base = l.Brightness })
	end
	return p
end

--// Периметр с проёмами под ворота. gates: { {side="N"/"S", pos=x}, ... }
function K:perimeter(half, h, color, mat, gates)
	local gn, gs = {}, {}
	for _, g in ipairs(gates or {}) do
		local gap = { g.pos - 8, g.pos + 8, "gate" }
		table.insert(g.side == "N" and gn or gs, gap)
	end
	self:wall("x", -half, -half - 1, half + 1, 0, h, 2, color, mat, gn)
	self:wall("x", half, -half - 1, half + 1, 0, h, 2, color, mat, gs)
	self:wall("z", -half, -half, half, 0, h, 2, color, mat, {})
	self:wall("z", half, -half, half, 0, h, 2, color, mat, {})
end

--// ------------------------------------------------------------ ИНТЕРАКТИВНЫЕ ОБЪЕКТЫ
local function tag(inst, kind, id)
	inst:SetAttribute("Kind", kind)
	inst:SetAttribute("Id", id)
	CollectionService:AddTag(inst, "HFInteract")
end

local function mk(parent, name, size, cf, color, mat, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = type(color) == "string" and C3(color) or color
	p.Material = mat or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

function K:window(axis, fixed, along, width)
	local pos = axis == "x" and Vector3.new(along, 2.2, fixed) or Vector3.new(fixed, 2.2, along)
	local size = axis == "x" and Vector3.new(width, 4.4, 1.2) or Vector3.new(1.2, 4.4, width)
	local p = Instance.new("Part")
	p.Name = "Window"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = size
	p.Position = self.origin + pos
	p.Parent = self.groups.Interact
	p:SetAttribute("Nx", axis == "x" and 0 or 1)
	p:SetAttribute("Nz", axis == "x" and 1 or 0)
	tag(p, "Window", #self.reg.windows + 1)
	table.insert(self.reg.windows, p)
	return p
end

--// Низкая стенка/забор, через которую можно перепрыгнуть
function K:vaultWall(x, z, axis, len, color, mat)
	if axis == "x" then
		self:block(x, 1.7, z, len, 3.4, 1, color or "#6a5a48", mat or M.Wood, 0)
	else
		self:block(x, 1.7, z, 1, 3.4, len, color or "#6a5a48", mat or M.Wood, 0)
	end
	self:window(axis, axis == "x" and z or x, axis == "x" and x or z, 5)
	self:reserve(x, z, axis == "x" and len or 2, axis == "x" and 2 or len)
end

function K:generator(x, z, ry, y)
	local base = self:cf(x, y or 0, z, ry)
	local m = Instance.new("Model")
	m.Name = "Generator"
	local body = mk(m, "Body", Vector3.new(4.4, 2.6, 3), base * CFrame.new(0, 1.3, 0), "#3d4148", M.Metal)
	mk(m, "Engine", Vector3.new(3.2, 1.7, 2.2), base * CFrame.new(-0.2, 3.4, 0), "#6b4a2c", M.Metal)
	mk(m, "Pipe", Vector3.new(3.8, 0.7, 0.7), base * CFrame.new(0, 4.6, 0.3), "#8a8f96", M.Metal, Enum.PartType.Cylinder)
	mk(m, "Tank", Vector3.new(2.4, 1.5, 1.5), base * CFrame.new(1.2, 0.8, 1.9) * CFrame.Angles(0, 0, math.rad(90)), "#a32a22", M.Metal, Enum.PartType.Cylinder)
	mk(m, "Panel", Vector3.new(2.4, 1.1, 0.2), base * CFrame.new(0, 2.0, -1.55), "#16181c", M.Metal)
	local lamp = mk(m, "Lamp", Vector3.new(0.9, 0.35, 0.2), base * CFrame.new(0, 2.15, -1.7), "#ff2a2a", M.Neon)
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 50, 50)
	l.Range = 13
	l.Brightness = 1.4
	l.Shadows = false
	l.Parent = lamp
	local gui = Instance.new("BillboardGui")
	gui.Name = "Gui"
	gui.Adornee = body
	gui.Size = UDim2.fromOffset(86, 26)
	gui.StudsOffset = Vector3.new(0, 4.4, 0)
	gui.MaxDistance = 70
	gui.AlwaysOnTop = false
	gui.Parent = body
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Pct"
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 0.35
	lbl.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
	lbl.TextColor3 = Color3.fromRGB(255, 80, 80)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 16
	lbl.Text = "0%"
	lbl.Parent = gui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = lbl
	local snd = Instance.new("Sound")
	snd.Name = "Hum"
	snd.SoundId = "rbxasset://sounds/clickfast.wav"
	snd.Looped = true
	snd.Volume = 0.55
	snd.PlaybackSpeed = 0.5
	snd.RollOffMaxDistance = 90
	snd.RollOffMinDistance = 8
	snd.Parent = body
	m.PrimaryPart = body
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Done", false)
	tag(m, "Generator", #self.reg.generators + 1)
	m.Parent = self.groups.Interact
	table.insert(self.reg.generators, m)
	self:reserve(x, z, 6, 5)
	return m
end

function K:hook(x, z, ry)
	local base = self:cf(x, 0, z, ry)
	local m = Instance.new("Model")
	m.Name = "Hook"
	local pole = mk(m, "Pole", Vector3.new(0.7, 10, 0.7), base * CFrame.new(0, 5, 0), "#2b2220", M.Wood)
	mk(m, "Base", Vector3.new(2.6, 0.8, 2.6), base * CFrame.new(0, 0.4, 0), "#3a3430", M.Slate)
	mk(m, "Arm", Vector3.new(0.6, 0.6, 4.2), base * CFrame.new(0, 9.6, -1.9), "#2b2220", M.Wood)
	mk(m, "HookA", Vector3.new(0.5, 2.2, 0.5), base * CFrame.new(0, 8.6, -3.9), "#8d949c", M.Metal)
	mk(m, "HookB", Vector3.new(0.5, 0.5, 1.4), base * CFrame.new(0, 7.6, -3.4), "#8d949c", M.Metal)
	local glow = mk(m, "Glow", Vector3.new(0.5, 0.5, 0.5), base * CFrame.new(0, 7.5, -2.9), "#ff2020", M.Neon, Enum.PartType.Ball)
	glow.CanCollide = false
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 40, 40)
	l.Range = 14
	l.Brightness = 1.2
	l.Shadows = false
	l.Parent = glow
	local hang = mk(m, "HangPoint", Vector3.new(0.4, 0.4, 0.4), base * CFrame.new(0, 6.1, -3.7), "#000000", M.SmoothPlastic)
	hang.Transparency = 1
	hang.CanCollide = false
	hang.CanQuery = false
	m.PrimaryPart = pole
	m:SetAttribute("Occupied", false)
	tag(m, "Hook", #self.reg.hooks + 1)
	m.Parent = self.groups.Interact
	table.insert(self.reg.hooks, m)
	self:reserve(x, z, 5, 5)
	return m
end

function K:locker(x, z, ry, color)
	local base = self:cf(x, 0, z, ry)
	local m = Instance.new("Model")
	m.Name = "Locker"
	local col = color or "#4a5560"
	local body = mk(m, "Body", Vector3.new(3, 7, 3), base * CFrame.new(0, 3.5, 0.2), col, M.Metal)
	local door = mk(m, "Door", Vector3.new(2.7, 6.5, 0.2), base * CFrame.new(0, 3.5, -1.4), "#5d6b78", M.Metal)
	for i = 0, 3 do
		mk(m, "Vent", Vector3.new(1.6, 0.12, 0.1), base * CFrame.new(0, 5.6 - i * 0.28, -1.55), "#14171a", M.Metal).CanCollide = false
	end
	mk(m, "Handle", Vector3.new(0.2, 0.9, 0.2), base * CFrame.new(0.9, 3.4, -1.6), "#cfd5da", M.Metal).CanCollide = false
	door.CanCollide = false
	m.PrimaryPart = body
	m:SetAttribute("Occupied", false)
	m:SetAttribute("Inside", base * CFrame.new(0, 3.2, 0.3))
	m:SetAttribute("Front", base * CFrame.new(0, 3.2, -4.2))
	tag(m, "Locker", #self.reg.lockers + 1)
	m.Parent = self.groups.Interact
	table.insert(self.reg.lockers, m)
	self:reserve(x, z, 4, 4)
	return m
end

--// Деревянная баррикада (паллет): открыта = перпендикулярно проходу, закрыта = перекрывает проход
function K:pallet(x, z, ry)
	local base = self:cf(x, 0, z, ry)
	local m = Instance.new("Model")
	m.Name = "Pallet"
	mk(m, "PostA", Vector3.new(0.8, 5.6, 0.8), base * CFrame.new(0, 2.8, 0), "#3a2a1a", M.Wood)
	mk(m, "PostB", Vector3.new(0.8, 5.6, 0.8), base * CFrame.new(7, 2.8, 0), "#3a2a1a", M.Wood)
	local anchor = mk(m, "Anchor", Vector3.new(1, 1, 1), base * CFrame.new(3.5, 2.5, 0), "#000000", M.SmoothPlastic)
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local board = mk(m, "Board", Vector3.new(6.2, 5, 0.6), base * CFrame.Angles(0, math.rad(-90), 0) * CFrame.new(3.4, 2.5, 0), "#7a5a36", M.WoodPlanks)
	board.CanCollide = false
	local closed = base * CFrame.new(3.5, 2.5, 0)
	local open = base * CFrame.Angles(0, math.rad(-90), 0) * CFrame.new(3.4, 2.5, 0)
	m.PrimaryPart = anchor
	m:SetAttribute("State", "Up")
	m:SetAttribute("ClosedCF", closed)
	m:SetAttribute("OpenCF", open)
	tag(m, "Pallet", #self.reg.pallets + 1)
	m.Parent = self.groups.Interact
	table.insert(self.reg.pallets, m)
	self:reserve(x + math.cos(math.rad(-(ry or 0))) * 3.5, z + math.sin(math.rad(-(ry or 0))) * 3.5, 8, 8)
	return m
end

--// Ворота выхода (ry: -Z локальная = наружу)
function K:gate(x, z, ry)
	local base = self:cf(x, 0, z, ry)
	local m = Instance.new("Model")
	m.Name = "Gate"
	mk(m, "PillarL", Vector3.new(2.4, 13, 2.4), base * CFrame.new(-8.2, 6.5, 0), "#2e3238", M.Concrete)
	mk(m, "PillarR", Vector3.new(2.4, 13, 2.4), base * CFrame.new(8.2, 6.5, 0), "#2e3238", M.Concrete)
	mk(m, "Beam", Vector3.new(19, 2, 2.4), base * CFrame.new(0, 12, 0), "#2e3238", M.Concrete)
	local door = mk(m, "Door", Vector3.new(14, 10.5, 0.8), base * CFrame.new(0, 5.25, 0), "#4b4f55", M.DiamondPlate)
	local strip = mk(m, "Strip", Vector3.new(14, 0.5, 0.3), base * CFrame.new(0, 10.8, -0.6), "#ff2020", M.Neon)
	strip.CanCollide = false
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 40, 40)
	l.Range = 28
	l.Brightness = 1.6
	l.Shadows = false
	l.Parent = strip
	local anchor = mk(m, "Anchor", Vector3.new(1, 1, 1), base * CFrame.new(0, 2, 1.5), "#000000", M.SmoothPlastic)
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local zone = mk(m, "EscapeZone", Vector3.new(18, 10, 12), base * CFrame.new(0, 5, -9), "#00ff66", M.SmoothPlastic)
	zone.Transparency = 1
	zone.CanCollide = false
	zone.CanQuery = false
	m.PrimaryPart = anchor
	m:SetAttribute("Powered", false)
	m:SetAttribute("Open", false)
	m:SetAttribute("Progress", 0)
	m:SetAttribute("DoorClosedCF", door.CFrame)
	m:SetAttribute("DoorOpenCF", door.CFrame * CFrame.new(0, 11, 0))
	tag(m, "Gate", #self.reg.gates + 1)
	m.Parent = self.groups.Interact
	table.insert(self.reg.gates, m)
	return m
end

--// Лестница: ступени поднимаются вдоль локальной +X
function K:stairs(x, y0, z, ry, width, steps, rise, run, color, mat)
	local base = self:cf(x, y0, z, ry)
	for i = 0, steps - 1 do
		mk(self.groups.Structures, "Step", Vector3.new(run, rise * (i + 1), width), base * CFrame.new(i * run + run / 2, rise * (i + 1) / 2, 0), color, mat)
	end
end

function K:spawnPoint(x, z)
	table.insert(self.reg.spawns, self:world(x, 4.5, z))
end

function K:killerSpawn(x, z)
	self.reg.killer = self:world(x, 4.5, z)
end

--// ------------------------------------------------------------ ПРОПСЫ
function K:lamp(x, z, color, range, h)
	h = h or 11
	self:block(x, h / 2, z, 0.7, h, 0.7, "#222226", M.Metal, 0, { g = "Props" })
	self:block(x, h + 0.2, z, 1.6, 0.4, 1.6, "#222226", M.Metal, 0, { g = "Props", c = false })
	local head = self:block(x, h - 0.4, z, 1.2, 0.35, 1.2, color or "#ffd9a0", M.Neon, 0, { g = "Lights", c = false, cast = false })
	local l = Instance.new("PointLight")
	l.Color = C3(color or "#ffd9a0")
	l.Range = range or 34
	l.Brightness = 1.5
	l.Shadows = false
	l.Parent = head
	self.lights += 1
	if self.rng:NextNumber() < 0.3 then
		table.insert(self.flicker, { light = l, part = head, base = l.Brightness })
	end
end

function K:tree(x, z, s, dead)
	s = s or 1
	local ry = self:rand(0, 90)
	self:cyl(x, 4 * s, z, 8 * s, 1.4 * s, "#3b2a1c", M.Wood, 0, { g = "Props", rz = 90 })
	if dead then
		self:block(x + 1.2 * s, 7 * s, z, 0.4 * s, 4 * s, 0.4 * s, "#3b2a1c", M.Wood, ry, { g = "Props", c = false, rz = 40 })
		self:block(x - 1.0 * s, 6 * s, z + 0.5, 0.35 * s, 3.5 * s, 0.35 * s, "#3b2a1c", M.Wood, ry, { g = "Props", c = false, rz = -50 })
		return
	end
	local cols = { "#16301e", "#1b3a24", "#10261a" }
	for i = 0, 2 do
		local sz = (10 - i * 2.8) * s
		self:block(x, (6 + i * 3.4) * s, z, sz, 4 * s, sz, cols[i + 1], M.Grass, ry + i * 22, { g = "Props", c = false, cast = false })
	end
end

function K:rock(x, z, s)
	s = s or 1
	local ry = self:rand(0, 360)
	self:block(x, 1.4 * s, z, 4.4 * s, 2.8 * s, 3.6 * s, "#55575c", M.Slate, ry, { g = "Props", rx = self:rand(-8, 8) })
	self:block(x + 1 * s, 2.3 * s, z + 0.6 * s, 2.6 * s, 2.2 * s, 2.4 * s, "#62656b", M.Slate, ry + 30, { g = "Props", rz = self:rand(-10, 10) })
end

function K:crate(x, z, s, ry)
	s = s or 3
	self:block(x, s / 2, z, s, s, s, "#6b4e2e", M.WoodPlanks, ry or self:rand(0, 90), { g = "Props" })
end

function K:barrel(x, z, color)
	self:cyl(x, 1.5, z, 3, 2.2, color or "#7a2f22", M.Metal, 0, { g = "Props", rz = 90 })
end

function K:log(x, z, len, ry)
	self:cyl(x, 1.1, z, len, 2.2, "#4a3524", M.Wood, ry or 0, { g = "Props" })
end

function K:tomb(x, z, ry)
	self:block(x, 1.7, z, 2.4, 3.4, 0.8, "#6b6e72", M.Slate, ry or 0, { g = "Props", rx = self:rand(-6, 6) })
	self:block(x, 0.3, z, 3, 0.6, 2.4, "#4a4d51", M.Slate, ry or 0, { g = "Props", c = false })
end

function K:car(x, z, ry, color)
	color = color or self:pick({ "#7a1f1f", "#1f3a5a", "#4a4f55", "#6a5a2a" })
	local base = CFrame.new(self:world(x, 0, z)) * CFrame.Angles(0, math.rad(ry or 0), 0)
	local function part(size, off, col, mat)
		local p = mk(self.groups.Props, "CarPart", size, base * CFrame.new(off), col, mat)
		return p
	end
	part(Vector3.new(8.4, 2.2, 3.8), Vector3.new(0, 1.9, 0), color, M.Metal)
	part(Vector3.new(4.4, 1.6, 3.4), Vector3.new(-0.4, 3.6, 0), color, M.Metal)
	local glass = part(Vector3.new(4.5, 1.2, 3.5), Vector3.new(-0.4, 3.65, 0), "#10161c", M.Glass)
	glass.Transparency = 0.35
	for _, wx in ipairs({ -2.7, 2.7 }) do
		for _, wz in ipairs({ -1.9, 1.9 }) do
			local w = mk(self.groups.Props, "Wheel", Vector3.new(0.9, 1.7, 1.7), base * CFrame.new(wx, 0.85, wz) * CFrame.Angles(0, math.rad(90), 0), "#111111", M.Rubber, Enum.PartType.Cylinder)
			w.CanCollide = false
		end
	end
	self:reserve(x, z, 9, 5)
end

function K:machine(x, z, w, d, h, color, ry)
	self:block(x, h / 2, z, w, h, d, color or "#4a525a", M.Metal, ry or 0, { g = "Props" })
	self:block(x, h + 0.3, z, w * 0.6, 0.6, d * 0.6, "#2a2f35", M.DiamondPlate, ry or 0, { g = "Props", c = false })
	self:block(x, h * 0.55, z - d / 2 - 0.05, w * 0.5, h * 0.3, 0.2, "#101418", M.Metal, ry or 0, { g = "Props", c = false })
	self:reserve(x, z, w + 2, d + 2)
end

function K:tank(x, z, dia, h, color)
	self:cyl(x, h / 2, z, h, dia, color or "#6e6a5a", M.Metal, 0, { g = "Props", rz = 90 })
	self:reserve(x, z, dia + 2, dia + 2)
end

function K:pipeRun(x1, z1, x2, z2, y, dia, color)
	local len = math.sqrt((x2 - x1) ^ 2 + (z2 - z1) ^ 2)
	local ang = math.deg(math.atan2(-(z2 - z1), x2 - x1))
	self:cyl((x1 + x2) / 2, y, (z1 + z2) / 2, len, dia, color or "#5a5f66", M.Metal, ang, { g = "Props", c = false })
end

function K:bench(x, z, ry)
	self:block(x, 1.2, z, 5, 0.4, 1.4, "#5a4430", M.Wood, ry or 0, { g = "Props" })
	self:block(x, 2.1, z + 0.6, 5, 1.4, 0.3, "#5a4430", M.Wood, ry or 0, { g = "Props", c = false })
end

function K:bed(x, z, ry)
	self:block(x, 1.4, z, 3.2, 0.5, 6.6, "#d8d8d2", M.Fabric, ry or 0, { g = "Props" })
	self:block(x, 0.8, z, 3.4, 1.2, 6.8, "#555a60", M.Metal, ry or 0, { g = "Props", c = false })
	self:block(x, 2.0, z - 2.6, 2.4, 0.6, 1.2, "#e9e9e4", M.Fabric, ry or 0, { g = "Props", c = false })
end

function K:shelf(x, z, ry, w)
	w = w or 6
	self:block(x, 3.5, z, w, 7, 1.4, "#4d4036", M.Wood, ry or 0, { g = "Props" })
	for i = 1, 3 do
		self:block(x, i * 1.8, z, w + 0.2, 0.2, 1.6, "#2e2620", M.Wood, ry or 0, { g = "Props", c = false })
	end
end

function K:table(x, z, w, d, ry, color)
	self:block(x, 2.6, z, w, 0.4, d, color or "#6a5a48", M.Wood, ry or 0, { g = "Props" })
	self:block(x, 1.3, z, w - 0.6, 2.4, d - 0.6, "#2a2420", M.Wood, ry or 0, { g = "Props", c = false })
end

function K:fire(x, z)
	self:cyl(x, 0.3, z, 0.6, 3, "#33302c", M.Slate, 0, { g = "Props", rz = 90 })
	local f = self:block(x, 1.0, z, 1.2, 1.4, 1.2, "#ff7a1a", M.Neon, 45, { g = "Lights", c = false, cast = false })
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 150, 70)
	l.Range = 30
	l.Brightness = 2
	l.Shadows = false
	l.Parent = f
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(0.6, 1.2)
	pe.Speed = NumberRange.new(2, 4)
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60), Color3.fromRGB(255, 60, 20))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Acceleration = Vector3.new(0, 4, 0)
	pe.Parent = f
	table.insert(self.flicker, { light = l, part = f, base = 2 })
end

return K
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2E">
        <Properties>
          <string name="Name">Maps</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Maps — пять процедурных карт. Каждая возвращает MapKit с реестром объектов и настройками освещения.
local MapKit = require(script.Parent:WaitForChild("MapKit"))
local M = Enum.Material

local Maps = {}

--// Расставляет генераторы/крюки/паллеты/шкафчики/ворота/точки появления по описанию карты
local function place(K, def)
	for _, g in ipairs(def.gens) do
		K:generator(g[1], g[2], g[3] or 0, g[4])
	end
	for _, h in ipairs(def.hooks) do
		K:hook(h[1], h[2], h[3] or 0)
	end
	for _, l in ipairs(def.lockers) do
		K:locker(l[1], l[2], l[3] or 0, l[4])
	end
	for _, p in ipairs(def.pallets) do
		K:pallet(p[1], p[2], p[3] or 0)
	end
	for _, g in ipairs(def.gates) do
		K:gate(g[1], g[2], g[3] or 0)
	end
	for _, s in ipairs(def.spawns) do
		K:spawnPoint(s[1], s[2])
		K:reserve(s[1], s[2], 10, 10)
	end
	K:killerSpawn(def.killer[1], def.killer[2])
	K:reserve(def.killer[1], def.killer[2], 12, 12)
end

local function ringTrees(K, half, gates, spacing)
	for i = -half + 6, half - 6, spacing do
		for _, side in ipairs({ -1, 1 }) do
			local okN = true
			for _, g in ipairs(gates) do
				if math.abs(i - g) < 16 then
					okN = false
				end
			end
			if okN then
				K:tree(i + K:rand(-3, 3), side * (half - 6 + K:rand(-2, 2)), K:rand(1.1, 1.6), K.rng:NextNumber() < 0.2)
			end
			K:tree(side * (half - 6 + K:rand(-2, 2)), i + K:rand(-3, 3), K:rand(1.1, 1.6), K.rng:NextNumber() < 0.2)
		end
	end
end

--// =============================================================== БОЛЬНИЦА
local function hospital(origin)
	local K = MapKit.new(origin)
	K.lighting = {
		clock = 0, ambient = Color3.fromRGB(34, 46, 46), outdoor = Color3.fromRGB(26, 38, 42), brightness = 0.35,
		fog = Color3.fromRGB(12, 22, 22), fogStart = 25, fogEnd = 240, density = 0.38, atm = Color3.fromRGB(110, 150, 150),
		tint = Color3.fromRGB(205, 235, 230), saturation = -0.2, contrast = 0.12, bloom = 0.5, wind = 0.3,
	}
	K:ground(150, "#2a302e", M.Concrete)
	K:perimeter(150, 14, "#4a524f", M.Concrete, { { side = "N", pos = -70 }, { side = "S", pos = 70 } })
	local wall = "#8d9f98"
	local floorC = "#59625f"
	local lc = "#bfe6dd"
	K:building(0, -60, 130, 60, {
		h = 11, col = wall, mat = M.Plaster, floor = floorC, floorMat = M.CeramicTiles, lights = 0,
		doors = { N = { -32.5, 32.5 }, S = { -32.5, 32.5 }, E = { 0 }, W = { 0 } },
		wins = { N = { -54.2, -10.8, 10.8, 54.2 }, S = { -54.2, -10.8, 10.8, 54.2 } },
	})
	local roomX = { -54.2, -32.5, -10.8, 10.8, 32.5, 54.2 }
	local dg = {}
	for _, x in ipairs(roomX) do
		table.insert(dg, { x - 2.6, x + 2.6, "door" })
	end
	K:wall("x", -67, -64, 64, 0, 11, 1, wall, M.Plaster, dg)
	K:wall("x", -53, -64, 64, 0, 11, 1, wall, M.Plaster, dg)
	for _, x in ipairs({ -43.3, -21.7, 0, 21.7, 43.3 }) do
		K:wall("z", x, -89, -67, 0, 11, 1, wall, M.Plaster, {})
		K:wall("z", x, -53, -31, 0, 11, 1, wall, M.Plaster, {})
	end
	for i, x in ipairs(roomX) do
		K:lampCeil(x, 10.6, -78, lc, 24)
		K:lampCeil(x, 10.6, -42, lc, 24)
		if i ~= 1 and i % 2 == 1 then
			K:bed(x - 5, -82, 0)
			K:bed(x + 5, -82, 0)
		elseif i ~= 1 then
			K:table(x, -80, 6, 3, 0)
			K:barrel(x + 7, -86, "#3a4a4a")
		end
		if i ~= 5 and i ~= 3 then
			K:shelf(x + 5, -33, 0, 6)
		elseif i == 3 then
			K:table(x, -38, 7, 3, 0)
		end
	end
	for x = -56, 56, 16 do
		K:lampCeil(x, 10.6, -60, lc, 26)
	end
	-- крыло-палата
	K:building(-95, 45, 70, 60, {
		h = 11, col = wall, mat = M.Plaster, floor = floorC, floorMat = M.CeramicTiles, lights = 6, lightColor = lc,
		doors = { N = { -15 }, S = { 15 }, E = { 0 } }, wins = { W = { -15, 15 }, N = { 15 }, S = { -15 } },
	})
	for _, x in ipairs({ -122, -111, -79, -68 }) do
		for _, z in ipairs({ 28, 40, 52 }) do
			K:bed(x, z, 0)
		end
	end
	-- морг
	K:building(95, 45, 70, 60, {
		h = 11, col = "#7f918c", mat = M.Plaster, floor = "#4b5552", floorMat = M.CeramicTiles, lights = 6, lightColor = "#a8d8e8",
		doors = { W = { 0 }, N = { 15 }, S = { -15 } }, wins = { E = { -15, 15 }, N = { -15 }, S = { 15 } },
	})
	for _, x in ipairs({ 75, 90, 108 }) do
		for _, z in ipairs({ 30, 44 }) do
			K:table(x, z, 3, 7, 0, "#9aa5aa")
		end
	end
	K:shelf(120, 66, 0, 8)
	-- операционная
	K:building(0, 105, 80, 36, {
		h = 12, col = "#93a7a0", mat = M.Plaster, floor = "#5f6a66", floorMat = M.CeramicTiles, lights = 4, lightColor = "#e8fff8",
		doors = { N = { -20, 20 }, S = { 0 } }, wins = { E = { 0 }, W = { 0 }, S = { -24, 24 } },
	})
	K:table(0, 105, 4, 8, 0, "#c8d2d0")
	K:lampCeil(0, 11.4, 105, "#ffffff", 30)
	-- двор
	K:car(-75, 125, 90, "#d8d8d8")
	K:car(78, 128, 0, "#d8d8d8")
	K:bench(-10, 12, 0)
	K:bench(12, 30, 90)
	K:vaultWall(-80, 0, "x", 16)
	K:vaultWall(80, 0, "x", 16)
	K:vaultWall(0, 42, "z", 14)
	K:vaultWall(-60, 100, "x", 14)
	K:vaultWall(60, 100, "x", 14)
	place(K, {
		gens = { { -54.2, -80 }, { 32.5, -40 }, { -95, 62 }, { 95, 62 }, { -22, 108 }, { -45, -5 }, { 55, -12 } },
		hooks = { { -20, -8 }, { 25, 18 }, { 0, 60 }, { -62, 95 }, { 62, 95 }, { -118, -10 }, { 118, -10 }, { -10, -60 } },
		lockers = { { -54.2, -88.3, 180 }, { 10.8, -88.3, 180 }, { -32.5, -31.8, 0 }, { 54.2, -31.8, 0 }, { -10.8, -31.8, 0 }, { -128.4, 35, -90 }, { 128.4, 35, 90 }, { -38.5, 112, -90 } },
		pallets = { { -30, -20, 0 }, { 32, 3, 90 }, { -12, 40, 0 }, { -100, -30, 0 }, { 100, -30, 90 }, { -95, 100, 0 }, { 95, 100, 0 }, { -20, 78, 0 }, { 20, 72, 90 }, { -20, -58, 90 } },
		gates = { { -70, -150, 0 }, { 70, 150, 180 } },
		spawns = { { -120, -20 }, { 120, -20 }, { -110, 100 }, { 110, 100 } },
		killer = { 0, 25 },
	})
	for _, lp in ipairs({ { -40, -10 }, { 40, -10 }, { -40, 30 }, { 40, 30 }, { 0, 80 }, { -120, 10 }, { 120, 10 } }) do
		K:lamp(lp[1], lp[2], "#a8e8dc", 30, 10)
	end
	K:scatter(14, 4, function(x, z)
		K:crate(x, z, K:rand(2.5, 3.5))
	end)
	K:bounds(40)
	return K
end

--// =============================================================== ЛЕС
local function forest(origin)
	local K = MapKit.new(origin)
	K.lighting = {
		clock = 0, ambient = Color3.fromRGB(28, 36, 34), outdoor = Color3.fromRGB(30, 42, 46), brightness = 0.45,
		fog = Color3.fromRGB(16, 24, 22), fogStart = 15, fogEnd = 190, density = 0.5, atm = Color3.fromRGB(130, 150, 140),
		tint = Color3.fromRGB(220, 240, 225), saturation = -0.1, contrast = 0.12, bloom = 0.4, wind = 0.8,
	}
	K:ground(170, "#18241a", M.Grass)
	K:perimeter(170, 12, "#33362f", M.Slate, { { side = "N", pos = -80 }, { side = "S", pos = 80 } })
	local wood = "#5a4330"
	local function cabin(cx, cz, w, d, doors, wins)
		K:building(cx, cz, w, d, {
			h = 9, col = wood, mat = M.WoodPlanks, floor = "#3a2d20", floorMat = M.WoodPlanks, roofCol = "#2c2018", roofMat = M.Wood,
			doors = doors, wins = wins, lights = 2, lightColor = "#ffb870", lightRange = 22,
		})
	end
	cabin(-90, -80, 28, 22, { S = { -6 }, E = { 0 } }, { N = { -6 }, W = { 0 }, S = { 6 } })
	cabin(90, -60, 26, 20, { W = { 0 }, N = { 5 } }, { S = { 0 }, E = { 0 } })
	cabin(-70, 90, 30, 24, { N = { 0 }, E = { 4 } }, { S = { -7, 7 }, W = { 0 } })
	K:building(95, 95, 36, 26, {
		h = 11, col = "#6b3a2a", mat = M.WoodPlanks, floor = "#3a2d20", floorMat = M.Ground, roofCol = "#2a1a14", roofMat = M.Wood,
		doors = { W = { 0 }, N = { -8 }, S = { 9 } }, wins = { E = { 0 }, N = { 8 } }, lights = 2, lightColor = "#ffb060",
	})
	K:building(0, 0, 22, 40, {
		h = 16, col = "#6b6e70", mat = M.Cobblestone, floor = "#44464a", floorMat = M.Slate, roofCol = "#2a2c30", roofMat = M.Slate,
		doors = { N = { 0 }, S = { 0 } }, wins = { E = { -10, 10 }, W = { -10, 10 } }, lights = 3, lightColor = "#ffcf8a",
	})
	for z = -12, 12, 6 do
		K:bench(-5, z, 90)
		K:bench(5, z, 90)
	end
	K:block(0, 1.6, 17, 6, 3.2, 2, "#555559", M.Marble)
	-- кладбище
	for i = 0, 15 do
		local sx = (i % 2 == 0) and 1 or -1
		K:tomb(sx * (18 + (i % 4) * 7), -26 - math.floor(i / 4) * 8, K:rand(-10, 10))
	end
	K:reserve(0, -42, 70, 36)
	K:fire(-40, 45)
	K:bench(-46, 45, 0)
	K:bench(-34, 47, 0)
	K:vaultWall(-30, -100, "x", 14)
	K:vaultWall(40, 70, "z", 14)
	K:vaultWall(130, 10, "x", 12)
	K:vaultWall(-130, 20, "z", 14)
	K:vaultWall(60, -120, "x", 14)
	K:vaultWall(-60, 20, "x", 12)
	place(K, {
		gens = { { -75, -62 }, { 90, -60 }, { -70, 90 }, { 0, 10 }, { 95, 95 }, { -30, -125 }, { 45, 72 } },
		hooks = { { -45, -35 }, { 45, -35 }, { 60, 30 }, { -35, 60 }, { 130, -20 }, { -130, 10 }, { 0, -110 }, { 10, 125 } },
		lockers = { { -100.5, -88, 180 }, { 99.5, -68, 180 }, { -83, 99, 0 }, { 108, 105, 0 }, { -9.5, -16, -90 }, { 9.5, 16, 90 }, { 85, 105, 0 }, { -60, 99, 0 } },
		pallets = { { -50, -70, 0 }, { 40, -90, 90 }, { 70, 10, 0 }, { -100, 20, 0 }, { 20, 40, 90 }, { -20, -75, 0 }, { 120, -100, 0 }, { -120, -50, 90 }, { 60, 130, 0 }, { -10, 100, 90 }, { 30, -20, 0 }, { -40, 5, 90 } },
		gates = { { -80, -170, 0 }, { 80, 170, 180 } },
		spawns = { { -140, -130 }, { 140, -130 }, { -140, 130 }, { 140, 130 } },
		killer = { 0, 70 },
	})
	ringTrees(K, 170, { -80, 80 }, 13)
	K:scatter(130, 6, function(x, z)
		K:tree(x, z, K:rand(0.9, 1.5), K.rng:NextNumber() < 0.15)
	end)
	K:scatter(16, 5, function(x, z)
		K:rock(x, z, K:rand(0.8, 1.6))
	end)
	K:scatter(10, 5, function(x, z)
		K:log(x, z, K:rand(8, 14), K:rand(0, 180))
	end)
	return K
end

--// =============================================================== ФАБРИКА
local function factory(origin)
	local K = MapKit.new(origin)
	K.lighting = {
		clock = 0, ambient = Color3.fromRGB(46, 38, 32), outdoor = Color3.fromRGB(34, 30, 30), brightness = 0.35,
		fog = Color3.fromRGB(26, 20, 16), fogStart = 20, fogEnd = 210, density = 0.45, atm = Color3.fromRGB(190, 140, 100),
		tint = Color3.fromRGB(255, 232, 210), saturation = -0.05, contrast = 0.15, bloom = 0.7, wind = 0.4,
	}
	K:ground(160, "#2b2b2e", M.Concrete)
	K:perimeter(160, 14, "#4a3f38", M.CorrodedMetal, { { side = "N", pos = -60 }, { side = "S", pos = 60 } })
	local rust = "#6a5448"
	-- главный цех
	K:building(0, 0, 150, 100, {
		h = 22, col = rust, mat = M.CorrodedMetal, floor = "#35353a", floorMat = M.DiamondPlate, roofCol = "#2a2522", roofMat = M.Metal,
		doors = { N = { -40, 40 }, S = { -40, 40 }, W = { 0 }, E = { 0 } }, wins = { S = { 0, -62, 62 }, N = { 0 } },
		lights = 10, lightColor = "#ffc890", lightRange = 36,
	})
	-- конвейеры
	for _, z in ipairs({ -22, 22 }) do
		K:block(0, 1.6, z, 110, 1.4, 3.6, "#3a3d42", M.Metal, 0, { c = true })
		for x = -50, 50, 10 do
			K:cyl(x, 1.0, z, 3.4, 1.0, "#20232a", M.Metal, 90, { c = false, rz = 0 })
		end
	end
	-- мезонин
	K:block(45, 7.5, -35, 44, 1, 16, "#3a3d42", M.DiamondPlate)
	for _, c in ipairs({ { 24, -43 }, { 66, -43 }, { 24, -27 }, { 66, -27 } }) do
		K:block(c[1], 3.75, c[2], 1.2, 7.5, 1.2, "#2a2d32", M.Metal)
	end
	K:block(45, 9.3, -43.5, 44, 2.6, 0.3, "#2a2d32", M.Metal, 0, { c = true, tr = 0.4 })
	K:stairs(2.2, 0, -35, 0, 5, 8, 1, 2.6, "#3a3d42", M.DiamondPlate)
	K:reserve(45, -35, 48, 20)
	-- машины и оборудование цеха
	for _, mp in ipairs({ { -50, -5, 14, 8, 7 }, { -30, 38, 10, 8, 6 }, { 30, 38, 12, 8, 8 }, { -55, -38, 10, 10, 6 }, { 55, 8, 8, 12, 6 }, { 8, 5, 6, 6, 5 } }) do
		K:machine(mp[1], mp[2], mp[3], mp[4], mp[5], "#555d66")
	end
	for _, tp in ipairs({ { -65, 30 }, { 65, -10 } }) do
		K:tank(tp[1], tp[2], 9, 12, "#6e6a5a")
	end
	-- пристройки
	local function annex(cx, cz, w, d, doors, wins)
		K:building(cx, cz, w, d, {
			h = 12, col = "#5b4a40", mat = M.CorrodedMetal, floor = "#2f2f33", floorMat = M.Concrete, roofCol = "#2a2522", roofMat = M.Metal,
			doors = doors, wins = wins, lights = 3, lightColor = "#ffb878",
		})
	end
	annex(-110, -90, 40, 30, { E = { 0 }, S = { -8 } }, { N = { 0 }, W = { 0 } })
	annex(110, 90, 60, 40, { W = { 0 }, N = { -15 } }, { S = { -10, 10 }, E = { 0 } })
	annex(-110, 100, 36, 30, { N = { 0 }, E = { 5 } }, { S = { 0 }, W = { 0 } })
	annex(100, -90, 30, 24, { S = { 0 }, W = { 0 } }, { N = { 0 }, E = { 0 } })
	K:table(-118, -95, 8, 3, 0)
	K:shelf(-120, -100, 0, 8)
	K:shelf(110, 100, 0, 10)
	K:shelf(120, 104, 0, 8)
	-- двор
	K:cyl(-135, 25, -50, 50, 6, "#50433b", M.Brick, 0, { rz = 90 })
	K:reserve(-135, -50, 10, 10)
	for _, cp in ipairs({ { -120, -20 }, { 125, 30 }, { -60, 120 }, { 60, -125 } }) do
		for i = 0, 3 do
			K:crate(cp[1] + (i % 2) * 3.2, cp[2] + math.floor(i / 2) * 3.2, 3)
		end
		K:barrel(cp[1] + 7, cp[2], "#8a2f1f")
		K:barrel(cp[1] + 7, cp[2] + 3, "#2f4a8a")
	end
	K:vaultWall(25, -75, "x", 16, "#5a4a3a", M.CorrodedMetal)
	K:vaultWall(-25, 75, "x", 16, "#5a4a3a", M.CorrodedMetal)
	K:vaultWall(-80, 70, "z", 14, "#5a4a3a", M.CorrodedMetal)
	K:vaultWall(80, -70, "z", 14, "#5a4a3a", M.CorrodedMetal)
	K:vaultWall(-130, -25, "x", 12, "#5a4a3a", M.CorrodedMetal)
	K:vaultWall(130, -10, "x", 12, "#5a4a3a", M.CorrodedMetal)
	for _, pr in ipairs({ { -80, -60, 80, -60 }, { -80, 60, 80, 60 } }) do
		K:pipeRun(pr[1], pr[2], pr[3], pr[4], 19, 1.4, "#6a5f55")
	end
	place(K, {
		gens = { { -66, -8 }, { 40, 12 }, { 45, -35, 0, 8 }, { -110, -90 }, { 110, 90 }, { -110, 100 }, { 100, -90 } },
		hooks = { { 0, 75 }, { -60, 70 }, { 60, -70 }, { 0, -75 }, { -130, 0 }, { 130, 0 }, { -60, -25 }, { 60, 28 } },
		lockers = { { -128.5, -85, -90 }, { 138.4, 95, 90 }, { -126.5, 100, -90 }, { 112, -100.5, 180 }, { -70.5, 20, -90 }, { 70.5, -20, 90 }, { 20, 47.5, 0 }, { -20, -47.5, 180 } },
		pallets = { { -30, -60, 0 }, { 30, 60, 90 }, { -90, 30, 0 }, { 90, -30, 0 }, { -45, 85, 0 }, { 45, -85, 90 }, { -100, -50, 90 }, { 100, 50, 0 }, { -15, 8, 90 }, { 15, -10, 0 } },
		gates = { { -60, -160, 0 }, { 60, 160, 180 } },
		spawns = { { -140, -135 }, { 140, -135 }, { -140, 135 }, { 140, 135 } },
		killer = { 0, 60 },
	})
	for _, lp in ipairs({ { -70, -60 }, { 70, -60 }, { -70, 60 }, { 70, 60 }, { -140, 40 }, { 140, -40 }, { 0, 100 }, { 0, -100 } }) do
		K:lamp(lp[1], lp[2], "#ffb060", 36, 13)
	end
	K:scatter(14, 4, function(x, z)
		K:crate(x, z, K:rand(2.5, 3.5))
	end)
	K:scatter(8, 3, function(x, z)
		K:barrel(x, z, "#7a3a22")
	end)
	K:bounds(60)
	return K
end

--// =============================================================== ГОРОД
local function city(origin)
	local K = MapKit.new(origin)
	K.lighting = {
		clock = 0, ambient = Color3.fromRGB(34, 38, 52), outdoor = Color3.fromRGB(30, 36, 56), brightness = 0.4,
		fog = Color3.fromRGB(14, 18, 28), fogStart = 25, fogEnd = 230, density = 0.35, atm = Color3.fromRGB(130, 150, 200),
		tint = Color3.fromRGB(215, 225, 255), saturation = -0.12, contrast = 0.12, bloom = 0.6, wind = 0.35,
	}
	K:ground(170, "#2a2c30", M.Asphalt)
	K:perimeter(170, 14, "#5a3a32", M.Brick, { { side = "N", pos = 0 }, { side = "S", pos = 0 } })
	-- дороги: разметка и тротуары
	for i = -160, 160, 16 do
		K:block(i, 0.05, 0, 7, 0.1, 0.8, "#c9b037", M.SmoothPlastic, 0, { g = "Ground", c = false, cast = false })
		K:block(0, 0.05, i, 0.8, 0.1, 7, "#c9b037", M.SmoothPlastic, 0, { g = "Ground", c = false, cast = false })
	end
	local walls = { "#6b4a42", "#59606b", "#7a6a58", "#4a5560" }
	local function house(cx, cz, w, d, doors, wins, idx)
		K:building(cx, cz, w, d, {
			h = 13, col = walls[idx], mat = M.Brick, floor = "#3b3b40", floorMat = M.Concrete, roofCol = "#222226", roofMat = M.Slate,
			doors = doors, wins = wins, lights = 3, lightColor = "#ffd9a0", lightRange = 24,
		})
	end
	house(-60, -60, 38, 32, { E = { 0 }, S = { -8 } }, { N = { -8, 8 }, W = { 0 }, S = { 8 } }, 1)
	house(-125, -55, 40, 38, { E = { 6 }, S = { 0 } }, { N = { 0 }, W = { -8, 8 } }, 2)
	house(60, -60, 36, 34, { W = { 0 }, S = { 6 } }, { N = { 0 }, E = { 0 }, S = { -8 } }, 3)
	house(125, -50, 38, 40, { W = { -6 }, S = { 0 } }, { N = { 6 }, E = { 0 }, S = { 10 } }, 4)
	house(-60, 60, 36, 32, { E = { 0 }, N = { 6 } }, { S = { 0 }, W = { 0 }, N = { -8 } }, 2)
	house(-125, 60, 40, 36, { E = { -6 }, N = { 0 } }, { S = { 0 }, W = { 0 } }, 1)
	house(60, 60, 38, 34, { W = { 0 }, N = { 0 } }, { S = { 0 }, E = { 8 }, N = { -10 } }, 4)
	house(125, 55, 36, 38, { W = { 4 }, S = { 0 } }, { N = { 0 }, E = { 0 }, S = { 9 } }, 3)
	-- мебель в домах
	for _, h in ipairs({ { -60, -60 }, { -125, -55 }, { 60, -60 }, { 125, -50 }, { -60, 60 }, { -125, 60 }, { 60, 60 }, { 125, 55 } }) do
		K:table(h[1] - 8, h[2] + 6, 6, 3, 0)
		K:shelf(h[1] + 8, h[2] - 10, 0, 6)
	end
	-- центральная площадь
	K:cyl(0, 0.6, 0, 1.2, 14, "#4a4d51", M.Cobblestone, 0, { rz = 90 })
	K:cyl(0, 1.6, 0, 3, 3, "#6a6e72", M.Marble, 0, { rz = 90 })
	K:reserve(0, 0, 18, 18)
	K:bench(-12, 10, 90)
	K:bench(12, -10, 90)
	-- машины
	for _, c in ipairs({ { -30, 6, 0 }, { 40, -6, 180 }, { -90, -6, 0 }, { 90, 6, 180 }, { 6, -40, 90 }, { -6, 50, 90 }, { 6, 100, 90 }, { -6, -100, 90 }, { -140, 6, 0 }, { 140, -6, 180 } }) do
		K:car(c[1], c[2], c[3])
	end
	-- заборы/перепрыгивания
	K:vaultWall(-92, -20, "x", 14)
	K:vaultWall(92, 20, "x", 14)
	K:vaultWall(-30, -48, "z", 12)
	K:vaultWall(30, 48, "z", 12)
	K:vaultWall(-90, 110, "x", 14)
	K:vaultWall(90, -110, "x", 14)
	place(K, {
		gens = { { -60, -66 }, { 125, -50 }, { -125, 60 }, { 60, 60 }, { -125, -55 }, { 0, -100 }, { 100, 0 } },
		hooks = { { -30, -30 }, { 30, -30 }, { -30, 30 }, { 30, 30 }, { 0, -60 }, { 0, 75 }, { -90, 0 }, { 90, -25 } },
		lockers = { { -77.5, -62, -90 }, { 142.5, -48, 90 }, { -106.5, 64, 90 }, { 42.5, 60, -90 }, { -143.5, -55, -90 }, { 72, -75.5, 180 }, { 111, 72.5, 0 }, { -72, 74.5, 0 } },
		pallets = { { -35, -75, 90 }, { 35, -85, 0 }, { -90, -100, 0 }, { 90, 100, 90 }, { -100, 20, 0 }, { 100, -20, 0 }, { -20, 20, 90 }, { 20, -20, 90 }, { -45, 100, 0 }, { 45, 110, 0 }, { -145, 20, 0 }, { 150, -20, 90 } },
		gates = { { 0, -170, 0 }, { 0, 170, 180 } },
		spawns = { { -150, -140 }, { 150, -140 }, { -150, 140 }, { 150, 140 } },
		killer = { -20, 0 },
	})
	for x = -150, 150, 50 do
		for _, z in ipairs({ -14, 14 }) do
			K:lamp(x, z, "#ffd9a0", 34, 11)
		end
	end
	for z = -150, 150, 50 do
		if z ~= 0 then
			K:lamp(-14, z, "#bcd4ff", 34, 11)
			K:lamp(14, z, "#bcd4ff", 34, 11)
		end
	end
	K:scatter(14, 3, function(x, z)
		K:barrel(x, z, "#3a4a3a")
	end)
	K:scatter(10, 4, function(x, z)
		K:crate(x, z, K:rand(2.5, 3.5))
	end)
	K:bounds(70)
	return K
end

--// =============================================================== ПОДЗЕМНЫЙ КОМПЛЕКС
local function underground(origin)
	local K = MapKit.new(origin)
	K.lighting = {
		clock = 0, ambient = Color3.fromRGB(40, 36, 52), outdoor = Color3.fromRGB(40, 36, 52), brightness = 0.1,
		fog = Color3.fromRGB(14, 12, 20), fogStart = 10, fogEnd = 150, density = 0.45, atm = Color3.fromRGB(150, 120, 190),
		tint = Color3.fromRGB(235, 220, 255), saturation = -0.1, contrast = 0.15, bloom = 0.7, wind = 0.2,
	}
	K:ground(150, "#2d2d33", M.Concrete)
	K:perimeter(150, 18, "#3e3e46", M.Concrete, { { side = "N", pos = 0 }, { side = "S", pos = 0 } })
	K:block(0, 18.5, 0, 340, 2, 340, "#202026", M.Concrete, 0, { cast = false })
	local centers = { -95, 0, 95 }
	local lc = "#d9c8ff"
	for _, cx in ipairs(centers) do
		for _, cz in ipairs(centers) do
			K:building(cx, cz, 62, 56, {
				h = 15, col = "#4f4f5a", mat = M.Concrete, floor = "#35353c", floorMat = M.DiamondPlate, roof = false,
				doors = { N = { 0 }, S = { 0 }, E = { 0 }, W = { 0 } }, wins = { N = { -18, 18 }, S = { -18, 18 }, E = { -18, 18 }, W = { -18, 18 } },
				lights = 3, lightColor = lc, lightRange = 28,
			})
			-- мебель по углам комнаты
			K:table(cx - 18, cz - 16, 7, 3, 0, "#5a5f66")
			K:machine(cx + 20, cz - 18, 8, 6, 6, "#4a525a")
			K:crate(cx - 22, cz + 18, 3)
			K:tank(cx + 22, cz + 18, 5, 9, "#5f6a5a")
		end
	end
	-- коридоры: трубы, лампы
	for _, o in ipairs({ -47.5, 47.5 }) do
		K:pipeRun(o - 6, -140, o - 6, 140, 16, 1.6, "#5a5f66")
		K:pipeRun(-140, o + 6, 140, o + 6, 16.4, 1.6, "#6a5f55")
		for t = -135, 135, 45 do
			K:lampCeil(o, 17.2, t, "#c8b0ff", 30)
			K:lampCeil(t, 17.2, o, "#c8b0ff", 30)
		end
	end
	for _, o in ipairs({ -138, 138 }) do
		for t = -120, 120, 60 do
			K:lampCeil(o, 17.2, t, "#c8b0ff", 28)
			K:lampCeil(t, 17.2, o, "#c8b0ff", 28)
		end
	end
	for _, p in ipairs({ { -47.5, -80 }, { 47.5, 80 }, { 80, -47.5 }, { -80, 47.5 } }) do
		K:vaultWall(p[1], p[2], (math.abs(p[1]) == 47.5) and "z" or "x", 12, "#4a4a52", M.Concrete)
	end
	K:vaultWall(-47.5, 110, "z", 12, "#4a4a52", M.Concrete)
	K:vaultWall(47.5, -110, "z", 12, "#4a4a52", M.Concrete)
	place(K, {
		gens = { { 10, -87 }, { 105, -87 }, { -85, 8 }, { 10, 8 }, { 105, 8 }, { -85, 103 }, { 10, 103 } },
		hooks = { { 47.5, 47.5 }, { -47.5, 47.5 }, { 47.5, -47.5 }, { -47.5, -47.5 }, { 47.5, 0 }, { -47.5, 0 }, { 0, 47.5 }, { 0, -47.5 } },
		lockers = { { -95, -121.5, 180 }, { 95, 121.5, 0 }, { -95, -68.5, 0 }, { 0, -121.5, 180 }, { 95, -121.5, 180 }, { -121.5, 0, -90 }, { 0, 121.5, 0 }, { 121.5, 0, 90 } },
		pallets = { { -47.5, -105, 90 }, { 47.5, 105, 90 }, { 105, -47.5, 0 }, { -105, 47.5, 0 }, { -47.5, 70, 90 }, { 47.5, -70, 90 }, { 70, 47.5, 0 }, { -70, -47.5, 0 }, { -138, -50, 0 }, { 138, 50, 0 } },
		gates = { { 0, -150, 0 }, { 0, 150, 180 } },
		spawns = { { -138, -138 }, { 138, -138 }, { -138, 138 }, { 138, 138 } },
		killer = { -47.5, -95 },
	})
	K:scatter(10, 4, function(x, z)
		K:crate(x, z, K:rand(2.5, 3.5))
	end)
	K:bounds(60)
	return K
end

Maps.Builders = { hospital = hospital, forest = forest, factory = factory, city = city, underground = underground }

function Maps.Build(id, origin)
	local b = Maps.Builders[id]
	local K = b(origin)
	K.id = id
	return K
end

return Maps
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2F">
        <Properties>
          <string name="Name">MatchService</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: MatchService — подбор игроков, жизненный цикл матча, игровые механики (всё авторитетно на сервере)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local LightingFx = require(Shared:WaitForChild("LightingFx"))
local Server = script.Parent
local Data = require(Server:WaitForChild("DataService"))
local Shop = require(Server:WaitForChild("ShopService"))
local Maps = require(Server:WaitForChild("Maps"))
local Lobby = require(Server:WaitForChild("LobbyBuilder"))
local CharService = require(Server:WaitForChild("CharService"))
local Bots = require(Server:WaitForChild("BotService"))

local R = Config.Rules
local M = {}

local S = { phase = "Lobby", queue = {}, votes = {}, match = nil, searchStart = nil, forceStart = false, lobbyCount = 0 }
local byModel = {}
local byPlayer = {}
local MAP_ORIGIN = Vector3.new(3000, 0, 0)
local flickers = {}
local rng = Random.new()

--// ------------------------------------------------------------------ УТИЛИТЫ
local function clock()
	return os.clock()
end
local function srv()
	return workspace:GetServerTimeNow()
end
local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function fireActor(a, ev, ...)
	if a.player and a.player.Parent then
		Net.E(ev):FireClient(a.player, ...)
	end
end
local function notify(a, text, kind)
	fireActor(a, "Notify", text, kind or "info")
end
local function notifyAll(match, text, kind)
	for _, a in ipairs(match.actors) do
		notify(a, text, kind)
	end
end
local function sfx(name, pos, vol, pitch)
	Net.E("Sfx"):FireAllClients(name, pos, vol or 1, pitch or 1)
end
local function addScore(a, key, n)
	a.score[key] = (a.score[key] or 0) + n
end
local function objPos(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return (inst :: BasePart).Position
end
function M.HDist(a, pos)
	return flat(a.root.Position - pos).Magnitude
end
local function near(a, pos, range)
	return M.HDist(a, pos) <= range and math.abs(a.root.Position.Y - pos.Y) < 7.5
end
local function alive(a)
	return a.state ~= "Dead" and a.state ~= "Escaped"
end

--// ------------------------------------------------------------------ ОСВЕЩЕНИЕ / МЕРЦАНИЕ
task.spawn(function()
	while true do
		task.wait(0.12)
		for i = #flickers, 1, -1 do
			local e = flickers[i]
			if not e.light or not e.light.Parent then
				table.remove(flickers, i)
			elseif rng:NextNumber() < 0.12 then
				e.light.Brightness = e.base * rng:NextNumber(0.05, 1.15)
			elseif e.light.Brightness ~= e.base and rng:NextNumber() < 0.5 then
				e.light.Brightness = e.base
			end
		end
	end
end)

--// ------------------------------------------------------------------ АКТЁРЫ
local function makeActor(match, kind, player, model, charId, skinId, isBot)
	local cfg = Config.GetChar(charId)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local a = {
		id = #match.actors + 1, kind = kind, player = player, isBot = isBot, model = model, hum = hum, root = root,
		name = player and player.DisplayName or (cfg.name .. " (бот)"), charId = charId, skinId = skinId, cfg = cfg,
		state = kind == "Survivor" and "Healthy" or "Idle",
		stamina = kind == "Survivor" and cfg.stats.stamina or 100, maxStamina = kind == "Survivor" and cfg.stats.stamina or 100,
		exhausted = false, lastSprint = 0, reqSprint = false, reqCrouch = false, sprinting = false,
		hooks = 0, hookTimer = 0, hookTotal = 1, bleed = 0, healProg = 0,
		busy = nil, cd = 0, boostUntil = 0, hushUntil = 0, hasteUntil = 0, snaredUntil = 0, stunUntil = 0,
		atkCd = 0, lungeUntil = 0, dashUntil = 0, veilUntil = 0, vaultUntil = 0, noClipUntil = 0,
		carrying = nil, carriedBy = nil, secondWind = false, locker = nil, hookObj = nil, frozen = true,
		score = {}, stat = { hits = 0, hooks = 0, kills = 0, rescues = 0, repairs = 0 },
		lastPos = root.Position, lastInteract = 0, chased = false, chasing = false, traps = {},
	}
	byModel[model] = a
	if player then
		byPlayer[player] = a
	end
	table.insert(match.actors, a)
	if kind == "Survivor" then
		table.insert(match.survivors, a)
	else
		match.killer = a
	end
	hum.JumpPower = 0
	hum.AutoRotate = true
	CharService.SetGroup(model, kind == "Survivor" and "Survivors" or "Killers")
	model:SetAttribute("AbReady", 0)
	return a
end

local function computeSpeed(a, t)
	if not alive(a) or a.frozen then
		return 0
	end
	if a.kind == "Survivor" then
		local st = a.state
		if st == "Hooked" or st == "Carried" or st == "Hiding" then
			return 0
		end
		if t < a.vaultUntil or a.busy or t < a.snaredUntil then
			return 0
		end
		if st == "Downed" then
			return R.SurvCrawl
		end
		local sp
		if a.reqCrouch then
			sp = R.SurvCrouch * a.cfg.stats.crouch
		elseif a.sprinting then
			sp = R.SurvRun
		else
			sp = R.SurvWalk
		end
		sp = sp * a.cfg.stats.speed
		if t < a.hasteUntil then
			sp = sp * R.HasteMul
		end
		if t < a.boostUntil then
			sp = sp * 1.35
		end
		if t < a.hushUntil then
			sp = sp * 1.12
		end
		return sp
	end
	if t < a.stunUntil or a.busy or t < a.vaultUntil then
		return 0
	end
	if t < a.dashUntil then
		return 30
	end
	local sp = a.cfg.speed
	if a.carrying then
		sp = sp * R.CarrySpeedMul
	end
	if t < a.lungeUntil then
		sp = sp + R.LungeSpeed
	end
	if t < a.veilUntil then
		sp = sp + 0.6
	end
	if a.charId == "crow" and a.chasing then
		sp = sp + 0.6
	end
	return sp
end

local function updateSpeed(a)
	a.hum.WalkSpeed = computeSpeed(a, clock())
end

local function publish(a)
	local m, t = a.model, clock()
	m:SetAttribute("State", a.state)
	m:SetAttribute("Stamina", math.floor(a.stamina))
	m:SetAttribute("MaxStamina", a.maxStamina)
	m:SetAttribute("Sprint", a.sprinting)
	m:SetAttribute("Crouch", a.kind == "Survivor" and a.reqCrouch and a.state ~= "Downed")
	m:SetAttribute("Hooks", a.hooks)
	m:SetAttribute("HookStage", a.hooks)
	m:SetAttribute("HookLeft", math.max(0, math.floor(a.hookTimer)))
	m:SetAttribute("HookTotal", math.floor(a.hookTotal))
	m:SetAttribute("Bleed", math.max(0, math.floor(a.bleed)))
	m:SetAttribute("Chased", a.chased)
	m:SetAttribute("Stunned", t < a.stunUntil)
	m:SetAttribute("Carrying", a.carrying ~= nil)
	m:SetAttribute("Boost", t < a.boostUntil)
	m:SetAttribute("Silent", t < a.hushUntil)
	m:SetAttribute("Snared", t < a.snaredUntil)
	m:SetAttribute("Veil", t < a.veilUntil)
	m:SetAttribute("Dash", t < a.dashUntil)
	m:SetAttribute("Vault", t < a.vaultUntil)
	m:SetAttribute("HealProg", a.healProg)
end

--// ------------------------------------------------------------------ КАНАЛЫ ВЗАИМОДЕЙСТВИЯ
local ACT = {}

local function stopChannel(a)
	if a.busy then
		a.busy = nil
		fireActor(a, "InteractUpdate", nil)
		updateSpeed(a)
	end
end

local function stun(k, dur)
	k.stunUntil = clock() + dur
	if k.busy then
		stopChannel(k)
	end
	updateSpeed(k)
end

local function ghostify(a)
	a.root.Anchored = true
	for _, d in ipairs(a.model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = 1
			d.CanCollide = false
		elseif d:IsA("ParticleEmitter") or d:IsA("Light") then
			d.Enabled = false
		elseif d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	a.root.CFrame = a.root.CFrame + Vector3.new(0, 300, 0)
end

local function releaseHook(a)
	if a.hookObj then
		a.hookObj:SetAttribute("Occupied", false)
		a.hookObj = nil
	end
end

local function dropCarry(k)
	local s = k.carrying
	if not s then
		return
	end
	k.carrying = nil
	s.carriedBy = nil
	local w = k.root:FindFirstChild("CarryWeld")
	if w then
		w:Destroy()
	end
	s.hum.PlatformStand = false
	CharService.SetGroup(s.model, "Survivors")
	updateSpeed(k)
end

local function die(a, reason)
	if not alive(a) then
		return
	end
	stopChannel(a)
	if a.carriedBy then
		dropCarry(a.carriedBy)
	end
	releaseHook(a)
	if a.locker then
		a.locker:SetAttribute("Occupied", false)
		a.locker = nil
	end
	a.state = "Dead"
	notify(a, reason or "Вы погибли.", "bad")
	local m = S.match
	if m then
		notifyAll(m, a.name .. " погиб", "bad")
		if m.killer and a.kind == "Survivor" then
			m.killer.stat.kills += 1
			addScore(m.killer, "Жертвы", 250)
		end
	end
	sfx("scream", a.root.Position, 1, 0.8)
	ghostify(a)
	publish(a)
	updateSpeed(a)
end

local function escape(a)
	if not alive(a) then
		return
	end
	stopChannel(a)
	a.state = "Escaped"
	addScore(a, "Побег", 500)
	local m = S.match
	if m then
		m.escapes += 1
		notifyAll(m, a.name .. " сбежал!", "good")
	end
	notify(a, "Вы сбежали!", "good")
	ghostify(a)
	publish(a)
end

local function ejectFromLocker(s)
	local lk = s.locker
	if not lk then
		return
	end
	lk:SetAttribute("Occupied", false)
	s.locker = nil
	s.state = s.preHide or "Healthy"
	s.root.Anchored = false
	local front = lk:GetAttribute("Front")
	if typeof(front) == "CFrame" then
		s.root.CFrame = front
	end
	s.noClipUntil = clock() + 0.6
	updateSpeed(s)
end

local function downSurvivor(s)
	if s.charId == "eva" and not s.secondWind then
		s.secondWind = true
		s.state = "Injured"
		s.hasteUntil = clock() + 3
		notify(s, "Вторая жизнь! Вы поднялись.", "good")
		return false
	end
	s.state = "Downed"
	s.bleed = R.BleedOut * s.cfg.stats.bleed
	s.healProg = 0
	s.hum.PlatformStand = false
	return true
end

local function hitSurvivor(k, s)
	if s.state == "Hiding" then
		ejectFromLocker(s)
	end
	if s.state ~= "Healthy" and s.state ~= "Injured" then
		return
	end
	stopChannel(s)
	local t = clock()
	k.stat.hits += 1
	addScore(k, "Попадания", 25)
	if s.state == "Healthy" then
		s.state = "Injured"
		s.hasteUntil = t + R.HasteTime
		s.healProg = 0
		notify(s, "Вас ранили! Бегите!", "bad")
		sfx("hit", s.root.Position, 1, 1.1)
	else
		if downSurvivor(s) then
			addScore(k, "Падения", 60)
			notify(s, "Вы упали! Ждите помощи.", "bad")
			notify(k, "Выживший повержен — поднимите его.", "good")
			sfx("hit", s.root.Position, 1, 0.8)
		else
			sfx("hit", s.root.Position, 1, 0.9)
		end
	end
	updateSpeed(s)
	publish(s)
end

local function pickup(k, s)
	stopChannel(s)
	k.carrying = s
	s.carriedBy = k
	s.state = "Carried"
	s.root.Anchored = false
	CharService.SetGroup(s.model, "Ghost")
	s.hum.PlatformStand = true
	local w = Instance.new("Weld")
	w.Name = "CarryWeld"
	w.Part0 = k.root
	w.Part1 = s.root
	w.C0 = CFrame.new(0.5, 1.9, 0.8) * CFrame.Angles(0, 0, math.rad(90))
	w.Parent = k.root
	notify(s, "Убийца несёт вас на крюк!", "bad")
	notify(k, "Несите выжившего к крюку.", "info")
	updateSpeed(k)
	updateSpeed(s)
	publish(s)
end

local function hang(k, hook)
	local s = k.carrying
	if not s then
		return
	end
	dropCarry(k)
	s.hooks += 1
	k.stat.hooks += 1
	addScore(k, "Крюки", 150)
	local hp = hook:FindFirstChild("HangPoint") :: BasePart
	if s.hooks >= 3 then
		s.root.CFrame = hp.CFrame
		die(s, "Вас принесли в жертву.")
		return
	end
	s.state = "Hooked"
	s.hookObj = hook
	hook:SetAttribute("Occupied", true)
	s.hookTotal = R.HookTimes[s.hooks] * s.cfg.stats.hook
	s.hookTimer = s.hookTotal
	s.hum.PlatformStand = true
	s.root.CFrame = hp.CFrame
	s.root.Anchored = true
	notify(s, "Вы на крюке! Ждите спасения.", "bad")
	notifyAll(S.match, s.name .. " подвешен на крюк!", "warn")
	sfx("scream", hp.Position, 1, 1)
	updateSpeed(s)
	publish(s)
end

local function unhook(s, rescuer)
	local hook = s.hookObj
	releaseHook(s)
	s.state = "Injured"
	s.root.Anchored = false
	s.hum.PlatformStand = false
	s.hookTimer = 0
	s.healProg = 0
	s.hasteUntil = clock() + 2.5
	if hook and hook.PrimaryPart then
		s.root.CFrame = hook.PrimaryPart.CFrame * CFrame.new(0, -1.4, -6)
	end
	s.noClipUntil = clock() + 0.6
	if rescuer then
		addScore(rescuer, "Спасение", 200)
		rescuer.stat.rescues += 1
		notifyAll(S.match, rescuer.name .. " спас " .. s.name, "good")
	end
	updateSpeed(s)
	publish(s)
end

--// ------------------------------------------------------------------ ГЕНЕРАТОРЫ / ВОРОТА
local function updateGenVisual(g)
	local p = g:GetAttribute("Progress")
	local pct = math.floor(p)
	if g:GetAttribute("Pct") == pct then
		return
	end
	g:SetAttribute("Pct", pct)
	local body = g:FindFirstChild("Body")
	local gui = body and body:FindFirstChild("Gui")
	local lbl = gui and gui:FindFirstChild("Pct")
	local lamp = g:FindFirstChild("Lamp")
	local col
	if g:GetAttribute("Done") then
		col = Color3.fromRGB(70, 255, 110)
	elseif p < 35 then
		col = Color3.fromRGB(255, 50, 50)
	elseif p < 70 then
		col = Color3.fromRGB(255, 150, 40)
	else
		col = Color3.fromRGB(240, 230, 60)
	end
	if lbl and lbl:IsA("TextLabel") then
		lbl.Text = g:GetAttribute("Done") and "ГОТОВО" or (pct .. "%")
		lbl.TextColor3 = col
	end
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = col
		local l = lamp:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = col
		end
	end
end

local function powerGates(match)
	match.powered = true
	for _, gate in ipairs(match.K.reg.gates) do
		gate:SetAttribute("Powered", true)
		local strip = gate:FindFirstChild("Strip")
		if strip and strip:IsA("BasePart") then
			strip.Color = Color3.fromRGB(255, 190, 60)
			local l = strip:FindFirstChildOfClass("PointLight")
			if l then
				l.Color = strip.Color
			end
		end
	end
	notifyAll(match, "Все выходы под напряжением! Откройте ворота и бегите!", "good")
	sfx("crash", match.killer and match.killer.root.Position or Vector3.zero, 0.2, 1)
end

local function completeGen(g)
	local match = S.match
	g:SetAttribute("Done", true)
	g:SetAttribute("Progress", 100)
	g:SetAttribute("Pct", -1)
	updateGenVisual(g)
	local snd = g:FindFirstChild("Body") and g.Body:FindFirstChild("Hum")
	if snd and snd:IsA("Sound") then
		snd.Playing = false
	end
	sfx("crash", objPos(g), 0.8, 1.2)
	if not match then
		return
	end
	match.gensDone += 1
	for _, a in ipairs(match.survivors) do
		if a.busy and a.busy.target == g then
			a.stat.repairs += 1
			stopChannel(a)
		end
	end
	notifyAll(match, string.format("Генератор запущен (%d/%d)", match.gensDone, match.need), "good")
	if match.gensDone >= match.need and not match.powered then
		powerGates(match)
	end
end

local function addGenProgress(g, amount)
	if g:GetAttribute("Done") then
		return
	end
	local p = math.clamp(g:GetAttribute("Progress") + amount, 0, 100)
	g:SetAttribute("Progress", p)
	updateGenVisual(g)
	if p >= 100 then
		completeGen(g)
	end
end

local function openGate(gate)
	gate:SetAttribute("Open", true)
	local door = gate:FindFirstChild("Door") :: BasePart
	local target = gate:GetAttribute("DoorOpenCF")
	if door and typeof(target) == "CFrame" then
		door.CanCollide = false
		TweenService:Create(door, TweenInfo.new(2.4, Enum.EasingStyle.Quad), { CFrame = target }):Play()
	end
	local strip = gate:FindFirstChild("Strip")
	if strip and strip:IsA("BasePart") then
		strip.Color = Color3.fromRGB(70, 255, 110)
		local l = strip:FindFirstChildOfClass("PointLight")
		if l then
			l.Color = strip.Color
		end
	end
	if S.match then
		notifyAll(S.match, "Ворота открыты — к выходу!", "good")
	end
	sfx("crash", objPos(gate), 1, 0.7)
end

--// ------------------------------------------------------------------ ПРОВЕРКИ НАВЫКА
local function resolveSkillCheck(a, result)
	local b = a.busy
	if not b or not b.sc then
		return
	end
	b.sc = nil
	b.nextSC = clock() + rng:NextNumber(R.SkillCheckEvery[1], R.SkillCheckEvery[2])
	local g = b.target
	if result == "great" then
		addGenProgress(g, R.SkillCheckGreat)
		addScore(a, "Ремонт", 25)
	elseif result == "good" then
		addGenProgress(g, R.SkillCheckGood)
		addScore(a, "Ремонт", 10)
	else
		addGenProgress(g, -R.SkillCheckFail)
		sfx("glass", objPos(g), 0.9, 1)
		local k = S.match and S.match.killer
		if k then
			notify(k, "Генератор взорвался! Идите туда!", "warn")
			fireActor(k, "AbilityFx", { type = "Pulse", pos = objPos(g) })
		end
	end
end

--// ------------------------------------------------------------------ ДЕЙСТВИЯ
local function ownSurv(a)
	return a.state == "Healthy" or a.state == "Injured"
end

ACT.Repair = {
	who = "Survivor", range = 7.5, label = "Ремонт генератора",
	can = function(a, g)
		return g:GetAttribute("Kind") == "Generator" and not g:GetAttribute("Done") and ownSurv(a)
	end,
	tick = function(a, g, dt)
		local n = 0
		for _, o in ipairs(S.match.survivors) do
			if o ~= a and o.busy and o.busy.action == "Repair" and o.busy.target == g then
				n += 1
			end
		end
		local rate = 100 / R.RepairTime * a.cfg.stats.repair * (0.88 ^ n)
		if a.busy then
			if a.busy.bonus and a.busy.bonus > 0 then
				a.busy.bonus = 0
			end
			if not a.isBot and not a.busy.sc and clock() >= (a.busy.nextSC or math.huge) then
				local sc = { id = rng:NextInteger(1, 1e9), t0 = clock(), zone = rng:NextInteger(110, 290), width = 46, great = 14, speed = 250, delay = 0.45 }
				sc.timeout = sc.delay + 360 / sc.speed + 0.4
				a.busy.sc = sc
				fireActor(a, "SkillCheck", sc)
			elseif a.busy.sc and clock() - a.busy.sc.t0 > a.busy.sc.timeout then
				resolveSkillCheck(a, "fail")
			end
		end
		addScore(a, "Ремонт", rate * dt)
		addGenProgress(g, rate * dt)
	end,
	progress = function(_, g)
		return g:GetAttribute("Progress") / 100
	end,
}

ACT.Sabotage = {
	who = "Killer", range = 7.5, label = "Саботаж генератора",
	can = function(a, g)
		return g:GetAttribute("Kind") == "Generator" and not g:GetAttribute("Done") and g:GetAttribute("Progress") > 1 and not a.carrying
	end,
	dur = function()
		return R.SabotageTime
	end,
	done = function(a, g)
		g:SetAttribute("Progress", math.max(0, g:GetAttribute("Progress") - R.SabotageLoss))
		g:SetAttribute("Pct", -1)
		updateGenVisual(g)
		addScore(a, "Саботаж", 40)
		sfx("glass", objPos(g), 1, 0.9)
		notifyAll(S.match, "Убийца испортил генератор!", "warn")
	end,
}

ACT.Heal = {
	who = "Survivor", range = 6.5, actor = true, label = "Лечение",
	can = function(a, t)
		if not ownSurv(a) or t.kind ~= "Survivor" then
			return false
		end
		if t == a then
			return a.state == "Injured"
		end
		return t.state == "Injured" or t.state == "Downed"
	end,
	tick = function(a, t, dt)
		local need
		if t == a then
			need = R.SelfHealTime
		elseif t.state == "Downed" then
			need = R.HealTime * 0.9
		else
			need = R.HealTime
		end
		t.healProg = t.healProg + a.cfg.stats.heal / need * dt
		if t.healProg >= 1 then
			t.healProg = 0
			if t.state == "Downed" then
				t.state = "Injured"
			else
				t.state = "Healthy"
			end
			addScore(a, "Лечение", t == a and 60 or 150)
			notify(t, "Вы исцелены.", "good")
			stopChannel(a)
			updateSpeed(t)
		end
	end,
	progress = function(_, t)
		return t.healProg
	end,
}

ACT.Unhook = {
	who = "Survivor", range = 7.5, actor = true, label = "Снимаем с крюка",
	can = function(a, t)
		return ownSurv(a) and t ~= a and t.kind == "Survivor" and t.state == "Hooked"
	end,
	dur = function()
		return R.UnhookTime
	end,
	done = function(a, t)
		if t.state == "Hooked" then
			unhook(t, a)
		end
	end,
}

ACT.Pickup = {
	who = "Killer", range = 6.5, actor = true, label = "Подбираем жертву",
	can = function(a, t)
		return not a.carrying and t.kind == "Survivor" and t.state == "Downed" and not t.carriedBy
	end,
	dur = function()
		return R.PickupTime
	end,
	done = function(a, t)
		if t.state == "Downed" and not a.carrying then
			pickup(a, t)
		end
	end,
}

ACT.Hook = {
	who = "Killer", range = 8, label = "Вешаем на крюк",
	can = function(a, h)
		return h:GetAttribute("Kind") == "Hook" and a.carrying ~= nil and not h:GetAttribute("Occupied")
	end,
	dur = function()
		return R.HangTime
	end,
	done = function(a, h)
		if a.carrying and not h:GetAttribute("Occupied") then
			hang(a, h)
		end
	end,
}

ACT.Hide = {
	who = "Survivor", range = 6.5, label = "Прячемся",
	can = function(a, lk)
		return lk:GetAttribute("Kind") == "Locker" and ownSurv(a) and not lk:GetAttribute("Occupied")
	end,
	dur = function()
		return R.LockerEnterTime
	end,
	done = function(a, lk)
		if lk:GetAttribute("Occupied") or not ownSurv(a) then
			return
		end
		a.preHide = a.state
		a.state = "Hiding"
		a.locker = lk
		lk:SetAttribute("Occupied", true)
		local inside = lk:GetAttribute("Inside")
		if typeof(inside) == "CFrame" then
			a.root.CFrame = inside
		end
		a.root.Anchored = true
		a.noClipUntil = clock() + 1
		updateSpeed(a)
		publish(a)
	end,
}

ACT.Search = {
	who = "Killer", range = 6.5, label = "Обыскиваем шкафчик",
	can = function(a, lk)
		return lk:GetAttribute("Kind") == "Locker" and not a.carrying
	end,
	dur = function()
		return R.LockerSearchTime
	end,
	done = function(a, lk)
		local occ
		for _, s in ipairs(S.match.survivors) do
			if s.locker == lk then
				occ = s
			end
		end
		if occ then
			ejectFromLocker(occ)
			sfx("crash", objPos(lk), 0.6, 1.3)
			hitSurvivor(a, occ)
			a.atkCd = clock() + R.AttackHitCd
		else
			notify(a, "Шкафчик пуст.", "info")
			sfx("click", objPos(lk), 0.6, 1)
		end
	end,
}

ACT.Drop = {
	who = "Survivor", range = 7.5, instant = true, label = "Уронить баррикаду",
	can = function(a, p)
		return p:GetAttribute("Kind") == "Pallet" and p:GetAttribute("State") == "Up" and ownSurv(a)
	end,
	done = function(a, p)
		p:SetAttribute("State", "Dropped")
		local board = p:FindFirstChild("Board") :: BasePart
		local closed = p:GetAttribute("ClosedCF")
		if board and typeof(closed) == "CFrame" then
			TweenService:Create(board, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = closed }):Play()
			task.delay(0.26, function()
				board.CanCollide = true
			end)
		end
		sfx("crash", objPos(p), 0.8, 1.5)
		addScore(a, "Паллеты", 40)
		local k = S.match.killer
		if k and (k.root.Position - objPos(p)).Magnitude < 9.5 and k.state ~= "Dead" then
			stun(k, R.PalletStun)
			notify(k, "Вас оглушила баррикада!", "warn")
			addScore(a, "Паллеты", 80)
		end
	end,
}

ACT.Break = {
	who = "Killer", range = 7.5, label = "Ломаем баррикаду",
	can = function(a, p)
		return p:GetAttribute("Kind") == "Pallet" and p:GetAttribute("State") == "Dropped" and not a.carrying
	end,
	dur = function()
		return R.PalletBreakTime
	end,
	done = function(_, p)
		p:SetAttribute("State", "Broken")
		local board = p:FindFirstChild("Board")
		if board then
			board:Destroy()
		end
		sfx("crash", objPos(p), 1, 0.8)
	end,
}

ACT.Vault = {
	who = "Any", range = 6, instant = true, label = "Перепрыгнуть",
	can = function(a, w)
		if w:GetAttribute("Kind") ~= "Window" or (w:GetAttribute("Busy") or 0) > clock() then
			return false
		end
		if a.kind == "Survivor" then
			return ownSurv(a)
		end
		return not a.carrying
	end,
	done = function(a, w)
		local t = clock()
		local dur = a.kind == "Survivor" and R.VaultSurvivor or R.VaultKiller
		local n = Vector3.new(w:GetAttribute("Nx"), 0, w:GetAttribute("Nz"))
		local side = ((a.root.Position - w.Position):Dot(n) >= 0) and 1 or -1
		local y = a.root.Position.Y
		local from = w.Position + n * side * 3
		local to = w.Position - n * side * 3
		local dir = -n * side
		local fromP = Vector3.new(from.X, y, from.Z)
		local toP = Vector3.new(to.X, y, to.Z)
		local fromCF = CFrame.lookAt(fromP, fromP + dir)
		local toCF = CFrame.lookAt(toP, toP + dir)
		a.vaultUntil = t + dur
		a.noClipUntil = t + dur + 0.6
		w:SetAttribute("Busy", t + dur + 0.2)
		updateSpeed(a)
		if a.player then
			Net.E("Vault"):FireClient(a.player, fromCF, toCF, dur)
		else
			a.root.Anchored = true
			a.root.CFrame = fromCF
			TweenService:Create(a.root, TweenInfo.new(dur, Enum.EasingStyle.Sine), { CFrame = toCF }):Play()
			task.delay(dur + 0.05, function()
				a.root.Anchored = false
			end)
		end
	end,
}

ACT.OpenGate = {
	who = "Survivor", range = 9, label = "Открываем ворота",
	can = function(a, g)
		return g:GetAttribute("Kind") == "Gate" and g:GetAttribute("Powered") and not g:GetAttribute("Open") and ownSurv(a)
	end,
	tick = function(a, g, dt)
		local p = math.min(100, g:GetAttribute("Progress") + 100 / R.GateTime * dt)
		g:SetAttribute("Progress", p)
		addScore(a, "Ворота", 100 / R.GateTime * dt * 0.8)
		if p >= 100 then
			openGate(g)
			stopChannel(a)
		end
	end,
	progress = function(_, g)
		return g:GetAttribute("Progress") / 100
	end,
}

local function validTarget(match, def, target)
	if def.actor then
		return typeof(target) == "Instance" and byModel[target] ~= nil
	end
	return typeof(target) == "Instance" and target:IsDescendantOf(match.K.model)
end

local function targetPos(def, target)
	if def.actor then
		return (target :: any).root.Position
	end
	return objPos(target)
end

--// Единая точка запуска действия (игроки и боты)
function M.Do(a, action, targetInst)
	local match = S.match
	if not match or match.over or not alive(a) or a.frozen then
		return false
	end
	local def = ACT[action]
	if not def or (def.who ~= "Any" and def.who ~= a.kind) then
		return false
	end
	if a.busy or clock() < a.vaultUntil or clock() < a.stunUntil then
		return false
	end
	-- особые случаи
	if action == "Hide" and a.state == "Hiding" then
		ejectFromLocker(a)
		publish(a)
		return true
	end
	local target = targetInst
	if action == "Heal" and (targetInst == nil or targetInst == a.model) then
		target = a
	elseif def.actor then
		target = byModel[targetInst]
		if not target then
			return false
		end
	else
		if not validTarget(match, def, target) then
			return false
		end
	end
	local pos
	if target == a then
		pos = a.root.Position
	else
		pos = targetPos(def, target)
	end
	if not near(a, pos, def.range + 1) then
		return false
	end
	local ok = def.can(a, target)
	if not ok then
		return false
	end
	if def.instant then
		def.done(a, target)
		return true
	end
	a.busy = { action = action, target = target, t0 = clock(), dur = def.dur and def.dur(a, target) or nil, prog = 0, nextSC = clock() + rng:NextNumber(3, 6) }
	updateSpeed(a)
	return true
end

function M.Stop(a)
	stopChannel(a)
end

local function tickChannel(a, dt)
	local b = a.busy
	if not b then
		return
	end
	local def = ACT[b.action]
	local target = b.target
	local valid = alive(a)
	if valid then
		if def.actor then
			valid = target == a or (alive(target) and byModel[target.model] == target)
		else
			valid = typeof(target) == "Instance" and target.Parent ~= nil
		end
	end
	if valid then
		local pos = (target == a) and a.root.Position or targetPos(def, target)
		valid = near(a, pos, def.range + 2.5) and def.can(a, target)
		if a.kind == "Survivor" then
			valid = valid and (ownSurv(a))
		else
			valid = valid and clock() >= a.stunUntil
		end
	end
	if not valid then
		stopChannel(a)
		return
	end
	if b.dur then
		b.prog = (clock() - b.t0) / b.dur
		if b.prog >= 1 then
			a.busy = nil
			fireActor(a, "InteractUpdate", nil)
			updateSpeed(a)
			def.done(a, target)
			return
		end
	else
		def.tick(a, target, dt)
		if a.busy then
			b.prog = def.progress(a, target)
		end
	end
	if a.busy then
		fireActor(a, "InteractUpdate", { label = def.label, prog = b.prog })
	end
end

--// ------------------------------------------------------------------ БОЙ И СПОСОБНОСТИ
local function rayClear(match, from, to)
	local r = workspace:Raycast(from, to - from, match.rayParams)
	return r == nil
end

local function findVictim(k, range, cosLimit)
	local match = S.match
	local kp = k.root.Position
	local look = flat(k.root.CFrame.LookVector)
	if look.Magnitude < 0.01 then
		return nil
	end
	look = look.Unit
	local best, bd = nil, math.huge
	for _, s in ipairs(match.survivors) do
		if ownSurv(s) then
			local d = s.root.Position - kp
			local fd = flat(d)
			local dist = fd.Magnitude
			if dist <= range and math.abs(d.Y) < 6 and (dist < 2.2 or fd.Unit:Dot(look) >= cosLimit) then
				if dist < bd and rayClear(match, kp + Vector3.new(0, 1.5, 0), s.root.Position + Vector3.new(0, 1, 0)) then
					best, bd = s, dist
				end
			end
		end
	end
	return best
end

local function doAttack(k)
	local t = clock()
	if k.kind ~= "Killer" or not alive(k) or k.frozen or k.busy or k.carrying or t < k.atkCd or t < k.stunUntil or t < k.vaultUntil then
		return
	end
	k.atkCd = t + R.AttackMissCd + R.AttackWindup
	k.lungeUntil = t + R.LungeTime
	if t < k.veilUntil then
		k.veilUntil = 0
	end
	k.model:SetAttribute("AtkT", srv())
	sfx("swing", k.root.Position, 0.9, rng:NextNumber(0.9, 1.1))
	updateSpeed(k)
	task.delay(R.AttackWindup, function()
		if not S.match or S.match.over or not alive(k) then
			return
		end
		local v = findVictim(k, R.AttackRange, 0.3)
		if v then
			hitSurvivor(k, v)
			k.atkCd = clock() + R.AttackHitCd
			k.lungeUntil = 0
			updateSpeed(k)
		end
	end)
end
M.Attack = doAttack

local function nearestGen(match, a, range)
	local best, bd = nil, range
	for _, g in ipairs(match.K.reg.generators) do
		if not g:GetAttribute("Done") then
			local d = M.HDist(a, objPos(g))
			if d < bd then
				best, bd = g, d
			end
		end
	end
	return best
end

local function createTrap(match, k)
	local p = Instance.new("Part")
	p.Name = "Snare"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.25, 6, 6)
	p.CFrame = CFrame.new(k.root.Position.X, match.K.origin.Y + 0.15, k.root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 220, 140)
	p.Transparency = 0.55
	p.Parent = match.K.groups.Props
	local web = Instance.new("PointLight")
	web.Color = p.Color
	web.Range = 6
	web.Brightness = 0.6
	web.Parent = p
	table.insert(match.traps, { part = p, owner = k })
	table.insert(k.traps, p)
end

local function useAbility(a)
	local match = S.match
	local t = clock()
	if not match or match.over or not alive(a) or a.frozen or t < a.cd or a.busy or t < a.stunUntil then
		return
	end
	if a.kind == "Survivor" and not ownSurv(a) then
		return
	end
	local ab = a.cfg.ability
	local id = ab.id
	local used = true
	if id == "adrenaline" then
		a.boostUntil = t + ab.dur
		notify(a, "Адреналин!", "good")
	elseif id == "overcharge" then
		local g = nearestGen(match, a, 10)
		if g then
			addGenProgress(g, 12)
			addScore(a, "Ремонт", 12)
			sfx("crash", objPos(g), 0.5, 1.8)
			notify(a, "Перегрузка! +12% к генератору", "good")
		else
			notify(a, "Рядом нет генератора", "warn")
			used = false
		end
	elseif id == "syringe" then
		if a.state == "Injured" then
			a.state = "Healthy"
			notify(a, "Шприц использован.", "good")
		else
			notify(a, "Вы не ранены", "warn")
			used = false
		end
	elseif id == "echo" then
		if match.killer then
			fireActor(a, "AbilityFx", { type = "Reveal", targets = { match.killer.model }, dur = ab.dur, color = Color3.fromRGB(255, 60, 60) })
		end
	elseif id == "flash" then
		local k = match.killer
		if k and alive(k) then
			local d = flat(k.root.Position - a.root.Position)
			local look = flat(a.root.CFrame.LookVector)
			if d.Magnitude <= 18 and d.Magnitude > 0.1 and look.Magnitude > 0.1 and d.Unit:Dot(look.Unit) > 0.2 then
				stun(k, 1.2)
				fireActor(k, "AbilityFx", { type = "Blind", dur = ab.dur })
				notify(k, "Вас ослепили!", "bad")
				sfx("glass", a.root.Position, 1, 1.6)
			else
				notify(a, "Убийца не в зоне вспышки", "warn")
				used = false
			end
		end
	elseif id == "hush" then
		a.hushUntil = t + ab.dur
		notify(a, "Тишина...", "good")
	elseif id == "harvest" then
		a.dashUntil = t + ab.dur
		a.atkCd = t + ab.dur + 0.5
		a.dashHit = false
		sfx("lunge", a.root.Position, 1, 0.8)
		a.model:SetAttribute("AtkT", srv())
	elseif id == "veil" then
		a.veilUntil = t + ab.dur
		notify(a, "Вы невидимы", "good")
	elseif id == "snare" then
		local count = 0
		for i = #a.traps, 1, -1 do
			if a.traps[i].Parent then
				count += 1
			else
				table.remove(a.traps, i)
			end
		end
		if count >= 3 then
			local old = table.remove(a.traps, 1)
			if old then
				old:Destroy()
			end
		end
		createTrap(match, a)
		sfx("click", a.root.Position, 0.8, 0.6)
	elseif id == "sight" then
		local targets = {}
		for _, s in ipairs(match.survivors) do
			if alive(s) and s.state ~= "Hiding" then
				table.insert(targets, s.model)
			end
		end
		fireActor(a, "AbilityFx", { type = "Reveal", targets = targets, dur = ab.dur, color = Color3.fromRGB(255, 190, 60) })
	end
	if used then
		a.cd = t + ab.cd
		a.model:SetAttribute("AbReady", srv() + ab.cd)
	end
	updateSpeed(a)
	publish(a)
end
M.Ability = useAbility

--// ------------------------------------------------------------------ ТИК МАТЧА (10 Гц)
local function stateTick(match, a, dt, t)
	if a.frozen then
		publish(a)
		return
	end
	if a.kind == "Survivor" then
		if alive(a) then
			local v = a.root.AssemblyLinearVelocity
			local moving = math.sqrt(v.X * v.X + v.Z * v.Z) > 1
			local canSprint = a.reqSprint and moving and not a.reqCrouch and ownSurv(a) and not a.busy and not a.exhausted and t >= a.vaultUntil and t >= a.snaredUntil
			a.sprinting = canSprint and a.stamina > 0
			if a.sprinting then
				if t >= a.boostUntil then
					a.stamina = math.max(0, a.stamina - R.StaminaDrain * dt)
				end
				a.lastSprint = t
				if a.stamina <= 0 then
					a.exhausted = true
					a.sprinting = false
				end
			elseif t - a.lastSprint >= R.StaminaDelay then
				a.stamina = math.min(a.maxStamina, a.stamina + R.StaminaRegen * dt)
				if a.exhausted and a.stamina >= R.StaminaResume then
					a.exhausted = false
				end
			end
			if a.state == "Hooked" then
				a.hookTimer = a.hookTimer - dt
				if a.hookTimer <= 0 then
					die(a, "Сущность забрала вас.")
				end
			elseif a.state == "Downed" and not a.carriedBy then
				a.bleed = a.bleed - dt
				if a.bleed <= 0 then
					die(a, "Вы истекли кровью.")
				end
			end
		end
	else
		if t < a.dashUntil and a.state == "Idle" then
			local v = findVictim(a, 5.2, -1)
			if v and not a.dashHit then
				a.dashHit = true
				hitSurvivor(a, v)
				a.dashUntil = 0
				a.atkCd = t + R.AttackHitCd
			end
		end
	end
	tickChannel(a, dt)
	updateSpeed(a)
	publish(a)
end

local function broadcastState(match)
	local list = {}
	for _, s in ipairs(match.survivors) do
		table.insert(list, { n = s.name, c = s.charId, s = s.state, h = s.hooks, b = s.isBot or false })
	end
	local gates = {}
	for _, g in ipairs(match.K.reg.gates) do
		table.insert(gates, g:GetAttribute("Open") and 2 or (g:GetAttribute("Powered") and 1 or 0))
	end
	local payload = {
		t = math.max(0, match.endT - clock()), gens = match.gensDone, need = match.need, total = match.gensTotal,
		powered = match.powered, gates = gates, list = list, killer = { n = match.killer.name, c = match.killer.charId },
	}
	for _, a in ipairs(match.actors) do
		fireActor(a, "MatchState", payload)
	end
end

local function endMatch(reason)
	local m = S.match
	if not m or m.over then
		return
	end
	m.over = true
	S.phase = "Ending"
	for _, a in ipairs(m.actors) do
		stopChannel(a)
	end
	local escaped = 0
	for _, s in ipairs(m.survivors) do
		if s.state == "Escaped" then
			escaped += 1
		end
	end
	local needEscape = math.ceil(#m.survivors / 2)
	local survivorsWin = escaped >= needEscape or reason == "killerLeft"
	local results = {}
	for _, s in ipairs(m.survivors) do
		table.insert(results, { n = s.name, c = s.charId, s = (s.state == "Escaped") and "Escaped" or "Dead" })
	end
	for _, a in ipairs(m.actors) do
		if a.player and a.player.Parent and not a.left then
			local won = (a.kind == "Killer") ~= survivorsWin
			if a.kind == "Survivor" and a.state ~= "Escaped" then
				addScore(a, "Выживание", math.floor((clock() - m.startT) / 6))
			end
			local pts = 0
			local lines = {}
			for key, v in pairs(a.score) do
				if v >= 1 then
					pts += v
					table.insert(lines, { key, math.floor(v) })
				end
			end
			table.sort(lines, function(x, y)
				return x[2] > y[2]
			end)
			local shards = 40 + math.floor(pts / 7) + (won and 60 or 0)
			local xp = math.floor(shards * 1.4)
			local stat = {
				matches = 1, wins = won and 1 or 0, escapes = a.state == "Escaped" and 1 or 0, kills = a.stat.kills, hooks = a.stat.hooks,
				hits = a.stat.hits, rescues = a.stat.rescues, repairs = a.stat.repairs,
			}
			local ups = Shop.Reward(a.player, shards, xp, stat)
			local prof = Data.Get(a.player)
			if prof and a.kind == "Killer" then
				prof.lastKiller = os.time()
			end
			fireActor(a, "MatchEnd", {
				result = won and "Victory" or "Defeat", role = a.kind, survivorsWin = survivorsWin, escaped = escaped, total = #m.survivors,
				shards = shards, xp = xp, levelUps = ups, level = prof and prof.level or 1, lines = lines, results = results, reason = reason,
				mePersonal = a.kind == "Survivor" and (a.state == "Escaped" and "Вы сбежали" or "Вы погибли") or "Охота завершена",
			})
		end
	end
	task.wait(R.ResultsTime)
	-- уборка
	for _, a in ipairs(m.actors) do
		byModel[a.model] = nil
		if a.player then
			byPlayer[a.player] = nil
		end
		if a.isBot then
			a.model:Destroy()
		end
	end
	if m.K and m.K.model then
		m.K.model:Destroy()
	end
	for i = #flickers, 1, -1 do
		if flickers[i].map then
			table.remove(flickers, i)
		end
	end
	S.match = nil
	S.phase = "Lobby"
	local idx = 0
	for _, a in ipairs(m.actors) do
		if a.player and a.player.Parent then
			idx += 1
			Net.E("ToLobby"):FireClient(a.player, Lobby.lighting)
			task.spawn(M.SpawnLobby, a.player, idx)
		end
	end
	M.BroadcastLobby()
end

local function winCheck(match, t)
	if match.over then
		return
	end
	if t >= match.endT then
		for _, s in ipairs(match.survivors) do
			if alive(s) then
				die(s, "Время вышло — туман поглотил вас.")
			end
		end
		task.spawn(endMatch, "time")
		return
	end
	if match.killer.left or not alive(match.killer) then
		task.spawn(endMatch, "killerLeft")
		return
	end
	local anyAlive = false
	for _, s in ipairs(match.survivors) do
		if alive(s) then
			anyAlive = true
		end
	end
	if not anyAlive then
		task.spawn(endMatch, "resolved")
		return
	end
	local humans = 0
	for _, a in ipairs(match.actors) do
		if a.player and not a.left then
			humans += 1
		end
	end
	if humans == 0 then
		task.spawn(endMatch, "noHumans")
	end
end

local function matchTick(match, dt)
	local t = clock()
	local k = match.killer
	-- состояния
	for _, a in ipairs(match.actors) do
		if not a.left then
			stateTick(match, a, dt, t)
		end
	end
	-- античит (скорость)
	for _, a in ipairs(match.actors) do
		if a.player and alive(a) and not a.frozen then
			local pos = a.root.Position
			local allowed = (computeSpeed(a, t) + 8) * dt * 1.8 + 2.5
			if t < a.noClipUntil or a.root.Anchored or a.carriedBy or a.state == "Hooked" then
				a.lastPos = pos
			elseif flat(pos - a.lastPos).Magnitude > allowed then
				a.root.CFrame = CFrame.new(a.lastPos + Vector3.new(0, 0.5, 0)) * (a.root.CFrame - a.root.CFrame.Position)
				a.root.AssemblyLinearVelocity = Vector3.zero
			else
				a.lastPos = pos
			end
		end
	end
	-- погоня
	k.chasing = false
	for _, s in ipairs(match.survivors) do
		local chased = false
		if ownSurv(s) and alive(k) and t >= k.stunUntil and t >= k.veilUntil then
			local d = flat(s.root.Position - k.root.Position).Magnitude
			if d < R.ChaseRadius and (d < 10 or rayClear(match, k.root.Position + Vector3.new(0, 1.5, 0), s.root.Position + Vector3.new(0, 1, 0))) then
				chased = true
				k.chasing = true
				addScore(k, "Погоня", dt * 3)
			end
		end
		s.chased = chased
	end
	-- ловушки
	for i = #match.traps, 1, -1 do
		local tr = match.traps[i]
		if not tr.part.Parent then
			table.remove(match.traps, i)
		else
			for _, s in ipairs(match.survivors) do
				if ownSurv(s) and flat(s.root.Position - tr.part.Position).Magnitude < 3.6 and math.abs(s.root.Position.Y - tr.part.Position.Y) < 5 then
					s.snaredUntil = t + R.SnareTime
					stopChannel(s)
					notify(s, "Вы попали в ловушку!", "bad")
					fireActor(tr.owner, "AbilityFx", { type = "Reveal", targets = { s.model }, dur = 4, color = Color3.fromRGB(255, 220, 140) })
					notify(tr.owner, "Ловушка сработала!", "good")
					addScore(tr.owner, "Ловушки", 40)
					sfx("glass", tr.part.Position, 0.8, 1.3)
					tr.part:Destroy()
					table.remove(match.traps, i)
					break
				end
			end
		end
	end
	-- выход
	for _, gate in ipairs(match.K.reg.gates) do
		if gate:GetAttribute("Open") then
			local zone = gate:FindFirstChild("EscapeZone") :: BasePart
			if zone then
				for _, s in ipairs(match.survivors) do
					if ownSurv(s) then
						local rel = zone.CFrame:PointToObjectSpace(s.root.Position)
						local h = zone.Size / 2
						if math.abs(rel.X) < h.X and math.abs(rel.Y) < h.Y + 3 and math.abs(rel.Z) < h.Z then
							escape(s)
						end
					end
				end
			end
		end
	end
	-- гудение генераторов
	for _, g in ipairs(match.K.reg.generators) do
		if not g:GetAttribute("Done") then
			local workers = 0
			for _, s in ipairs(match.survivors) do
				if s.busy and s.busy.action == "Repair" and s.busy.target == g then
					workers += 1
				end
			end
			local snd = g.Body:FindFirstChild("Hum")
			if snd and snd:IsA("Sound") then
				snd.Playing = workers > 0
			end
			g:SetAttribute("Workers", workers)
		end
	end
	-- боты
	for _, a in ipairs(match.actors) do
		if a.isBot and alive(a) and not a.frozen then
			a.thinkAcc = (a.thinkAcc or 0) + dt
			if a.thinkAcc >= 0.25 and not a.thinking then
				a.thinkAcc = 0
				a.thinking = true
				task.spawn(function()
					local ok, err = pcall(Bots.Think, M, match, a)
					if not ok then
						warn("[Hollowfall] Bot error: " .. tostring(err))
					end
					a.thinking = false
				end)
			end
		end
	end
	match.stateAcc = (match.stateAcc or 0) + dt
	if match.stateAcc >= 0.5 then
		match.stateAcc = 0
		broadcastState(match)
	end
	winCheck(match, t)
end

--// ------------------------------------------------------------------ ЗАПУСК МАТЧА
local function shuffle(list)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function pickMap(participants)
	local tally = {}
	for _, p in ipairs(participants) do
		local v = S.votes[p]
		if v and Config.Maps[v] then
			tally[v] = (tally[v] or 0) + 1
		end
	end
	local best, bc = nil, 0
	for id, c in pairs(tally) do
		if c > bc then
			best, bc = id, c
		end
	end
	return best or Config.MapOrder[rng:NextInteger(1, #Config.MapOrder)]
end

local function runMatch(survHumans, killerHuman)
	S.phase = "Starting"
	M.BroadcastLobby()
	local participants = {}
	for _, p in ipairs(survHumans) do
		table.insert(participants, p)
	end
	if killerHuman then
		table.insert(participants, killerHuman)
	end
	for _, p in ipairs(participants) do
		S.queue[p] = nil
		Net.E("QueueUpdate"):FireClient(p, { queued = false, count = 0, phase = "Starting", starting = true })
	end
	local mapId = pickMap(participants)
	local K = Maps.Build(mapId, MAP_ORIGIN)
	K.model.Parent = workspace
	local match = {
		K = K, mapId = mapId, actors = {}, survivors = {}, killer = nil, gensDone = 0, gensTotal = #K.reg.generators,
		need = math.min(R.GenNeeded, #K.reg.generators), powered = false, traps = {}, over = false, escapes = 0, startT = clock(), endT = clock() + R.Intro + R.MatchTime,
	}
	S.match = match
	for _, e in ipairs(K.flicker) do
		e.map = true
		table.insert(flickers, e)
	end
	-- места
	local spawns = shuffle({ table.unpack(K.reg.spawns) })
	local function cfAt(pos, look)
		return CFrame.lookAt(pos, Vector3.new(look.X, pos.Y, look.Z))
	end
	local centerLook = K.origin
	local function newSurvivor(player, idx)
		local pos = spawns[((idx - 1) % #spawns) + 1]
		if player then
			local prof = Data.Get(player)
			local charId = prof.equipped.survivor
			local model = CharService.Spawn(player, cfAt(pos, centerLook), charId, prof, { showFx = false, canJump = false })
			if model then
				return makeActor(match, "Survivor", player, model, charId, prof.equipped.skins[charId], false)
			end
		else
			local list = Config.SurvivorOrder
			local charId = list[rng:NextInteger(1, #list)]
			local skins = Config.Skins[charId]
			local skin = skins[rng:NextInteger(1, #skins)].id
			local model = CharService.SpawnBot("Бот" .. idx, cfAt(pos, centerLook), charId, skin)
			if model then
				return makeActor(match, "Survivor", nil, model, charId, skin, true)
			end
		end
		return nil
	end
	local idx = 0
	for _, p in ipairs(survHumans) do
		idx += 1
		newSurvivor(p, idx)
	end
	while #match.survivors < R.SurvivorCount do
		idx += 1
		newSurvivor(nil, idx)
	end
	local kpos = K.reg.killer
	if killerHuman then
		local prof = Data.Get(killerHuman)
		local charId = prof.equipped.killer
		local model = CharService.Spawn(killerHuman, cfAt(kpos, centerLook), charId, prof, { showFx = true, canJump = false })
		if model then
			makeActor(match, "Killer", killerHuman, model, charId, prof.equipped.skins[charId], false)
		end
	end
	if not match.killer then
		local charId = Config.KillerOrder[rng:NextInteger(1, #Config.KillerOrder)]
		local skins = Config.Skins[charId]
		local skin = skins[rng:NextInteger(1, #skins)].id
		local model = CharService.SpawnBot("Бот-убийца", cfAt(kpos, centerLook), charId, skin)
		if model then
			makeActor(match, "Killer", nil, model, charId, skin, true)
		end
	end
	if not match.killer or #match.survivors == 0 then
		warn("[Hollowfall] Не удалось создать участников матча")
		match.over = true
		S.phase = "Ending"
		task.spawn(function()
			K.model:Destroy()
			S.match = nil
			S.phase = "Lobby"
		end)
		return
	end
	local ex = {}
	for _, a in ipairs(match.actors) do
		table.insert(ex, a.model)
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = ex
	match.rayParams = rp
	match.startT = clock()
	match.endT = clock() + R.Intro + R.MatchTime
	local survInfo = {}
	for _, s in ipairs(match.survivors) do
		table.insert(survInfo, { n = s.name, c = s.charId, b = s.isBot })
	end
	for _, a in ipairs(match.actors) do
		if a.player then
			fireActor(a, "MatchStart", {
				map = mapId, mapName = Config.Maps[mapId].name, role = a.kind, charId = a.charId, killer = { n = match.killer.name, c = match.killer.charId },
				survivors = survInfo, duration = R.MatchTime, intro = R.Intro, endTime = srv() + R.Intro + R.MatchTime, need = match.need, total = match.gensTotal,
				lighting = K.lighting, abilityCd = a.cfg.ability.cd, wind = K.lighting.wind,
			})
		end
	end
	task.wait(R.Intro)
	if match.over then
		return
	end
	for _, a in ipairs(match.actors) do
		a.frozen = false
		a.lastPos = a.root.Position
		updateSpeed(a)
	end
	S.phase = "Playing"
	M.BroadcastLobby()
	local last = clock()
	while not match.over do
		task.wait(0.1)
		local now = clock()
		local dt = math.min(now - last, 0.5)
		last = now
		local ok, err = pcall(matchTick, match, dt)
		if not ok then
			warn("[Hollowfall] matchTick error: " .. tostring(err))
		end
	end
end

--// ------------------------------------------------------------------ ЛОББИ И ОЧЕРЕДЬ
local function queueCount()
	local n = 0
	for p, _ in pairs(S.queue) do
		if p.Parent then
			n += 1
		else
			S.queue[p] = nil
		end
	end
	return n
end

function M.BroadcastLobby()
	local payload = { phase = S.phase, players = #Players:GetPlayers(), queue = queueCount() }
	Net.E("LobbyState"):FireAllClients(payload)
end

local function broadcastQueue(eta)
	local count = queueCount()
	for _, p in ipairs(Players:GetPlayers()) do
		Net.E("QueueUpdate"):FireClient(p, { queued = S.queue[p] ~= nil, count = count, eta = eta, phase = S.phase, needed = 5 })
	end
end

local lobbyIndex = 0
function M.SpawnLobby(player, idx)
	local prof = Data.Wait(player, 20)
	if not prof or not player.Parent then
		return
	end
	lobbyIndex += 1
	local charId = prof.settings.role == "Killer" and prof.equipped.killer or prof.equipped.survivor
	local cf = Lobby.SpawnCFrame(idx or lobbyIndex)
	CharService.Spawn(player, cf, charId, prof, { showFx = true, canJump = true })
end

local refreshDebounce = {}
function M.RefreshLobbyCostume(player)
	if byPlayer[player] or not player.Parent then
		return
	end
	local stamp = clock()
	refreshDebounce[player] = stamp
	task.delay(0.4, function()
		if refreshDebounce[player] ~= stamp or byPlayer[player] or not player.Parent then
			return
		end
		local prof = Data.Get(player)
		local char = player.Character
		if not prof or not char then
			return
		end
		local cf = char:GetPivot()
		local charId = prof.settings.role == "Killer" and prof.equipped.killer or prof.equipped.survivor
		CharService.Spawn(player, cf, charId, prof, { showFx = true, canJump = true })
	end)
end

local function startFromQueue()
	local list = {}
	for p, q in pairs(S.queue) do
		if p.Parent and Data.Get(p) then
			table.insert(list, { p = p, q = q })
		end
	end
	table.sort(list, function(x, y)
		return x.q.t < y.q.t
	end)
	if #list == 0 then
		return
	end
	local chosen = {}
	for i = 1, math.min(5, #list) do
		chosen[i] = list[i]
	end
	local cands = {}
	for _, e in ipairs(chosen) do
		if e.q.role ~= "Survivor" then
			table.insert(cands, e)
		end
	end
	table.sort(cands, function(x, y)
		local px = x.q.role == "Killer" and 0 or 1
		local py = y.q.role == "Killer" and 0 or 1
		if px ~= py then
			return px < py
		end
		return Data.Get(x.p).lastKiller < Data.Get(y.p).lastKiller
	end)
	local killerP = cands[1] and cands[1].p or nil
	local surv = {}
	for _, e in ipairs(chosen) do
		if e.p ~= killerP and #surv < R.SurvivorCount then
			table.insert(surv, e.p)
		end
	end
	S.forceStart = false
	S.searchStart = nil
	task.spawn(runMatch, surv, killerP)
end

local function handleLeave(player)
	S.queue[player] = nil
	S.votes[player] = nil
	local a = byPlayer[player]
	if a and S.match and not S.match.over then
		a.left = true
		if a.kind == "Survivor" then
			die(a, "Игрок вышел")
		else
			a.state = "Dead"
		end
	end
end

function M.Init()
	CharService.Init()
	Players.CharacterAutoLoads = false
	LightingFx.Apply(Lobby.lighting, true)
	local K = Lobby.Build()
	for _, e in ipairs(K.flicker) do
		table.insert(flickers, e)
	end

	Shop.OnEquip = function(player)
		M.RefreshLobbyCostume(player)
	end

	local function onPlayer(player)
		task.spawn(function()
			local prof = Data.Wait(player, 25)
			if not prof or not player.Parent then
				return
			end
			if not byPlayer[player] then
				M.SpawnLobby(player)
			end
			M.BroadcastLobby()
			broadcastQueue(nil)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		handleLeave(p)
		task.defer(M.BroadcastLobby)
	end)

	Net.E("QueueJoin").OnServerEvent:Connect(function(player, role)
		if byPlayer[player] or not Data.Get(player) then
			return
		end
		if role ~= "Any" and role ~= "Survivor" and role ~= "Killer" then
			role = "Any"
		end
		local prof = Data.Get(player)
		local changed = prof.settings.role ~= role
		prof.settings.role = role
		Data.MarkDirty(player)
		S.queue[player] = { role = role, t = clock() }
		if changed then
			M.RefreshLobbyCostume(player)
		end
		broadcastQueue(nil)
		M.BroadcastLobby()
	end)
	Net.E("QueueLeave").OnServerEvent:Connect(function(player)
		S.queue[player] = nil
		broadcastQueue(nil)
		M.BroadcastLobby()
	end)
	Net.E("VoteMap").OnServerEvent:Connect(function(player, mapId)
		if type(mapId) == "string" and (Config.Maps[mapId] or mapId == "") then
			S.votes[player] = mapId ~= "" and mapId or nil
		end
	end)
	Net.E("StartNow").OnServerEvent:Connect(function(player)
		local q = S.queue[player]
		if q and clock() - q.t >= 2 and S.phase == "Lobby" then
			S.forceStart = true
		end
	end)

	Net.E("Interact").OnServerEvent:Connect(function(player, action, target, begin)
		local a = byPlayer[player]
		if not a or type(action) ~= "string" then
			return
		end
		if begin == false then
			if a.busy then
				stopChannel(a)
			end
			return
		end
		local t = clock()
		if t - a.lastInteract < 0.12 then
			return
		end
		a.lastInteract = t
		M.Do(a, action, target)
	end)
	Net.E("Attack").OnServerEvent:Connect(function(player)
		local a = byPlayer[player]
		if a then
			doAttack(a)
		end
	end)
	Net.E("Ability").OnServerEvent:Connect(function(player)
		local a = byPlayer[player]
		if a then
			useAbility(a)
		end
	end)
	Net.E("SetStance").OnServerEvent:Connect(function(player, sprint, crouch)
		local a = byPlayer[player]
		if not a or a.kind ~= "Survivor" then
			return
		end
		a.reqSprint = sprint == true
		a.reqCrouch = crouch == true
		updateSpeed(a)
	end)
	Net.E("SkillCheckResult").OnServerEvent:Connect(function(player, id, angle)
		local a = byPlayer[player]
		if not a or not a.busy or not a.busy.sc or type(id) ~= "number" or type(angle) ~= "number" then
			return
		end
		local sc = a.busy.sc
		if sc.id ~= id then
			return
		end
		local elapsed = clock() - sc.t0 - sc.delay
		local expected = (elapsed * sc.speed) % 360
		local diff = math.abs(angle - expected)
		diff = math.min(diff, 360 - diff)
		local result = "fail"
		if elapsed > 0.05 and diff < 75 and angle >= sc.zone and angle <= sc.zone + sc.width then
			result = (angle >= sc.zone + sc.width - sc.great) and "great" or "good"
		end
		resolveSkillCheck(a, result)
	end)
	Net.E("PlayEmote").OnServerEvent:Connect(function(player, id)
		local prof = Data.Get(player)
		local char = player.Character
		if not prof or not char or type(id) ~= "string" then
			return
		end
		local a = byPlayer[player]
		if a and (a.kind ~= "Survivor" or not ownSurv(a) or a.chased) then
			return
		end
		if id == "" then
			char:SetAttribute("Emote", "")
			return
		end
		local an = Config.Animations[id]
		if not an or an.kind ~= "emote" or not prof.owned[id] then
			return
		end
		char:SetAttribute("Emote", id)
		task.delay(7, function()
			if char.Parent and char:GetAttribute("Emote") == id then
				char:SetAttribute("Emote", "")
			end
		end)
	end)

	-- цикл очереди
	task.spawn(function()
		while true do
			task.wait(1)
			if S.phase == "Lobby" then
				local c = queueCount()
				local eta = nil
				if c == 0 then
					S.searchStart = nil
				else
					S.searchStart = S.searchStart or clock()
					local waited = clock() - S.searchStart
					local limit = (c >= 5 and R.FullQueueDelay) or (c >= 3 and 12) or R.SearchTime
					if S.forceStart then
						limit = 0
					end
					eta = math.max(0, math.ceil(limit - waited))
					if eta <= 0 then
						startFromQueue()
					end
				end
				broadcastQueue(eta)
			else
				broadcastQueue(nil)
			end
		end
	end)
end

return M
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX30">
        <Properties>
          <string name="Name">ShopService</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: ShopService — покупка, экипировка, ежедневная награда, настройки, награды за матч
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Data = require(script.Parent:WaitForChild("DataService"))

local ShopService = {}
ShopService.OnEquip = function(_player, _cat) end
local lastCall = {}

local function throttle(player, name, gap)
	lastCall[player] = lastCall[player] or {}
	local now = os.clock()
	if lastCall[player][name] and now - lastCall[player][name] < gap then
		return false
	end
	lastCall[player][name] = now
	return true
end

function ShopService.Purchase(player, itemId)
	if type(itemId) ~= "string" or not throttle(player, "buy", 0.3) then
		return false, "Слишком часто"
	end
	local p = Data.Get(player)
	local item = Config.Items[itemId]
	if not p or not item then
		return false, "Предмет не найден"
	end
	if p.owned[itemId] then
		return false, "Уже куплено"
	end
	if item.cat == "skin" and not p.owned[item.char] then
		return false, "Сначала откройте персонажа"
	end
	if p.shards < item.price then
		return false, "Недостаточно осколков"
	end
	p.shards = p.shards - item.price
	p.owned[itemId] = true
	Data.MarkDirty(player)
	Data.Push(player)
	return true, "Куплено: " .. item.name
end

function ShopService.Equip(player, cat, id, extra)
	if type(cat) ~= "string" or type(id) ~= "string" or not throttle(player, "equip", 0.15) then
		return false, "Ошибка"
	end
	local p = Data.Get(player)
	if not p then
		return false, "Профиль не загружен"
	end
	local eq = p.equipped
	if cat == "survivor" then
		if not Config.Survivors[id] or not p.owned[id] then
			return false, "Персонаж недоступен"
		end
		eq.survivor = id
	elseif cat == "killer" then
		if not Config.Killers[id] or not p.owned[id] then
			return false, "Убийца недоступен"
		end
		eq.killer = id
	elseif cat == "skin" then
		local s = Config.SkinById[id]
		if not s or not p.owned[id] then
			return false, "Скин недоступен"
		end
		eq.skins[s.char] = id
	elseif cat == "accessory" then
		local slot = extra
		if type(slot) ~= "string" or not table.find(Config.AccSlots, slot) then
			return false, "Неверный слот"
		end
		if id == "" then
			eq.acc[slot] = nil
		else
			local it = Config.Items[id]
			if not it or it.cat ~= "accessory" or it.slot ~= slot or not p.owned[id] then
				return false, "Аксессуар недоступен"
			end
			eq.acc[slot] = id
		end
	elseif cat == "emote" or cat == "style" then
		if id ~= "" then
			local a = Config.Animations[id]
			if not a or a.kind ~= cat or not p.owned[id] then
				return false, "Анимация недоступна"
			end
		end
		eq[cat] = id
	elseif cat == "effect" then
		if id ~= "" and (not Config.Effects[id] or not p.owned[id]) then
			return false, "Эффект недоступен"
		end
		eq.effect = id
	else
		return false, "Неизвестная категория"
	end
	Data.MarkDirty(player)
	Data.Push(player)
	ShopService.OnEquip(player, cat)
	return true, "Экипировано"
end

function ShopService.ClaimDaily(player)
	local p = Data.Get(player)
	if not p or not throttle(player, "daily", 1) then
		return false, "Недоступно", 0
	end
	local now = os.time()
	local D = Config.Daily
	local left = D.cooldown - (now - p.lastDaily)
	if left > 0 then
		return false, string.format("Следующая награда через %d ч %d мин", math.floor(left / 3600), math.floor((left % 3600) / 60)), 0
	end
	if now - p.lastDaily < 48 * 3600 then
		p.streak = math.min(p.streak + 1, D.maxStreak)
	else
		p.streak = 1
	end
	local amount = D.base + D.perStreak * (p.streak - 1)
	p.shards = p.shards + amount
	p.lastDaily = now
	Data.MarkDirty(player)
	Data.Push(player)
	return true, string.format("Ежедневная награда: +%d осколков (серия %d)", amount, p.streak), amount
end

function ShopService.SaveSettings(player, s)
	local p = Data.Get(player)
	if not p or type(s) ~= "table" or not throttle(player, "settings", 0.3) then
		return
	end
	local st = p.settings
	if type(s.music) == "number" then
		st.music = math.clamp(s.music, 0, 1)
	end
	if type(s.sfx) == "number" then
		st.sfx = math.clamp(s.sfx, 0, 1)
	end
	if s.role == "Any" or s.role == "Survivor" or s.role == "Killer" then
		st.role = s.role
	end
	if type(s.shake) == "boolean" then
		st.shake = s.shake
	end
	if type(s.sprintToggle) == "boolean" then
		st.sprintToggle = s.sprintToggle
	end
	if type(s.lowGfx) == "boolean" then
		st.lowGfx = s.lowGfx
	end
	Data.MarkDirty(player)
end

--// Награда после матча (вызывает MatchService)
function ShopService.Reward(player, shards, xp, statDelta)
	local p = Data.Get(player)
	if not p then
		return 0
	end
	p.shards = p.shards + shards
	local ups = Config.ProcessXp(p, xp)
	for k, v in pairs(statDelta or {}) do
		p.stats[k] = (p.stats[k] or 0) + v
	end
	Data.MarkDirty(player)
	Data.Push(player)
	return ups
end

function ShopService.Init()
	Net.F("Purchase").OnServerInvoke = function(player, id)
		local ok, msg = ShopService.Purchase(player, id)
		return ok, msg
	end
	Net.F("Equip").OnServerInvoke = function(player, cat, id, extra)
		local ok, msg = ShopService.Equip(player, cat, id, extra)
		return ok, msg
	end
	Net.F("ClaimDaily").OnServerInvoke = function(player)
		local ok, msg, amount = ShopService.ClaimDaily(player)
		return ok, msg, amount
	end
	Net.E("SaveSettings").OnServerEvent:Connect(function(player, s)
		ShopService.SaveSettings(player, s)
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(pl)
		lastCall[pl] = nil
	end)
end

return ShopService
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX31">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="UserEmotesEnabled">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX33">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX34">
          <Properties>
            <string name="Name">AnimClient</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/AnimClient — процедурная анимация всех персонажей, шаги, невидимость, подсветка аур
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local AnimLib = require(Shared:WaitForChild("AnimLib"))
local UI = require(script.Parent:WaitForChild("UI"))

local lp = Players.LocalPlayer
local S = UI.S
local AnimClient: any = {}
local chars: any = {}

local function attach(model)
	if chars[model] then
		return
	end
	chars[model] = false
	task.spawn(function()
		local hum = model:WaitForChild("Humanoid", 15)
		local root = model:WaitForChild("HumanoidRootPart", 15)
		model:WaitForChild("LowerTorso", 15)
		model:WaitForChild("RightFoot", 15)
		model:WaitForChild("LeftHand", 15)
		task.wait(0.15)
		if not model.Parent or not hum or not root then
			chars[model] = nil
			return
		end
		chars[model] = { ctrl = AnimLib.new(model), hum = hum, root = root, step = 0, veil = false, vT = 0, blood = nil }
	end)
end

local function stepSound(c, model, vol, pitch)
	local id = Config.Audio.step
	if not id or id == "" then
		return
	end
	local s = c.stepSound
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 5
		s.RollOffMaxDistance = 70
		s.Parent = c.root
		c.stepSound = s
	end
	s.Volume = vol * UI.sfxVolume()
	s.PlaybackSpeed = pitch
	s:Play()
end

local function setVeil(model, on, isSelf)
	local v = on and (isSelf and 0.55 or 0.94) or 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = v
		end
	end
end

local function bloodFx(c, model, on)
	if on and not c.blood then
		local t = model:FindFirstChild("UpperTorso")
		if t then
			local e = Instance.new("ParticleEmitter")
			e.Rate = 5
			e.Lifetime = NumberRange.new(0.7, 1.1)
			e.Speed = NumberRange.new(0.5, 1.5)
			e.Acceleration = Vector3.new(0, -26, 0)
			e.Color = ColorSequence.new(Color3.fromRGB(150, 10, 20))
			e.Size = NumberSequence.new(0.18)
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			e.SpreadAngle = Vector2.new(30, 30)
			e.Parent = t
			c.blood = e
		end
	end
	if c.blood then
		c.blood.Enabled = on and not (S.profile and S.profile.settings.lowGfx)
	end
end

function AnimClient.Init()
	for _, m in ipairs(CollectionService:GetTagged("HFChar")) do
		attach(m)
	end
	CollectionService:GetInstanceAddedSignal("HFChar"):Connect(attach)

	local cam = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function(dt)
		local camPos = cam.CFrame.Position
		local sNow = workspace:GetServerTimeNow()
		for model, c in pairs(chars) do
			if not model.Parent then
				chars[model] = nil
			elseif c then
				local root = c.root
				local v = root.AssemblyLinearVelocity
				local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
				if root.Anchored then
					speed = 0
				end
				local st = model:GetAttribute("State") or "Healthy"
				local isKiller = model:GetAttribute("Role") == "Killer"
				local atk = model:GetAttribute("AtkT")
				local inp = {
					speed = speed, state = st, crouch = model:GetAttribute("Crouch"), sprint = model:GetAttribute("Sprint"),
					emote = model:GetAttribute("Emote"), style = model:GetAttribute("Style"), attackAge = atk and (sNow - atk) or nil,
					killerId = isKiller and model:GetAttribute("CharId") or nil, carrying = model:GetAttribute("Carrying"),
					stunned = model:GetAttribute("Stunned"), vault = model:GetAttribute("Vault"), hookStage = model:GetAttribute("Hooks"),
				}
				local dist = (root.Position - camPos).Magnitude
				if dist < 160 and st ~= "Dead" and st ~= "Escaped" then
					c.ctrl:Update(dt, inp)
					-- шаги
					if speed > 3 and (st == "Healthy" or st == "Injured") and not model:GetAttribute("Silent") and dist < 80 and not root.Anchored then
						local k = math.floor(c.ctrl.phase / math.pi)
						if k ~= c.step then
							c.step = k
							local vol = inp.crouch and 0.08 or (isKiller and 0.55 or (inp.sprint and 0.5 or 0.28))
							stepSound(c, model, vol, 0.8 + math.random() * 0.3)
						end
					end
				end
				-- невидимость / кровь
				c.vT += dt
				if c.vT > 0.2 then
					c.vT = 0
					local veil = model:GetAttribute("Veil") == true
					if veil ~= c.veil then
						c.veil = veil
						setVeil(model, veil, model == lp.Character)
					elseif veil then
						setVeil(model, true, model == lp.Character)
					end
					bloodFx(c, model, st == "Injured" or st == "Downed")
				end
			end
		end
	end)

	Net.E("AbilityFx").OnClientEvent:Connect(function(d)
		if d.type == "Reveal" then
			for _, m in ipairs(d.targets or {}) do
				if m and m.Parent then
					local h = Instance.new("Highlight")
					h.FillColor = d.color or Color3.fromRGB(255, 60, 60)
					h.OutlineColor = Color3.new(1, 1, 1)
					h.FillTransparency = 0.55
					h.OutlineTransparency = 0.1
					h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					h.Parent = m
					Debris:AddItem(h, d.dur or 4)
				end
			end
		elseif d.type == "Pulse" then
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.Shape = Enum.PartType.Ball
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(255, 60, 60)
			p.Transparency = 0.4
			p.Size = Vector3.new(2, 2, 2)
			p.Position = d.pos + Vector3.new(0, 4, 0)
			p.Parent = workspace
			UI.tween(p, { Size = Vector3.new(34, 34, 34), Transparency = 1 }, 1.2)
			Debris:AddItem(p, 1.4)
		end
	end)
end

return AnimClient
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX35">
          <Properties>
            <string name="Name">AudioClient</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/AudioClient — атмосфера (ветер, гул, сердцебиение), позиционные эффекты
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local S = UI.S
local Audio: any = {}

local mode = "lobby"
local windLevel = 0.5
local wind, drone, music, chase
local hbT, hbPhase = 0, 0
local volWind, volDrone, volMusic, volChase = 0, 0, 0, 0

local function loop(id, speed)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.PlaybackSpeed = speed
	s.Parent = SoundService
	s:Play()
	return s
end

local function effects(s, low, high, wet)
	local eq = Instance.new("EqualizerSoundEffect")
	eq.LowGain = low
	eq.MidGain = -6
	eq.HighGain = high
	eq.Parent = s
	local rv = Instance.new("ReverbSoundEffect")
	rv.DecayTime = 3.5
	rv.Density = 0.9
	rv.Diffusion = 0.8
	rv.WetLevel = wet
	rv.DryLevel = -2
	rv.Parent = s
end

local function musicVol()
	local p = S.profile
	return p and p.settings.music or 0.6
end

function Audio.SetMode(m, wl)
	mode = m
	windLevel = wl or 0.5
end

function Audio.PlayAt(name, pos, vol, pitch)
	local id = Config.Audio[name]
	if not id or id == "" or typeof(pos) ~= "Vector3" then
		return
	end
	local cam = workspace.CurrentCamera
	if (cam.CFrame.Position - pos).Magnitude > 170 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = workspace
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = math.clamp((vol or 1) * UI.sfxVolume(), 0, 3)
	s.PlaybackSpeed = pitch or 1
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 140
	s.Parent = p
	s:Play()
	Debris:AddItem(p, 5)
end

local function thump(vol, pitch)
	local id = Config.Audio.thump
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = math.clamp(vol * UI.sfxVolume(), 0, 2)
	s.PlaybackSpeed = pitch
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = -40
	eq.MidGain = -12
	eq.LowGain = 6
	eq.Parent = s
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

function Audio.Init()
	wind = loop(Config.Audio.wind, 0.35)
	effects(wind, 2, -30, -8)
	drone = loop(Config.Audio.wind, 0.18)
	effects(drone, 8, -40, -4)
	if Config.Audio.musicLobby ~= "" then
		music = loop(Config.Audio.musicLobby, 1)
	end
	if Config.Audio.musicChase ~= "" then
		chase = loop(Config.Audio.musicChase, 1)
	end
	Net.E("Sfx").OnClientEvent:Connect(function(name, pos, vol, pitch)
		Audio.PlayAt(name, pos, vol, pitch)
	end)
	RunService.Heartbeat:Connect(function(dt)
		local mv = musicVol()
		local tWind = (mode == "match" and (0.1 + windLevel * 0.28) or 0.14) * mv
		local tDrone = (mode == "match" and 0.2 or 0.1) * mv
		local tMusic = (mode == "lobby" and 0.45 or 0.12) * mv
		local tChase = 0
		local terror = S.terror or 0
		if S.inMatch and S.role == "Survivor" then
			tDrone = tDrone + terror * 0.25 * mv
			if S.chased then
				tChase = 0.5 * mv
				tMusic = 0
			end
			-- сердцебиение
			if terror > 0.06 then
				hbT += dt
				local interval = 1.1 - 0.62 * terror
				if hbT >= interval then
					hbT = 0
					thump(0.25 + 0.7 * terror, 0.55 + 0.25 * terror)
					task.delay(0.2, function()
						thump(0.16 + 0.5 * terror, 0.5 + 0.2 * terror)
					end)
				end
			end
		end
		local a = math.min(1, dt * 1.5)
		volWind += (tWind - volWind) * a
		volDrone += (tDrone - volDrone) * a
		volMusic += (tMusic - volMusic) * a
		volChase += (tChase - volChase) * math.min(1, dt * 3)
		wind.Volume = volWind
		drone.Volume = volDrone
		drone.PlaybackSpeed = 0.18 + terror * 0.1
		if music then
			music.Volume = volMusic
		end
		if chase then
			chase.Volume = volChase
		end
		hbPhase += dt
	end)
end

return Audio
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX36">
          <Properties>
            <string name="Name">Controls</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/Controls — ввод (ПК / телефон / планшет / геймпад), поиск взаимодействий, рывки/перепрыгивания
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))
local HUD = require(script.Parent:WaitForChild("HUD"))

local lp = Players.LocalPlayer
local S = UI.S
local C = UI.C
local Controls: any = {}

local sprintKey, sprintToggle, crouchKey, crouchToggle = false, false, false, false
local current = nil
local holding = nil
local lastSent = { s = false, c = false }
local lastSendT = 0
local scanT = 0
local emoteBar = nil

local RANGE = { Generator = 7, Gate = 9, Locker = 6, Pallet = 7, Window = 5.5, Hook = 8 }

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function posOf(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return (inst :: BasePart).Position
end

local function scan()
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local st = char:GetAttribute("State")
	if st == "Dead" or st == "Escaped" or st == "Carried" or st == "Hooked" or st == "Downed" then
		return nil
	end
	if char:GetAttribute("Vault") or char:GetAttribute("Stunned") or char:GetAttribute("Snared") then
		return nil
	end
	local role = S.role
	local cam = workspace.CurrentCamera
	local look = flat(cam.CFrame.LookVector)
	local best, bs = nil, math.huge
	local function consider(action, target, pos, label, instant, range)
		local d = flat(pos - root.Position)
		if d.Magnitude > range or math.abs(pos.Y - root.Position.Y) > 7.5 then
			return
		end
		local dot = 0
		if d.Magnitude > 0.1 and look.Magnitude > 0.1 then
			dot = d.Unit:Dot(look.Unit)
		end
		local score = d.Magnitude - dot * 2.5
		if score < bs then
			bs = score
			best = { action = action, target = target, label = label, instant = instant, pos = pos }
		end
	end
	local hiding = st == "Hiding"
	for _, inst in ipairs(CollectionService:GetTagged("HFInteract")) do
		local kind = inst:GetAttribute("Kind")
		local pos = posOf(inst)
		if role == "Survivor" then
			if hiding then
				if kind == "Locker" and inst:GetAttribute("Occupied") then
					consider("Hide", inst, pos, "Выйти из шкафчика", true, 7)
				end
			elseif kind == "Generator" and not inst:GetAttribute("Done") then
				consider("Repair", inst, pos, "Чинить генератор (" .. math.floor(inst:GetAttribute("Progress") or 0) .. "%)", false, RANGE.Generator)
			elseif kind == "Gate" and inst:GetAttribute("Powered") and not inst:GetAttribute("Open") then
				consider("OpenGate", inst, pos, "Открыть ворота", false, RANGE.Gate)
			elseif kind == "Locker" and not inst:GetAttribute("Occupied") then
				consider("Hide", inst, pos, "Спрятаться", false, RANGE.Locker)
			elseif kind == "Pallet" and inst:GetAttribute("State") == "Up" then
				consider("Drop", inst, pos, "Уронить баррикаду", true, RANGE.Pallet)
			elseif kind == "Window" then
				consider("Vault", inst, pos, "Перепрыгнуть", true, RANGE.Window)
			end
		elseif role == "Killer" then
			local carrying = char:GetAttribute("Carrying")
			if kind == "Generator" and not inst:GetAttribute("Done") and (inst:GetAttribute("Progress") or 0) > 1 and not carrying then
				consider("Sabotage", inst, pos, "Испортить генератор", false, RANGE.Generator)
			elseif kind == "Hook" and carrying and not inst:GetAttribute("Occupied") then
				consider("Hook", inst, pos, "Повесить на крюк", false, RANGE.Hook)
			elseif kind == "Locker" and not carrying then
				consider("Search", inst, pos, "Обыскать шкафчик", false, RANGE.Locker)
			elseif kind == "Pallet" and inst:GetAttribute("State") == "Dropped" and not carrying then
				consider("Break", inst, pos, "Сломать баррикаду", false, RANGE.Pallet)
			elseif kind == "Window" and not carrying then
				consider("Vault", inst, pos, "Перепрыгнуть", true, RANGE.Window)
			end
		end
	end
	if not hiding then
		for _, m in ipairs(CollectionService:GetTagged("HFChar")) do
			if m ~= char then
				local r = m:FindFirstChild("HumanoidRootPart")
				local ms = m:GetAttribute("State")
				if r and r:IsA("BasePart") and m:GetAttribute("Role") == "Survivor" and ms then
					if role == "Survivor" then
						if ms == "Injured" then
							consider("Heal", m, r.Position, "Лечить: " .. m.Name, false, 6.5)
						elseif ms == "Downed" then
							consider("Heal", m, r.Position, "Поднять: " .. m.Name, false, 6.5)
						elseif ms == "Hooked" then
							consider("Unhook", m, r.Position, "Снять с крюка: " .. m.Name, false, 7.5)
						end
					elseif role == "Killer" then
						if ms == "Downed" and not char:GetAttribute("Carrying") then
							consider("Pickup", m, r.Position, "Подобрать жертву", false, 6.5)
						end
					end
				end
			end
		end
		if not best and role == "Survivor" and st == "Injured" then
			best = { action = "Heal", target = nil, label = "Лечить себя (удерживайте)", instant = false, pos = root.Position }
		end
	end
	return best
end

local function setPrompt(c)
	current = c
	HUD.SetPrompt(c and c.label or nil)
	if UI.mobile then
		local b = HUD.buttons.interact
		for _, l in ipairs(b:GetChildren()) do
			if l:IsA("TextLabel") and l.Font == UI.fontBold and l.TextSize >= 14 and l.Size.Y.Scale == 1 then
				local txt = c and c.label or "ДЕЙСТВИЕ"
				local n = utf8.len(txt)
				if n and n > 16 then
					txt = string.sub(txt, 1, (utf8.offset(txt, 17) or (#txt + 1)) - 1)
				end
				l.Text = txt
				l.TextColor3 = c and C.gold or C.dim
			end
		end
	end
end

local function interactDown()
	if holding or not current or not S.inMatch then
		return
	end
	local c = current
	Net.E("Interact"):FireServer(c.action, c.target, true)
	if not c.instant then
		holding = c
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and c.pos then
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(c.pos.X, root.Position.Y, c.pos.Z))
		end
	end
end

local function interactUp()
	if holding then
		Net.E("Interact"):FireServer(holding.action, nil, false)
		holding = nil
	end
end

local function sendStance(force)
	local s = sprintKey or sprintToggle
	local c = crouchKey or crouchToggle
	local t = os.clock()
	if force or s ~= lastSent.s or c ~= lastSent.c or t - lastSendT > 1 then
		lastSent.s, lastSent.c, lastSendT = s, c, t
		Net.E("SetStance"):FireServer(s, c)
	end
end

local function toggleEmoteBar()
	if emoteBar then
		emoteBar:Destroy()
		emoteBar = nil
		return
	end
	local p = S.profile
	if not p then
		return
	end
	emoteBar = UI.frame(UI.root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Size = UDim2.fromOffset(0, 54), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 50 })
	UI.corner(emoteBar, 27)
	UI.stroke(emoteBar, C.line, 1.5)
	UI.pad(emoteBar, 8)
	UI.list(emoteBar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local n = 0
	for _, id in ipairs(Config.AnimationOrder) do
		local a = Config.Animations[id]
		if a.kind == "emote" and p.owned[id] then
			n += 1
			UI.button(emoteBar, a.name, function()
				Net.E("PlayEmote"):FireServer(id)
				toggleEmoteBar()
			end, { dim = UDim2.fromOffset(120, 36), size = 14 })
		end
	end
	if n == 0 then
		UI.label(emoteBar, "Эмоции покупаются в магазине", 15, C.dim, { Size = UDim2.fromOffset(260, 36), TextXAlignment = Enum.TextXAlignment.Center })
	end
	UI.button(emoteBar, "Стоп", function()
		Net.E("PlayEmote"):FireServer("")
		toggleEmoteBar()
	end, { dim = UDim2.fromOffset(70, 36), size = 14, style = "dark" })
end

--// Перепрыгивание окна (клиент владеет физикой персонажа)
local function doVault(fromCF, toCF, dur)
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not root or not root:IsA("BasePart") then
		return
	end
	local saved = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			saved[d] = d.CanCollide
			d.CanCollide = false
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / dur, 0, 1)
		local cf = fromCF:Lerp(toCF, a) + Vector3.new(0, math.sin(a * math.pi) * 3.0, 0)
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		if a >= 1 then
			conn:Disconnect()
			for p, v in pairs(saved) do
				if p.Parent then
					p.CanCollide = v
				end
			end
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
	end)
end

function Controls.OnMatchStart()
	sprintKey, sprintToggle, crouchKey, crouchToggle = false, false, false, false
	holding = nil
	lastSent = { s = false, c = false }
	if emoteBar then
		toggleEmoteBar()
	end
end

function Controls.Init()
	UI.on("channelEnd", function()
		holding = nil
	end)
	Net.E("Vault").OnClientEvent:Connect(doVault)

	UserInputService.InputBegan:Connect(function(i, gpe)
		local kc = i.KeyCode
		if gpe then
			return
		end
		if kc == Enum.KeyCode.G then
			toggleEmoteBar()
			return
		end
		if not S.inMatch then
			return
		end
		local settings = S.profile and S.profile.settings or {}
		if kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.ButtonL3 then
			if settings.sprintToggle then
				sprintToggle = not sprintToggle
			else
				sprintKey = true
			end
		elseif kc == Enum.KeyCode.C or kc == Enum.KeyCode.LeftControl or kc == Enum.KeyCode.ButtonB then
			crouchKey = true
		elseif kc == Enum.KeyCode.E or kc == Enum.KeyCode.ButtonA then
			interactDown()
		elseif kc == Enum.KeyCode.Q or kc == Enum.KeyCode.ButtonX then
			Net.E("Ability"):FireServer()
		elseif (i.UserInputType == Enum.UserInputType.MouseButton1 or kc == Enum.KeyCode.F or kc == Enum.KeyCode.ButtonR2) and S.role == "Killer" then
			Net.E("Attack"):FireServer()
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		local kc = i.KeyCode
		if kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.ButtonL3 then
			sprintKey = false
		elseif kc == Enum.KeyCode.C or kc == Enum.KeyCode.LeftControl or kc == Enum.KeyCode.ButtonB then
			crouchKey = false
		elseif kc == Enum.KeyCode.E or kc == Enum.KeyCode.ButtonA then
			interactUp()
		end
	end)

	-- мобильные / экранные кнопки
	local b = HUD.buttons
	HUD.bindHold(b.interact, interactDown, interactUp)
	HUD.bindHold(b.ability, function()
		if S.inMatch then
			Net.E("Ability"):FireServer()
		end
	end, function() end)
	HUD.bindHold(b.attack, function()
		if S.inMatch and S.role == "Killer" then
			Net.E("Attack"):FireServer()
		end
	end, function() end)
	HUD.bindHold(b.sprint, function()
		sprintToggle = not sprintToggle
		b.sprint.BackgroundColor3 = sprintToggle and C.bloodDark or C.panel
	end, function() end)
	HUD.bindHold(b.crouch, function()
		crouchToggle = not crouchToggle
		b.crouch.BackgroundColor3 = crouchToggle and C.bloodDark or C.panel
	end, function() end)
	HUD.bindHold(b.emote, toggleEmoteBar, function() end)

	RunService.Heartbeat:Connect(function(dt)
		if not S.inMatch then
			return
		end
		scanT += dt
		if scanT >= 0.08 then
			scanT = 0
			setPrompt(scan())
		end
		local char = lp.Character
		local st = char and char:GetAttribute("State")
		if st == "Dead" or st == "Escaped" then
			sprintToggle, crouchToggle = false, false
		end
		sendStance(false)
	end)
end

return Controls
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX37">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/HUD — игровой интерфейс матча
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local lp = Players.LocalPlayer
local C = UI.C
local S = UI.S
local HUD: any = { buttons = {}, visible = false }

local root, timerLbl, genLbl, gateLbl, listFrame, stateLbl, staminaFill, staminaBar, abilityBtn, abilityCd, promptPill, promptLbl
local progFrame, progFill, progLbl, vign, flashFrame, blindFrame, intro, skillFrame, specBar, specLbl
local rows = {}
local sc = nil
local specIndex = 1

local function now()
	return workspace:GetServerTimeNow()
end

local function stateText(st, role)
	local map = {
		Healthy = { "Здоров", C.good }, Injured = { "Ранен", C.warn }, Downed = { "Повержен", C.blood }, Carried = { "Вас несут", C.blood },
		Hooked = { "На крюке", C.blood }, Hiding = { "В укрытии", Color3.fromRGB(150, 150, 255) }, Dead = { "Погиб", C.dim }, Escaped = { "Сбежал", C.good },
		Idle = { "Охота", C.blood },
	}
	local m = map[st] or { st or "", C.text }
	return m[1], m[2]
end

local function findKiller()
	for _, m in ipairs(CollectionService:GetTagged("HFChar")) do
		if m:GetAttribute("Role") == "Killer" and m:GetAttribute("State") ~= nil then
			return m
		end
	end
	return nil
end

--// ---------------------------------------------------------------- ПОСТРОЕНИЕ
local function circleButton(parent, text, key, size, color)
	local b = UI.make("TextButton", {
		BackgroundColor3 = color or C.panel, Size = UDim2.fromOffset(size, size), Text = "", AutoButtonColor = false, BorderSizePixel = 0, Active = true,
	}, parent)
	UI.corner(b, size // 2)
	UI.stroke(b, C.line, 2)
	UI.label(b, text, size >= 80 and 17 or 14, C.text, { Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })
	if key and not UI.mobile then
		local k = UI.label(b, key, 13, C.gold, { Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })
		k.ZIndex = 3
	end
	return b
end

function HUD.bindHold(b, down, up)
	b.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			down()
			UI.tween(b, { BackgroundColor3 = C.bloodDark }, 0.08)
			local e
			e = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					e:Disconnect()
					up()
					UI.tween(b, { BackgroundColor3 = C.panel }, 0.15)
				end
			end)
		end
	end)
end

function HUD.Init()
	root = UI.frame(UI.root, { Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 3 })
	-- виньетка (красные края)
	vign = UI.frame(root, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1 })
	vign:SetAttribute("a", 1)
	local function edge(pos, size, rot)
		local f = UI.frame(vign, { BackgroundColor3 = Color3.fromRGB(150, 0, 20), Position = pos, Size = size, BackgroundTransparency = 1 })
		f.Active = false
		UI.make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Rotation = rot }, f)
		return f
	end
	local edges = { edge(UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 160), 90), edge(UDim2.new(0, 0, 1, -160), UDim2.new(1, 0, 0, 160), -90), edge(UDim2.fromScale(0, 0), UDim2.new(0, 220, 1, 0), 0), edge(UDim2.new(1, -220, 0, 0), UDim2.new(0, 220, 1, 0), 180) }
	vign:SetAttribute("n", #edges)
	flashFrame = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(180, 0, 20), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	blindFrame = UI.frame(root, { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 30 })

	-- верхняя панель
	local top = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(300, 74), ZIndex = 4 })
	UI.corner(top, 12)
	UI.stroke(top, C.line, 1.5)
	timerLbl = UI.label(top, "10:00", 38, C.text, { Font = UI.fontTitle, Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 2), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	genLbl = UI.label(top, "Генераторы 0/5", 16, C.warn, { Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.fromOffset(12, 46), Font = UI.fontBold, TextWrapped = false })
	gateLbl = UI.label(top, "Ворота: закрыты", 14, C.dim, { Size = UDim2.new(0.45, -12, 0, 22), Position = UDim2.new(0.55, 0, 0, 46), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })

	-- список игроков
	listFrame = UI.frame(root, { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 96), Size = UDim2.fromOffset(250, 220), ZIndex = 4 })
	UI.list(listFrame, Enum.FillDirection.Vertical, 6)

	-- состояние и выносливость
	local sFrame = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Size = UDim2.fromOffset(300, 64), ZIndex = 4 })
	UI.corner(sFrame, 12)
	UI.stroke(sFrame, C.line, 1.5)
	stateLbl = UI.label(sFrame, "Здоров", 20, C.good, { Position = UDim2.fromOffset(14, 4), Size = UDim2.new(1, -28, 0, 28), Font = UI.fontBold, TextWrapped = false })
	staminaBar = UI.frame(sFrame, { BackgroundColor3 = Color3.fromRGB(8, 8, 12), Position = UDim2.fromOffset(14, 40), Size = UDim2.new(1, -28, 0, 10) })
	UI.corner(staminaBar, 5)
	staminaFill = UI.frame(staminaBar, { BackgroundColor3 = Color3.fromRGB(80, 180, 255), Size = UDim2.fromScale(1, 1) })
	UI.corner(staminaFill, 5)

	-- подсказка взаимодействия
	promptPill = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.15, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Size = UDim2.fromOffset(0, 44), AutomaticSize = Enum.AutomaticSize.X, Visible = false, ZIndex = 5 })
	UI.corner(promptPill, 22)
	UI.stroke(promptPill, C.gold, 1.5)
	promptLbl = UI.label(promptPill, "", 19, C.text, { Size = UDim2.fromOffset(0, 44), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, Font = UI.fontBold })
	UI.pad(promptLbl, 16)
	progFrame = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(8, 8, 12), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -112), Size = UDim2.fromOffset(300, 16), Visible = false, ZIndex = 5 })
	UI.corner(progFrame, 8)
	UI.stroke(progFrame, C.line, 1.5)
	progFill = UI.frame(progFrame, { BackgroundColor3 = C.gold, Size = UDim2.fromScale(0, 1) })
	UI.corner(progFill, 8)
	progLbl = UI.label(progFrame, "", 14, C.text, { Position = UDim2.fromOffset(0, -22), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })

	-- кнопки справа
	local btns = UI.frame(root, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(300, 260), ZIndex = 5 })
	local isM = UI.mobile
	local big = isM and 96 or 84
	local small = isM and 74 or 64
	HUD.buttons.interact = circleButton(btns, "ДЕЙСТВИЕ", "E", big, Color3.fromRGB(34, 26, 30))
	HUD.buttons.interact.AnchorPoint = Vector2.new(1, 1)
	HUD.buttons.interact.Position = UDim2.new(1, 0, 1, 0)
	abilityBtn = circleButton(btns, "СПОСОБНОСТЬ", "Q", small, C.panel)
	abilityBtn.AnchorPoint = Vector2.new(1, 1)
	abilityBtn.Position = UDim2.new(1, -big - 10, 1, 0)
	HUD.buttons.ability = abilityBtn
	abilityCd = UI.label(abilityBtn, "", 24, C.text, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold, ZIndex = 6 })
	HUD.buttons.attack = circleButton(btns, "АТАКА", "ЛКМ", big, Color3.fromRGB(70, 20, 28))
	HUD.buttons.attack.AnchorPoint = Vector2.new(1, 1)
	HUD.buttons.attack.Position = UDim2.new(1, 0, 1, -big - 10)
	HUD.buttons.sprint = circleButton(btns, "БЕГ", "Shift", small, C.panel)
	HUD.buttons.sprint.AnchorPoint = Vector2.new(1, 1)
	HUD.buttons.sprint.Position = UDim2.new(1, -big - 10, 1, -small - 10)
	HUD.buttons.crouch = circleButton(btns, "ПРИСЕСТЬ", "C", small, C.panel)
	HUD.buttons.crouch.AnchorPoint = Vector2.new(1, 1)
	HUD.buttons.crouch.Position = UDim2.new(1, -big - small - 20, 1, 0)
	HUD.buttons.emote = circleButton(btns, "ЭМОЦИЯ", "G", small - 8, C.panel)
	HUD.buttons.emote.AnchorPoint = Vector2.new(1, 1)
	HUD.buttons.emote.Position = UDim2.new(1, -big - small - 20, 1, -small - 10)
	if not isM then
		HUD.buttons.sprint.Visible = false
		HUD.buttons.crouch.Visible = false
		HUD.buttons.emote.Visible = false
		HUD.buttons.interact.Visible = false
		HUD.buttons.attack.Visible = false
		abilityBtn.Position = UDim2.new(1, 0, 1, 0)
	end

	-- проверка навыка
	skillFrame = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(420, 96), Visible = false, ZIndex = 20 })
	UI.corner(skillFrame, 14)
	UI.stroke(skillFrame, C.gold, 2)
	UI.label(skillFrame, UI.mobile and "ПРОВЕРКА! Нажмите сюда" or "ПРОВЕРКА! Нажмите ПРОБЕЛ", 16, C.gold, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })
	local track = UI.frame(skillFrame, { BackgroundColor3 = Color3.fromRGB(40, 40, 52), Position = UDim2.fromOffset(30, 44), Size = UDim2.fromOffset(360, 28), Name = "Track" })
	UI.corner(track, 8)
	UI.frame(track, { BackgroundColor3 = Color3.fromRGB(240, 220, 90), Name = "Zone", Size = UDim2.fromScale(0.2, 1) })
	UI.frame(track, { BackgroundColor3 = Color3.fromRGB(90, 255, 130), Name = "Great", Size = UDim2.fromScale(0.05, 1), ZIndex = 2 })
	UI.frame(track, { BackgroundColor3 = Color3.new(1, 1, 1), Name = "Needle", Size = UDim2.new(0, 5, 1, 8), Position = UDim2.new(0, 0, 0, -4), ZIndex = 3 })
	local tap = UI.make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 25 }, skillFrame)
	tap.Activated:Connect(function()
		HUD.PressSkillCheck()
	end)

	-- наблюдение
	specBar = UI.frame(root, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.2, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.fromOffset(380, 48), Visible = false, ZIndex = 6 })
	UI.corner(specBar, 24)
	UI.stroke(specBar, C.line, 1.5)
	specLbl = UI.label(specBar, "", 17, C.text, { Position = UDim2.fromOffset(60, 0), Size = UDim2.new(1, -120, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })
	local pb = UI.button(specBar, "◀", function()
		specIndex -= 1
	end, { dim = UDim2.fromOffset(44, 38), size = 18, style = "dark" })
	pb.Position = UDim2.fromOffset(6, 5)
	local nb = UI.button(specBar, "▶", function()
		specIndex += 1
	end, { dim = UDim2.fromOffset(44, 38), size = 18, style = "dark" })
	nb.Position = UDim2.new(1, -50, 0, 5)

	-- вступительный экран
	intro = UI.frame(root, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 35 })

	-- Реакция на события сервера
	Net.E("MatchState").OnClientEvent:Connect(function(st)
		HUD.OnState(st)
	end)
	Net.E("InteractUpdate").OnClientEvent:Connect(function(d)
		if d then
			progFrame.Visible = true
			progLbl.Text = d.label
			UI.tween(progFill, { Size = UDim2.fromScale(math.clamp(d.prog, 0, 1), 1) }, 0.1)
		else
			progFrame.Visible = false
			progFill.Size = UDim2.fromScale(0, 1)
			UI.emit("channelEnd")
		end
	end)
	Net.E("SkillCheck").OnClientEvent:Connect(function(d)
		HUD.StartSkillCheck(d)
	end)
	Net.E("AbilityFx").OnClientEvent:Connect(function(d)
		if d.type == "Blind" then
			blindFrame.BackgroundTransparency = 0
			UI.tween(blindFrame, { BackgroundTransparency = 1 }, d.dur or 2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		end
	end)
	UserInputService.InputBegan:Connect(function(i, gpe)
		if i.KeyCode == Enum.KeyCode.Space and sc then
			HUD.PressSkillCheck()
		elseif not gpe and HUD.specMode then
			if i.KeyCode == Enum.KeyCode.Left then
				specIndex -= 1
			elseif i.KeyCode == Enum.KeyCode.Right then
				specIndex += 1
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		HUD.Update(dt)
	end)
end

--// ---------------------------------------------------------------- ПОКАЗ / СОСТОЯНИЯ
function HUD.Show(info)
	root.Visible = true
	HUD.visible = true
	local isKiller = info.role == "Killer"
	HUD.buttons.attack.Visible = isKiller and (UI.mobile or true)
	HUD.buttons.sprint.Visible = UI.mobile and not isKiller
	HUD.buttons.crouch.Visible = UI.mobile and not isKiller
	HUD.buttons.interact.Visible = UI.mobile
	HUD.buttons.emote.Visible = UI.mobile and not isKiller
	HUD.buttons.attack.Visible = isKiller and UI.mobile
	local staminaVis = not isKiller
	staminaBar.Visible = staminaVis
	for _, c in ipairs(listFrame:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	rows = {}
	-- вступление
	for _, c in ipairs(intro:GetChildren()) do
		c:Destroy()
	end
	intro.Visible = true
	intro.BackgroundTransparency = 0.15
	local col = isKiller and C.blood or C.gold
	UI.label(intro, isKiller and "ВЫ — УБИЙЦА" or "ВЫ — ВЫЖИВШИЙ", 76, col, { Font = UI.fontTitle, Size = UDim2.new(1, 0, 0, 90), Position = UDim2.fromScale(0, 0.22), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	UI.label(intro, info.mapName, 30, C.text, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromScale(0, 0.38), TextXAlignment = Enum.TextXAlignment.Center, Font = UI.fontBold })
	local goal = isKiller and "Найдите выживших, ранивших и повесьте на крюки. Не дайте им починить генераторы." or ("Почините " .. info.need .. " генераторов, откройте ворота и сбегите. Убийца — " .. info.killer.n .. ".")
	UI.label(intro, goal, 20, C.dim, { Size = UDim2.fromOffset(700, 60), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.48), TextXAlignment = Enum.TextXAlignment.Center })
	local cd = UI.label(intro, "", 60, C.text, { Font = UI.fontTitle, Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromScale(0, 0.62), TextXAlignment = Enum.TextXAlignment.Center })
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < info.intro do
			cd.Text = tostring(math.ceil(info.intro - (os.clock() - t0)))
			task.wait(0.1)
		end
		UI.tween(intro, { BackgroundTransparency = 1 }, 0.6)
		for _, c in ipairs(intro:GetChildren()) do
			if c:IsA("TextLabel") then
				UI.tween(c, { TextTransparency = 1 }, 0.5)
			end
		end
		task.wait(0.7)
		intro.Visible = false
	end)
	abilityBtn.Visible = true
	HUD.specMode = false
	specBar.Visible = false
end

function HUD.Hide()
	root.Visible = false
	HUD.visible = false
	HUD.specMode = false
	sc = nil
	skillFrame.Visible = false
	promptPill.Visible = false
	progFrame.Visible = false
	intro.Visible = false
	specBar.Visible = false
	workspace.CurrentCamera.CameraSubject = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") or nil
end

function HUD.SetPrompt(text)
	if text then
		promptPill.Visible = true
		promptLbl.Text = UI.mobile and text or ("[E]  " .. text)
		HUD.buttons.interact.Active = true
	else
		promptPill.Visible = false
	end
end

function HUD.OnState(st)
	S.match = S.match or {}
	S.match.st = st
	genLbl.Text = string.format("Генераторы %d/%d", st.gens, st.need)
	genLbl.TextColor3 = st.gens >= st.need and C.good or C.warn
	local open, powered = 0, 0
	for _, g in ipairs(st.gates) do
		if g == 2 then
			open += 1
		elseif g == 1 then
			powered += 1
		end
	end
	if open > 0 then
		gateLbl.Text = "Ворота ОТКРЫТЫ"
		gateLbl.TextColor3 = C.good
	elseif st.powered then
		gateLbl.Text = "Ворота: под током"
		gateLbl.TextColor3 = C.warn
	else
		gateLbl.Text = "Ворота: закрыты"
		gateLbl.TextColor3 = C.dim
	end
	for i, s in ipairs(st.list) do
		local r = rows[i]
		if not r then
			local f = UI.frame(listFrame, { BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.25, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = i })
			UI.corner(f, 10)
			local stripe = UI.frame(f, { BackgroundColor3 = C.good, Size = UDim2.new(0, 4, 1, 0) })
			UI.corner(stripe, 2)
			local n = UI.label(f, "", 16, C.text, { Position = UDim2.fromOffset(14, 3), Size = UDim2.new(1, -20, 0, 22), Font = UI.fontBold, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			local sl = UI.label(f, "", 13, C.dim, { Position = UDim2.fromOffset(14, 25), Size = UDim2.new(1, -20, 0, 18), TextWrapped = false })
			r = { f = f, stripe = stripe, n = n, s = sl }
			rows[i] = r
		end
		local txt, col = stateText(s.s)
		r.n.Text = (Config.Survivors[s.c] and Config.Survivors[s.c].name or "") .. " · " .. s.n
		r.s.Text = txt .. (s.h > 0 and ("   " .. string.rep("☠", s.h)) or "")
		r.s.TextColor3 = col
		r.stripe.BackgroundColor3 = col
		r.f.BackgroundTransparency = (s.s == "Dead" or s.s == "Escaped") and 0.7 or 0.25
	end
end

--// ---------------------------------------------------------------- ПРОВЕРКА НАВЫКА
function HUD.StartSkillCheck(d)
	sc = { d = d, t0 = os.clock(), pressed = false }
	local track = skillFrame.Track
	track.Zone.Position = UDim2.fromScale(d.zone / 360, 0)
	track.Zone.Size = UDim2.fromScale(d.width / 360, 1)
	track.Great.Size = UDim2.fromScale(d.great / 360, 1)
	track.Great.Position = UDim2.fromScale((d.zone + d.width - d.great) / 360, 0)
	skillFrame.Visible = true
	UI.play("hover", 0.4, 1.6)
end

function HUD.PressSkillCheck()
	if not sc or sc.pressed then
		return
	end
	sc.pressed = true
	local d = sc.d
	local el = os.clock() - sc.t0 - d.delay
	local angle = math.clamp(el * d.speed, 0, 360)
	Net.E("SkillCheckResult"):FireServer(d.id, angle)
	local ok = angle >= d.zone and angle <= d.zone + d.width
	UI.play(ok and "buy" or "error", 0.5)
	local f = skillFrame
	f.UIStroke.Color = ok and C.good or C.blood
	task.delay(0.35, function()
		f.Visible = false
		f.UIStroke.Color = C.gold
		sc = nil
	end)
end

--// ---------------------------------------------------------------- ПОКАДРОВОЕ ОБНОВЛЕНИЕ
local lastState = nil
local shakeT = 0
local killerCache, killerT = nil, 0

function HUD.Update(dt)
	if not HUD.visible or not S.inMatch then
		return
	end
	local char = lp.Character
	local m = S.match
	if m and m.endTime then
		timerLbl.Text = UI.formatTime(m.endTime - now())
		timerLbl.TextColor3 = (m.endTime - now()) < 60 and C.blood or C.text
	end
	if sc then
		local el = os.clock() - sc.t0 - sc.d.delay
		local track = skillFrame.Track
		local a = math.clamp(el, 0, 10) * sc.d.speed
		track.Needle.Position = UDim2.new(math.clamp(a / 360, 0, 1), -2, 0, -4)
		if el < 0 then
			track.Needle.Position = UDim2.new(0, -2, 0, -4)
		end
		if a >= 360 and not sc.pressed then
			sc.pressed = true
			skillFrame.Visible = false
			sc = nil
		end
	end
	if not char then
		return
	end
	local st = char:GetAttribute("State") or "Healthy"
	local txt, col = stateText(st)
	stateLbl.Text = txt
	stateLbl.TextColor3 = col
	if st == "Hooked" then
		stateLbl.Text = "На крюке: " .. (char:GetAttribute("HookLeft") or 0) .. " с"
	elseif st == "Downed" then
		stateLbl.Text = "Повержен: " .. (char:GetAttribute("Bleed") or 0) .. " с"
	end
	local stam = char:GetAttribute("Stamina") or 100
	local mx = char:GetAttribute("MaxStamina") or 100
	staminaFill.Size = staminaFill.Size:Lerp(UDim2.fromScale(math.clamp(stam / mx, 0, 1), 1), math.min(1, dt * 10))
	staminaFill.BackgroundColor3 = (stam / mx) < 0.25 and C.blood or Color3.fromRGB(80, 180, 255)
	-- способность
	local ready = (char:GetAttribute("AbReady") or 0) - now()
	local cfg = Config.GetChar(char:GetAttribute("CharId") or "")
	if cfg then
		abilityBtn.BackgroundColor3 = ready > 0 and Color3.fromRGB(16, 16, 20) or C.panel
		abilityCd.Text = ready > 0 and tostring(math.ceil(ready)) or ""
		local lbl = abilityBtn:FindFirstChildWhichIsA("TextLabel")
		if lbl and lbl.Text ~= cfg.ability.name and lbl ~= abilityCd then
			lbl.Text = cfg.ability.name
		end
	end
	-- вспышки при смене состояния
	if lastState ~= st then
		if lastState and (st == "Injured" or st == "Downed" or st == "Hooked") then
			flashFrame.BackgroundTransparency = 0.45
			UI.tween(flashFrame, { BackgroundTransparency = 1 }, 0.7)
			shakeT = 0.45
		end
		lastState = st
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local target = Vector3.zero
		if char:GetAttribute("Crouch") then
			target = Vector3.new(0, -0.9, 0)
		elseif st == "Downed" then
			target = Vector3.new(0, -1.8, 0)
		end
		if shakeT > 0 and S.profile and S.profile.settings.shake then
			shakeT -= dt
			target = target + Vector3.new((math.random() - 0.5) * shakeT, (math.random() - 0.5) * shakeT, 0)
		end
		hum.CameraOffset = hum.CameraOffset:Lerp(target, math.min(1, dt * 8))
	end
	-- радиус страха
	killerT += dt
	if killerT > 0.5 then
		killerT = 0
		killerCache = findKiller()
	end
	local intensity = 0
	if S.role == "Survivor" and killerCache and killerCache.Parent and char:FindFirstChild("HumanoidRootPart") and not killerCache:GetAttribute("Veil") then
		local kr = killerCache:FindFirstChild("HumanoidRootPart")
		if kr then
			local terror = (Config.Killers[killerCache:GetAttribute("CharId") or ""] or { terror = 38 }).terror
			local d = (kr.Position - char.HumanoidRootPart.Position).Magnitude
			intensity = math.clamp(1 - d / terror, 0, 1)
		end
		if char:GetAttribute("Chased") then
			intensity = math.max(intensity, 0.85)
		end
	elseif S.role == "Killer" then
		intensity = 0
	end
	S.terror = intensity
	S.chased = char:GetAttribute("Chased") or false
	local alpha = 1 - intensity * 0.65
	if st == "Injured" then
		alpha = math.min(alpha, 0.8)
	end
	local pulse = 0.04 * math.sin(os.clock() * (4 + intensity * 8))
	for _, e in ipairs(vign:GetChildren()) do
		if e:IsA("Frame") then
			e.BackgroundTransparency = math.clamp(alpha + pulse, 0, 1)
		end
	end
	-- наблюдение
	local spectating = (st == "Dead" or st == "Escaped")
	if spectating then
		HUD.specMode = true
		specBar.Visible = true
		local list = {}
		for _, mdl in ipairs(CollectionService:GetTagged("HFChar")) do
			local s = mdl:GetAttribute("State")
			if mdl ~= char and s and s ~= "Dead" and s ~= "Escaped" then
				table.insert(list, mdl)
			end
		end
		if #list > 0 then
			specIndex = ((specIndex - 1) % #list) + 1
			local mdl = list[specIndex]
			local h = mdl:FindFirstChildOfClass("Humanoid")
			if h and workspace.CurrentCamera.CameraSubject ~= h then
				workspace.CurrentCamera.CameraSubject = h
			end
			specLbl.Text = "Наблюдение: " .. mdl.Name
		else
			specLbl.Text = "Нет живых участников"
		end
		promptPill.Visible = false
	elseif HUD.specMode then
		HUD.specMode = false
		specBar.Visible = false
	end
end

return HUD
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX38">
          <Properties>
            <string name="Name">Menus</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/Menus — главное меню, поиск матча, персонажи, магазин, коллекция, настройки, итоги
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))

local C = UI.C
local S = UI.S
local Menus = {}

local function prof()
	return S.profile
end

local CATS = {
	{ id = "survivor", name = "Выжившие" },
	{ id = "killer", name = "Убийцы" },
	{ id = "skin", name = "Скины" },
	{ id = "accessory", name = "Одежда и аксессуары" },
	{ id = "animation", name = "Анимации" },
	{ id = "effect", name = "Эффекты" },
}

local function orderIndex(list, id)
	for i, v in ipairs(list) do
		if v == id then
			return i
		end
	end
	return 99
end

local function itemsOf(cat)
	local list = {}
	for _, it in pairs(Config.Items) do
		if it.cat == cat then
			table.insert(list, it)
		end
	end
	local function key(it)
		if it.cat == "survivor" then
			return orderIndex(Config.SurvivorOrder, it.id)
		elseif it.cat == "killer" then
			return orderIndex(Config.KillerOrder, it.id)
		elseif it.cat == "skin" then
			local ci = orderIndex(Config.SurvivorOrder, it.char)
			if ci == 99 then
				ci = 10 + orderIndex(Config.KillerOrder, it.char)
			end
			return ci * 100 + Config.Rarity[it.rarity].order
		elseif it.cat == "accessory" then
			return orderIndex(Config.AccSlots, it.slot) * 10000 + it.price
		elseif it.cat == "animation" then
			return orderIndex(Config.AnimationOrder, it.id)
		else
			return orderIndex(Config.EffectOrder, it.id)
		end
	end
	table.sort(list, function(a, b)
		return key(a) < key(b)
	end)
	return list
end

local function isOwned(it)
	return prof() and prof().owned[it.id] == true
end

local function isEquipped(it)
	local eq = prof().equipped
	if it.cat == "survivor" then
		return eq.survivor == it.id
	elseif it.cat == "killer" then
		return eq.killer == it.id
	elseif it.cat == "skin" then
		return eq.skins[it.char] == it.id
	elseif it.cat == "accessory" then
		return eq.acc[it.slot] == it.id
	elseif it.cat == "animation" then
		return eq[it.kind] == it.id
	elseif it.cat == "effect" then
		return eq.effect == it.id
	end
	return false
end

local function equipCat(it)
	if it.cat == "animation" then
		return it.kind
	end
	return it.cat
end

local function copyMap(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = v
	end
	return c
end

local function previewSpec(it)
	local eq = prof().equipped
	if it.cat == "survivor" or it.cat == "killer" then
		return { char = it.id, skin = eq.skins[it.id], acc = it.cat == "survivor" and eq.acc or nil, effect = eq.effect, style = eq.style }
	elseif it.cat == "skin" then
		return { char = it.char, skin = it.id, acc = Config.Survivors[it.char] and eq.acc or nil, effect = eq.effect }
	end
	local base = eq.survivor
	local spec = { char = base, skin = eq.skins[base], acc = eq.acc, effect = eq.effect, style = eq.style }
	if it.cat == "accessory" then
		spec.acc = copyMap(eq.acc)
		spec.acc[it.slot] = it.id
	elseif it.cat == "animation" then
		if it.kind == "emote" then
			spec.emote = it.id
		else
			spec.style = it.id
		end
	elseif it.cat == "effect" then
		spec.effect = it.id
	end
	return spec
end

local function doPurchase(it)
	local ok, msg = Net.F("Purchase"):InvokeServer(it.id)
	UI.toast(msg or "", ok and "good" or "bad")
	UI.play(ok and "buy" or "error", 0.6)
	return ok
end

local function doEquip(it, unequip)
	local id = unequip and "" or it.id
	local ok, msg = Net.F("Equip"):InvokeServer(equipCat(it), id, it.slot)
	if not ok then
		UI.toast(msg or "Ошибка", "bad")
	else
		UI.play("click", 0.4)
	end
	return ok
end

--// ------------------------------------------------------------------ ВЕРХНЯЯ ПАНЕЛЬ
local topBar, shardsLbl, levelLbl, xpFill, onlineLbl
local function buildTopBar()
	topBar = UI.frame(UI.root, { Name = "TopBar", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), ZIndex = 5 })
	local right = UI.frame(topBar, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 12), Size = UDim2.fromOffset(560, 40) })
	UI.list(right, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local _, o = UI.pill(right, "Игроков: 1 · В очереди: 0", C.panel, 36)
	onlineLbl = o
	local lvl = UI.frame(right, { BackgroundColor3 = C.panel, Size = UDim2.fromOffset(160, 36), LayoutOrder = 2 })
	UI.corner(lvl, 18)
	UI.stroke(lvl, C.line, 1.2)
	levelLbl = UI.label(lvl, "Ур. 1", 16, C.text, { Position = UDim2.fromOffset(12, 2), Size = UDim2.fromOffset(60, 20), Font = UI.fontBold, TextWrapped = false })
	local bar = UI.frame(lvl, { BackgroundColor3 = Color3.fromRGB(8, 8, 12), Position = UDim2.fromOffset(12, 24), Size = UDim2.fromOffset(136, 6) })
	UI.corner(bar, 3)
	xpFill = UI.frame(bar, { BackgroundColor3 = C.blood, Size = UDim2.fromScale(0, 1) })
	UI.corner(xpFill, 3)
	local shard = UI.frame(right, { BackgroundColor3 = C.panel, Size = UDim2.fromOffset(140, 36), LayoutOrder = 3 })
	UI.corner(shard, 18)
	UI.stroke(shard, C.gold, 1.2, 0.3)
	shardsLbl = UI.label(shard, "◆ 0", 18, C.gold, { Size = UDim2.fromScale(1, 1), Font = UI.fontBold, TextXAlignment = Enum.TextXAlignment.Center })
end

function Menus.RefreshTop()
	local p = prof()
	if not p then
		return
	end
	shardsLbl.Text = "◆ " .. tostring(p.shards)
	levelLbl.Text = "Ур. " .. p.level
	UI.tween(xpFill, { Size = UDim2.fromScale(math.clamp(p.xp / Config.XpForLevel(p.level), 0, 1), 1) }, 0.4)
end

--// ------------------------------------------------------------------ СЕТКА ПРЕДМЕТОВ (магазин / коллекция)
local function buildItemModal(title, mode)
	local m = UI.modal(title, 1180, 660)
	local body = m.body
	local tab = "survivor"
	local selected = nil
	local preview = UI.newPreview(body, { Position = UDim2.fromOffset(0, 50), Size = UDim2.fromOffset(330, 520) })
	local nameLbl = UI.label(body, "", 22, C.text, { Position = UDim2.fromOffset(0, 576), Size = UDim2.fromOffset(330, 26), Font = UI.fontBold })
	local tabsRow = UI.frame(body, { BackgroundTransparency = 1, Position = UDim2.fromOffset(346, 0), Size = UDim2.new(1, -346, 0, 42) })
	UI.list(tabsRow, Enum.FillDirection.Horizontal, 8)
	local scroll = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(346, 52), Size = UDim2.new(1, -346, 1, -52),
		ScrollBarThickness = 5, ScrollBarImageColor3 = C.blood, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, body)
	UI.make("UIGridLayout", { CellSize = UDim2.fromOffset(204, 158), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	UI.pad(scroll, 4)
	local tabBtns = {}

	local function show(it)
		selected = it
		nameLbl.Text = it.name
		preview:Show(previewSpec(it))
	end

	local render
	local function card(it)
		local f = UI.frame(scroll, { BackgroundColor3 = C.panel2 })
		UI.corner(f, 10)
		local rc = UI.rarityColor(it.rarity)
		UI.stroke(f, rc, 1.6, selected and selected.id == it.id and 0 or 0.55)
		UI.frame(f, { BackgroundColor3 = rc, Size = UDim2.new(1, 0, 0, 4) })
		UI.label(f, it.name, 16, C.text, { Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 20), Font = UI.fontBold, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		local sub = Config.Rarity[it.rarity].name
		if it.cat == "skin" then
			sub = sub .. " · " .. Config.GetChar(it.char).name
		elseif it.cat == "accessory" then
			sub = sub .. " · " .. Config.AccSlotNames[it.slot]
		elseif it.cat == "animation" then
			sub = sub .. (it.kind == "emote" and " · Эмоция" or " · Стиль")
		end
		UI.label(f, sub, 12, rc, { Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 16), TextWrapped = false })
		UI.label(f, it.desc, 12, C.dim, { Position = UDim2.fromOffset(10, 46), Size = UDim2.new(1, -20, 0, 44), TextYAlignment = Enum.TextYAlignment.Top })
		local owned = isOwned(it)
		UI.label(f, owned and "✓ В коллекции" or ("◆ " .. it.price), 15, owned and C.good or C.gold, { Position = UDim2.fromOffset(10, 92), Size = UDim2.new(1, -20, 0, 18), Font = UI.fontBold })
		local view = UI.button(f, "Просмотр", function()
			show(it)
			render()
		end, { dim = UDim2.fromOffset(84, 30), size = 14, style = "dark" })
		view.Position = UDim2.fromOffset(10, 118)
		local act = UI.button(f, "", nil, { dim = UDim2.fromOffset(98, 30), size = 14 })
		act.Position = UDim2.fromOffset(96, 118)
		local function setAct()
			if mode == "shop" then
				if owned then
					UI.setButton(act, "Куплено", "ghost", true)
				else
					local canAfford = prof().shards >= it.price
					UI.setButton(act, "Купить", canAfford and "gold" or "ghost", false)
					act:SetAttribute("Style", canAfford and "gold" or "ghost")
				end
			else
				if isEquipped(it) then
					local removable = it.cat == "accessory" or it.cat == "animation" or it.cat == "effect"
					UI.setButton(act, removable and "Снять" or "Выбрано ✓", removable and "ghost" or "good", not removable)
				else
					UI.setButton(act, "Выбрать", "primary", false)
				end
			end
		end
		setAct()
		act.Activated:Connect(function()
			if act:GetAttribute("Disabled") then
				return
			end
			if mode == "shop" then
				if not owned then
					task.spawn(function()
						doPurchase(it)
					end)
				end
			else
				task.spawn(function()
					doEquip(it, isEquipped(it))
				end)
			end
		end)
		f.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				if selected ~= it then
					show(it)
				end
			end
		end)
		return f
	end

	function render()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for id, b in pairs(tabBtns) do
			UI.setButton(b, b.Text, id == tab and "primary" or "ghost", false)
		end
		local list = itemsOf(tab)
		local n = 0
		for _, it in ipairs(list) do
			if mode == "shop" or isOwned(it) then
				card(it)
				n += 1
			end
		end
		if n == 0 then
			UI.label(scroll, "Здесь пока пусто. Загляните в магазин!", 18, C.dim, { Size = UDim2.fromOffset(400, 40) })
		end
	end

	for _, c in ipairs(CATS) do
		local b = UI.button(tabsRow, c.name, function()
			tab = c.id
			selected = nil
			render()
			local list = itemsOf(tab)
			for _, it in ipairs(list) do
				if mode == "shop" or isOwned(it) then
					show(it)
					break
				end
			end
		end, { dim = UDim2.fromOffset(c.id == "accessory" and 188 or 112, 38), size = 14 })
		tabBtns[c.id] = b
	end

	m.onOpen = function()
		render()
		local list = itemsOf(tab)
		if not selected then
			show(list[1])
		else
			show(selected)
		end
	end
	m.render = function()
		if UI.currentModal == m then
			render()
			if selected then
				preview:Show(previewSpec(selected))
			end
		end
	end
	m.onClose = function()
		preview:Clear()
	end
	return m
end

--// ------------------------------------------------------------------ ПЕРСОНАЖИ И СКИНЫ
local function statBar(parent, label, v, max, color)
	local row = UI.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
	UI.label(row, label, 14, C.dim, { Size = UDim2.fromOffset(130, 22), TextWrapped = false })
	local bar = UI.frame(row, { BackgroundColor3 = Color3.fromRGB(8, 8, 12), Position = UDim2.fromOffset(136, 7), Size = UDim2.new(1, -140, 0, 8) })
	UI.corner(bar, 4)
	local fill = UI.frame(bar, { BackgroundColor3 = color or C.blood, Size = UDim2.fromScale(math.clamp(v / max, 0.05, 1), 1) })
	UI.corner(fill, 4)
end

local function buildCharacters()
	local m = UI.modal("Персонажи и скины", 1180, 660)
	local body = m.body
	local tab = "survivor"
	local selChar = "alex"
	local selSkin = nil
	local preview = UI.newPreview(body, { Position = UDim2.fromOffset(270, 0), Size = UDim2.fromOffset(360, 580) })
	local tabs = UI.frame(body, { BackgroundTransparency = 1, Size = UDim2.fromOffset(250, 40) })
	UI.list(tabs, Enum.FillDirection.Horizontal, 6)
	local listFrame = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 48), Size = UDim2.fromOffset(250, 532),
		ScrollBarThickness = 4, ScrollBarImageColor3 = C.blood, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, body)
	UI.list(listFrame, Enum.FillDirection.Vertical, 6)
	local info = UI.make("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(646, 0), Size = UDim2.new(1, -646, 1, 0),
		ScrollBarThickness = 4, ScrollBarImageColor3 = C.blood, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, body)
	UI.list(info, Enum.FillDirection.Vertical, 8)
	local tabBtns = {}

	local function currentSkin()
		return selSkin or prof().equipped.skins[selChar]
	end
	local function refreshPreview()
		local eq = prof().equipped
		local isSurv = Config.Survivors[selChar] ~= nil
		preview:Show({ char = selChar, skin = currentSkin(), acc = isSurv and eq.acc or nil, effect = eq.effect, style = isSurv and eq.style or nil })
	end

	local render
	local function renderInfo()
		for _, c in ipairs(info:GetChildren()) do
			if not c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
		local cfg = Config.GetChar(selChar)
		local isSurv = Config.Survivors[selChar] ~= nil
		local item = Config.Items[selChar]
		UI.label(info, string.upper(cfg.name), 40, C.text, { Font = UI.fontTitle, Size = UDim2.new(1, -8, 0, 44), TextWrapped = false })
		UI.label(info, cfg.title .. " · " .. Config.Rarity[cfg.rarity].name, 16, UI.rarityColor(cfg.rarity), { Size = UDim2.new(1, -8, 0, 20), Font = UI.fontBold })
		UI.label(info, cfg.desc, 14, C.dim, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		local stats = UI.frame(info, { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		UI.list(stats, Enum.FillDirection.Vertical, 2)
		if isSurv then
			statBar(stats, "Выносливость", cfg.stats.stamina, 120, Color3.fromRGB(80, 180, 255))
			statBar(stats, "Ремонт", cfg.stats.repair, 1.3, Color3.fromRGB(250, 190, 60))
			statBar(stats, "Лечение", cfg.stats.heal, 1.5, C.good)
			statBar(stats, "Скрытность", cfg.stats.crouch / cfg.stats.noise, 2.4, Color3.fromRGB(170, 120, 255))
			statBar(stats, "Стойкость", cfg.stats.hook * cfg.stats.bleed, 1.7, C.blood)
		else
			statBar(stats, "Скорость", cfg.speed, 16, Color3.fromRGB(80, 180, 255))
			statBar(stats, "Радиус страха", cfg.terror, 44, C.blood)
			statBar(stats, "Размер", cfg.scale, 1.3, Color3.fromRGB(170, 120, 255))
		end
		if isSurv then
			UI.label(info, "Пассивно: " .. cfg.passive, 14, C.text, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		else
			UI.label(info, "Стиль: " .. cfg.style, 14, C.text, { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		end
		local ab = UI.frame(info, { BackgroundColor3 = C.panel2, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		UI.corner(ab, 10)
		UI.stroke(ab, C.line, 1.2)
		UI.pad(ab, 10)
		UI.list(ab, Enum.FillDirection.Vertical, 2)
		UI.label(ab, "СПОСОБНОСТЬ [Q]: " .. cfg.ability.name .. "  (" .. cfg.ability.cd .. " с)", 15, C.gold, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = UI.fontBold })
		UI.label(ab, cfg.ability.desc, 14, C.text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		-- кнопка выбора/покупки персонажа
		local owned = isOwned(item)
		local equipped = isEquipped(item)
		local main = UI.button(info, "", function()
			task.spawn(function()
				if not owned then
					if doPurchase(item) then
						doEquip(item, false)
					end
				else
					doEquip(item, false)
				end
			end)
		end, { dim = UDim2.new(1, -8, 0, 44), size = 18 })
		if equipped then
			UI.setButton(main, "ВЫБРАН ✓", "good", true)
		elseif owned then
			UI.setButton(main, "ВЫБРАТЬ ПЕРСОНАЖА", "primary", false)
		else
			UI.setButton(main, "КУПИТЬ ◆ " .. item.price, prof().shards >= item.price and "gold" or "ghost", false)
		end
		UI.label(info, "СКИНЫ", 24, C.blood, { Font = UI.fontTitle, Size = UDim2.new(1, -8, 0, 30), TextWrapped = false })
		for _, sk in ipairs(Config.Skins[selChar]) do
			local it = Config.Items[sk.id]
			local row = UI.frame(info, { BackgroundColor3 = C.panel2, Size = UDim2.new(1, -8, 0, 58) })
			UI.corner(row, 8)
			local rc = UI.rarityColor(sk.rarity)
			UI.stroke(row, rc, 1.5, currentSkin() == sk.id and 0 or 0.6)
			UI.frame(row, { BackgroundColor3 = rc, Size = UDim2.new(0, 5, 1, 0) })
			UI.label(row, sk.name, 16, C.text, { Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -230, 0, 22), Font = UI.fontBold, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			UI.label(row, Config.Rarity[sk.rarity].name .. (sk.price > 0 and ("  ·  ◆ " .. sk.price) or ""), 12, rc, { Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -230, 0, 18), TextWrapped = false })
			local try = UI.button(row, "Примерить", function()
				selSkin = sk.id
				refreshPreview()
				renderInfo()
			end, { dim = UDim2.fromOffset(86, 34), size = 13, style = "dark" })
			try.AnchorPoint = Vector2.new(1, 0.5)
			try.Position = UDim2.new(1, -112, 0.5, 0)
			local skOwned = isOwned(it)
			local skEq = isEquipped(it)
			local act = UI.button(row, "", function()
				task.spawn(function()
					if not skOwned then
						if doPurchase(it) then
							doEquip(it, false)
						end
					else
						doEquip(it, false)
					end
				end)
			end, { dim = UDim2.fromOffset(98, 34), size = 13 })
			act.AnchorPoint = Vector2.new(1, 0.5)
			act.Position = UDim2.new(1, -8, 0.5, 0)
			if skEq then
				UI.setButton(act, "Надет ✓", "good", true)
			elseif skOwned then
				UI.setButton(act, "Надеть", "primary", false)
			else
				UI.setButton(act, "Купить", (prof().owned[selChar] and prof().shards >= sk.price) and "gold" or "ghost", false)
			end
		end
	end

	function render()
		for id, b in pairs(tabBtns) do
			UI.setButton(b, b.Text, id == tab and "primary" or "ghost", false)
		end
		for _, c in ipairs(listFrame:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local order = tab == "survivor" and Config.SurvivorOrder or Config.KillerOrder
		for _, id in ipairs(order) do
			local cfg = Config.GetChar(id)
			local it = Config.Items[id]
			local row = UI.frame(listFrame, { BackgroundColor3 = id == selChar and Color3.fromRGB(44, 26, 34) or C.panel2, Size = UDim2.new(1, -6, 0, 62) })
			UI.corner(row, 10)
			UI.stroke(row, UI.rarityColor(cfg.rarity), 1.5, id == selChar and 0 or 0.6)
			UI.label(row, cfg.name, 18, C.text, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -60, 0, 24), Font = UI.fontBold, TextWrapped = false })
			UI.label(row, cfg.title, 13, C.dim, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -60, 0, 20), TextWrapped = false })
			local mark = isEquipped(it) and "✓" or (isOwned(it) and "" or "🔒")
			UI.label(row, mark, 20, isEquipped(it) and C.good or C.dim, { Position = UDim2.new(1, -44, 0, 0), Size = UDim2.fromOffset(34, 62), TextXAlignment = Enum.TextXAlignment.Center })
			local hit = UI.make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3 }, row)
			hit.Activated:Connect(function()
				UI.play("click", 0.3)
				selChar = id
				selSkin = nil
				render()
				refreshPreview()
			end)
		end
		renderInfo()
	end

	for _, t in ipairs({ { "survivor", "Выжившие" }, { "killer", "Убийцы" } }) do
		tabBtns[t[1]] = UI.button(tabs, t[2], function()
			tab = t[1]
			selChar = t[1] == "survivor" and prof().equipped.survivor or prof().equipped.killer
			selSkin = nil
			render()
			refreshPreview()
		end, { dim = UDim2.fromOffset(122, 38), size = 15 })
	end
	m.onOpen = function()
		selChar = tab == "survivor" and prof().equipped.survivor or prof().equipped.killer
		selSkin = nil
		render()
		refreshPreview()
	end
	m.render = function()
		if UI.currentModal == m then
			render()
		end
	end
	m.onClose = function()
		preview:Clear()
	end
	return m
end

--// ------------------------------------------------------------------ ПОИСК МАТЧА
local function buildQueue()
	local m = UI.modal("Охота", 980, 600)
	local body = m.body
	UI.label(body, "ВАША РОЛЬ", 22, C.blood, { Font = UI.fontTitle, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(400, 30), TextWrapped = false })
	local roleBtns = {}
	local roles = {
		{ "Survivor", "ВЫЖИВШИЙ", "Чините генераторы и сбегайте через ворота." },
		{ "Killer", "УБИЙЦА", "Выслеживайте и не дайте им уйти." },
		{ "Any", "ЛЮБАЯ", "Роль назначит система. Быстрее подбор." },
	}
	for i, r in ipairs(roles) do
		local b = UI.button(body, "", function()
			prof().settings.role = r[1]
			Net.E("SaveSettings"):FireServer({ role = r[1] })
			for id, bb in pairs(roleBtns) do
				bb.BackgroundColor3 = id == r[1] and C.bloodDark or C.panel2
			end
		end, { dim = UDim2.fromOffset(300, 82), style = "ghost" })
		b.Position = UDim2.fromOffset(0, 40 + (i - 1) * 92)
		UI.label(b, r[2], 22, C.text, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 28), Font = UI.fontBold, TextWrapped = false })
		UI.label(b, r[3], 13, C.dim, { Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -28, 0, 38), TextYAlignment = Enum.TextYAlignment.Top })
		roleBtns[r[1]] = b
	end
	local eqLbl = UI.label(body, "", 15, C.dim, { Position = UDim2.fromOffset(0, 322), Size = UDim2.fromOffset(300, 70), TextYAlignment = Enum.TextYAlignment.Top })
	UI.label(body, "ГОЛОСОВАНИЕ ЗА КАРТУ", 22, C.blood, { Font = UI.fontTitle, Position = UDim2.fromOffset(330, 0), Size = UDim2.fromOffset(400, 30), TextWrapped = false })
	local mapBtns = {}
	local voted = ""
	local function setVote(id)
		voted = id
		Net.E("VoteMap"):FireServer(id)
		for k, b in pairs(mapBtns) do
			b.BackgroundColor3 = k == id and C.bloodDark or C.panel2
		end
	end
	local entries = { { "", "Случайная карта", "Система выберет сама", "#aaaaaa" } }
	for _, id in ipairs(Config.MapOrder) do
		table.insert(entries, { id, Config.Maps[id].name, Config.Maps[id].desc, Config.Maps[id].color })
	end
	for i, e in ipairs(entries) do
		local b = UI.button(body, "", function()
			setVote(e[1])
		end, { dim = UDim2.fromOffset(620, 56), style = "ghost" })
		b.Position = UDim2.fromOffset(330, 40 + (i - 1) * 62)
		UI.frame(b, { BackgroundColor3 = Color3.fromHex(e[4]), Size = UDim2.new(0, 5, 1, 0) })
		UI.label(b, e[2], 17, C.text, { Position = UDim2.fromOffset(16, 4), Size = UDim2.new(1, -30, 0, 24), Font = UI.fontBold, TextWrapped = false })
		UI.label(b, e[3], 12, C.dim, { Position = UDim2.fromOffset(16, 28), Size = UDim2.new(1, -30, 0, 24), TextWrapped = false })
		mapBtns[e[1]] = b
	end
	local go = UI.button(body, "НАЙТИ МАТЧ", function()
		local role = prof().settings.role or "Any"
		Net.E("QueueJoin"):FireServer(role)
		UI.toast("Поиск матча начат", "info")
		UI.closeModal()
	end, { dim = UDim2.fromOffset(300, 54), style = "primary", size = 22, font = UI.fontTitle })
	go.Position = UDim2.fromOffset(0, 400)
	m.onOpen = function()
		local p = prof()
		for id, bb in pairs(roleBtns) do
			bb.BackgroundColor3 = id == (p.settings.role or "Any") and C.bloodDark or C.panel2
		end
		for k, b in pairs(mapBtns) do
			b.BackgroundColor3 = k == voted and C.bloodDark or C.panel2
		end
		local sv = Config.Survivors[p.equipped.survivor]
		local kv = Config.Killers[p.equipped.killer]
		eqLbl.Text = "Выживший: " .. sv.name .. " (" .. Config.SkinById[p.equipped.skins[sv.id]].name .. ")\nУбийца: " .. kv.name .. " (" .. Config.SkinById[p.equipped.skins[kv.id]].name .. ")"
		if S.queue.queued then
			UI.setButton(go, "ВЫ УЖЕ В ОЧЕРЕДИ", "ghost", true)
		else
			UI.setButton(go, "НАЙТИ МАТЧ", "primary", false)
		end
	end
	return m
end

--// ------------------------------------------------------------------ НАСТРОЙКИ
local function slider(parent, label, value, onChange, y)
	local row = UI.frame(parent, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 44) })
	UI.label(row, label, 18, C.text, { Size = UDim2.fromOffset(200, 44), TextWrapped = false })
	local track = UI.frame(row, { BackgroundColor3 = Color3.fromRGB(8, 8, 12), Position = UDim2.fromOffset(220, 18), Size = UDim2.fromOffset(300, 8) })
	UI.corner(track, 4)
	local fill = UI.frame(track, { BackgroundColor3 = C.blood, Size = UDim2.fromScale(value, 1) })
	UI.corner(fill, 4)
	local knob = UI.frame(track, { BackgroundColor3 = C.text, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(value, 0.5), Size = UDim2.fromOffset(20, 20) })
	UI.corner(knob, 10)
	local pct = UI.label(row, math.floor(value * 100) .. "%", 16, C.dim, { Position = UDim2.fromOffset(536, 0), Size = UDim2.fromOffset(60, 44) })
	local function set(x)
		local v = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.fromScale(v, 0.5)
		pct.Text = math.floor(v * 100) .. "%"
		onChange(v)
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			set(i.Position.X)
			local c
			c = UserInputService.InputChanged:Connect(function(ch)
				if ch.UserInputType == Enum.UserInputType.MouseMovement or ch.UserInputType == Enum.UserInputType.Touch then
					set(ch.Position.X)
				end
			end)
			local e
			e = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					e:Disconnect()
				end
			end)
		end
	end)
	return row
end

local function toggle(parent, label, key, y, note)
	local row = UI.frame(parent, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 44) })
	UI.label(row, label, 18, C.text, { Size = UDim2.fromOffset(330, 44), TextWrapped = false })
	local b
	b = UI.button(row, "", function()
		local s = prof().settings
		s[key] = not s[key]
		UI.setButton(b, s[key] and "ВКЛ" or "ВЫКЛ", s[key] and "good" or "ghost", false)
		Net.E("SaveSettings"):FireServer({ [key] = s[key] })
		UI.emit("settings")
	end, { dim = UDim2.fromOffset(90, 34), size = 15 })
	b.Position = UDim2.fromOffset(340, 5)
	if note then
		UI.label(row, note, 12, C.dim, { Position = UDim2.fromOffset(446, 0), Size = UDim2.fromOffset(160, 44) })
	end
	return b
end

local function buildSettings()
	local m = UI.modal("Настройки", 760, 640)
	local body = m.body
	local saveT = 0
	local function saveLater()
		saveT += 1
		local my = saveT
		task.delay(0.4, function()
			if my == saveT and prof() then
				Net.E("SaveSettings"):FireServer({ music = prof().settings.music, sfx = prof().settings.sfx })
			end
		end)
	end
	slider(body, "Музыка и атмосфера", 0.6, function(v)
		prof().settings.music = v
		UI.emit("settings")
		saveLater()
	end, 0).Name = "MusicSlider"
	slider(body, "Звуковые эффекты", 1, function(v)
		prof().settings.sfx = v
		UI.emit("settings")
		saveLater()
	end, 48).Name = "SfxSlider"
	local t1 = toggle(body, "Тряска камеры", "shake", 100)
	local t2 = toggle(body, "Бег по переключателю (ПК)", "sprintToggle", 148)
	local t3 = toggle(body, "Низкая графика (для слабых устройств)", "lowGfx", 196, "Отключает тени и часть эффектов")
	local help = UI.frame(body, { BackgroundColor3 = C.panel2, Position = UDim2.fromOffset(0, 256), Size = UDim2.new(1, 0, 0, 290) })
	UI.corner(help, 10)
	UI.pad(help, 14)
	UI.label(help, "УПРАВЛЕНИЕ", 20, C.blood, { Font = UI.fontTitle, Size = UDim2.new(1, 0, 0, 26), TextWrapped = false })
	local txt = "ПК: WASD — движение · Shift — бег · C — присесть · E (удерживать) — взаимодействие · Q — способность · ЛКМ / F — атака убийцы · G — эмоция · Tab — меню в лобби\n\n"
		.. "Телефон/планшет: левый стик — движение; справа кнопки: БЕГ, ПРИСЕСТЬ, ДЕЙСТВИЕ (удерживать), СПОСОБНОСТЬ, АТАКА.\n\n"
		.. "Геймпад: A — действие · X — способность · R2 — атака · L3 — бег · B — присесть.\n\n"
		.. "Цель выживших: починить 5 генераторов, открыть ворота и сбежать. Двое сбежавших — победа выживших."
	UI.label(help, txt, 15, C.text, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), TextYAlignment = Enum.TextYAlignment.Top })
	m.onOpen = function()
		local s = prof().settings
		UI.setButton(t1, s.shake and "ВКЛ" or "ВЫКЛ", s.shake and "good" or "ghost", false)
		UI.setButton(t2, s.sprintToggle and "ВКЛ" or "ВЫКЛ", s.sprintToggle and "good" or "ghost", false)
		UI.setButton(t3, s.lowGfx and "ВКЛ" or "ВЫКЛ", s.lowGfx and "good" or "ghost", false)
	end
	return m
end

--// ------------------------------------------------------------------ ГЛАВНОЕ МЕНЮ
local mainMenu, menuBtn, queueBar, queueLbl, startNowBtn, dailyBtn
local modals: any = {}

local function claimDaily()
	task.spawn(function()
		local ok, msg = Net.F("ClaimDaily"):InvokeServer()
		UI.toast(msg or "", ok and "good" or "warn")
		UI.play(ok and "buy" or "error", 0.6)
	end)
end

local function buildMainMenu()
	mainMenu = UI.frame(UI.root, { Name = "MainMenu", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4 })
	local shade = UI.frame(mainMenu, { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(0, 460, 1, 0) })
	UI.make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.45), NumberSequenceKeypoint.new(1, 1) }), Rotation = 0 }, shade)
	local compact = UI.mobile
	UI.label(mainMenu, "HOLLOWFALL", compact and 58 or 84, C.blood, { Font = UI.fontTitle, Position = UDim2.fromOffset(40, compact and 56 or 70), Size = UDim2.fromOffset(440, compact and 64 or 90), TextWrapped = false })
	UI.label(mainMenu, Config.Tagline, compact and 13 or 16, C.dim, { Position = UDim2.fromOffset(44, compact and 118 or 158), Size = UDim2.fromOffset(340, 44), TextYAlignment = Enum.TextYAlignment.Top })
	local col = UI.frame(mainMenu, { BackgroundTransparency = 1, Position = UDim2.fromOffset(40, compact and 160 or 220), Size = UDim2.fromOffset(340, 400) })
	UI.list(col, Enum.FillDirection.Vertical, compact and 5 or 8)
	local function mb(text, style, cb, order)
		local b = UI.button(col, text, cb, { dim = UDim2.fromOffset(320, compact and 38 or 48), style = style, size = compact and 16 or 19, order = order })
		b.TextXAlignment = Enum.TextXAlignment.Left
		UI.pad(b, 16)
		return b
	end
	mb("▶  ИГРАТЬ", "primary", function()
		modals.queue:Open()
	end, 1)
	mb("ПЕРСОНАЖИ И СКИНЫ", "ghost", function()
		modals.characters:Open()
	end, 2)
	mb("МАГАЗИН", "ghost", function()
		modals.shop:Open()
	end, 3)
	mb("КОЛЛЕКЦИЯ", "ghost", function()
		modals.inventory:Open()
	end, 4)
	mb("НАСТРОЙКИ", "ghost", function()
		modals.settings:Open()
	end, 5)
	dailyBtn = mb("🎁  ЕЖЕДНЕВНАЯ НАГРАДА", "gold", claimDaily, 6)
	mb("ИССЛЕДОВАТЬ ЛОББИ", "dark", function()
		Menus.ShowMenu(false)
	end, 7)
	UI.label(mainMenu, "v1.0 · Создано в Luau · Оригинальные персонажи", 12, C.dim, { Position = UDim2.new(0, 44, 1, -30), Size = UDim2.fromOffset(400, 20), TextWrapped = false })

	menuBtn = UI.button(UI.root, "☰  МЕНЮ", function()
		Menus.ShowMenu(true)
	end, { dim = UDim2.fromOffset(130, 40), size = 16, style = "dark" })
	menuBtn.Position = UDim2.fromOffset(20, 14)
	menuBtn.ZIndex = 6
	menuBtn.Visible = false

	-- панель поиска
	queueBar = UI.frame(UI.root, { Name = "QueueBar", BackgroundColor3 = C.panel, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(640, 64), Visible = false, ZIndex = 6 })
	UI.corner(queueBar, 14)
	UI.stroke(queueBar, C.blood, 1.8)
	queueLbl = UI.label(queueBar, "", 17, C.text, { Position = UDim2.fromOffset(18, 0), Size = UDim2.fromOffset(360, 64), Font = UI.fontBold })
	startNowBtn = UI.button(queueBar, "СТАРТ СЕЙЧАС", function()
		Net.E("StartNow"):FireServer()
	end, { dim = UDim2.fromOffset(120, 38), size = 13, style = "gold" })
	startNowBtn.Position = UDim2.new(1, -250, 0.5, -19)
	local cancel = UI.button(queueBar, "ОТМЕНА", function()
		Net.E("QueueLeave"):FireServer()
	end, { dim = UDim2.fromOffset(100, 38), size = 14, style = "primary" })
	cancel.Position = UDim2.new(1, -118, 0.5, -19)
end

local function updateQueueBar()
	local q = S.queue
	local lobby = S.lobby
	if onlineLbl then
		onlineLbl.Text = string.format("Игроков: %d · В очереди: %d", lobby.players or 1, q.count or 0)
	end
	if S.inMatch then
		queueBar.Visible = false
		return
	end
	if q.queued then
		queueBar.Visible = true
		local txt = string.format("Поиск матча…  %d/5 игроков", q.count or 1)
		if q.eta then
			txt = txt .. "  ·  старт через " .. UI.formatTime(q.eta)
		end
		if q.phase and q.phase ~= "Lobby" then
			txt = "Матч идёт — вы следующие в очереди"
		end
		queueLbl.Text = txt
	elseif q.starting then
		queueBar.Visible = true
		queueLbl.Text = "Матч найден! Загрузка карты…"
	else
		queueBar.Visible = false
	end
end

--// ------------------------------------------------------------------ КАМЕРА МЕНЮ
local camConn
local camT = 0
function Menus.OrbitCamera(on)
	local cam = workspace.CurrentCamera
	if on then
		if camConn then
			return
		end
		cam.CameraType = Enum.CameraType.Scriptable
		camConn = RunService.RenderStepped:Connect(function(dt)
			camT += dt * 0.12
			local r = 52
			local pos = Vector3.new(math.cos(camT) * r, 17 + math.sin(camT * 0.7) * 3, math.sin(camT) * r + 6)
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(pos, Vector3.new(0, 8, 0)), 0.1)
		end)
	else
		if camConn then
			camConn:Disconnect()
			camConn = nil
		end
		cam.CameraType = Enum.CameraType.Custom
	end
end

function Menus.ShowMenu(show)
	mainMenu.Visible = show
	menuBtn.Visible = not show and not S.inMatch
	if show then
		UI.closeModal()
	end
	if not S.inMatch then
		Menus.OrbitCamera(show)
	end
end

function Menus.SetLobbyVisible(v)
	topBar.Visible = v
	if not v then
		mainMenu.Visible = false
		menuBtn.Visible = false
		queueBar.Visible = false
		UI.closeModal()
		Menus.OrbitCamera(false)
	end
end

function Menus.OpenPortal(key)
	if S.inMatch then
		return
	end
	if key == "Shop" then
		modals.shop:Open()
	elseif key == "Inventory" then
		modals.inventory:Open()
	elseif key == "Characters" then
		modals.characters:Open()
	elseif key == "Queue" then
		modals.queue:Open()
	end
end

--// ------------------------------------------------------------------ ЭКРАН ИТОГОВ
local results
function Menus.ShowResults(d)
	if results then
		results:Destroy()
	end
	results = UI.frame(UI.root, { Name = "Results", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40 })
	UI.tween(results, { BackgroundTransparency = 0.25 }, 0.6)
	local win = d.result == "Victory"
	local card = UI.make("CanvasGroup", { BackgroundColor3 = C.bg, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(720, 520), GroupTransparency = 1, ZIndex = 41 }, results)
	UI.corner(card, 18)
	UI.stroke(card, win and C.gold or C.blood, 2.5)
	UI.gradient(card, win and Color3.fromRGB(40, 30, 14) or Color3.fromRGB(36, 12, 16), Color3.fromRGB(10, 10, 14), 90)
	UI.label(card, win and "ПОБЕДА" or "ПОРАЖЕНИЕ", 84, win and C.gold or C.blood, { Font = UI.fontTitle, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 96), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	local sub = d.mePersonal or ""
	if d.role == "Survivor" then
		sub = sub .. string.format(" · сбежало %d из %d", d.escaped, d.total)
	else
		sub = sub .. string.format(" · сбежало выживших: %d из %d", d.escaped, d.total)
	end
	if d.reason == "killerLeft" then
		sub = "Убийца покинул игру"
	end
	UI.label(card, sub, 18, C.text, { Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Center })
	local lines = UI.frame(card, { BackgroundColor3 = C.panel2, Position = UDim2.fromOffset(30, 148), Size = UDim2.fromOffset(330, 270) })
	UI.corner(lines, 10)
	UI.pad(lines, 10)
	UI.list(lines, Enum.FillDirection.Vertical, 4)
	UI.label(lines, "ОЧКИ ЗА МАТЧ", 15, C.blood, { Size = UDim2.new(1, 0, 0, 22), Font = UI.fontBold })
	for i, ln in ipairs(d.lines) do
		if i <= 8 then
			local r = UI.frame(lines, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
			UI.label(r, ln[1], 15, C.text, { Size = UDim2.new(0.7, 0, 1, 0), TextWrapped = false })
			UI.label(r, "+" .. ln[2], 15, C.gold, { Position = UDim2.fromScale(0.7, 0), Size = UDim2.new(0.3, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Font = UI.fontBold })
		end
	end
	local right = UI.frame(card, { BackgroundColor3 = C.panel2, Position = UDim2.fromOffset(376, 148), Size = UDim2.fromOffset(314, 270) })
	UI.corner(right, 10)
	UI.pad(right, 10)
	UI.list(right, Enum.FillDirection.Vertical, 4)
	UI.label(right, "ИТОГИ ВЫЖИВШИХ", 15, C.blood, { Size = UDim2.new(1, 0, 0, 22), Font = UI.fontBold })
	for _, r in ipairs(d.results) do
		local row = UI.frame(right, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22) })
		UI.label(row, r.n, 15, C.text, { Size = UDim2.new(0.62, 0, 1, 0), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		UI.label(row, r.s == "Escaped" and "Сбежал" or "Погиб", 15, r.s == "Escaped" and C.good or C.blood, { Position = UDim2.fromScale(0.62, 0), Size = UDim2.fromScale(0.38, 1), TextXAlignment = Enum.TextXAlignment.Right, Font = UI.fontBold })
	end
	local rew = string.format("+%d ◆   +%d XP", d.shards, d.xp)
	UI.label(card, rew, 30, C.gold, { Font = UI.fontBold, Position = UDim2.fromOffset(0, 428), Size = UDim2.new(1, 0, 0, 38), TextXAlignment = Enum.TextXAlignment.Center })
	if d.levelUps and d.levelUps > 0 then
		UI.label(card, "НОВЫЙ УРОВЕНЬ: " .. d.level .. "!", 18, C.good, { Font = UI.fontBold, Position = UDim2.fromOffset(0, 462), Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center })
	else
		UI.label(card, "Возвращение в лобби…", 15, C.dim, { Position = UDim2.fromOffset(0, 466), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	end
	UI.tween(card, { GroupTransparency = 0 }, 0.5)
	UI.play(win and "win" or "error", 0.7)
end

function Menus.HideResults()
	if results then
		local r = results
		results = nil
		UI.tween(r, { BackgroundTransparency = 1 }, 0.4)
		task.delay(0.45, function()
			r:Destroy()
		end)
	end
end

--// ------------------------------------------------------------------ ИНИЦИАЛИЗАЦИЯ
function Menus.Init()
	buildTopBar()
	modals.shop = buildItemModal("Магазин", "shop")
	modals.inventory = buildItemModal("Коллекция", "inventory")
	modals.characters = buildCharacters()
	modals.queue = buildQueue()
	modals.settings = buildSettings()
	buildMainMenu()
	UI.on("profile", function()
		Menus.RefreshTop()
		for _, k in ipairs({ "shop", "inventory", "characters" }) do
			if modals[k].render then
				modals[k].render()
			end
		end
	end)
	UI.on("queue", updateQueueBar)
	UI.on("lobby", updateQueueBar)
	UserInputService.InputBegan:Connect(function(i, gpe)
		if gpe or S.inMatch then
			return
		end
		if i.KeyCode == Enum.KeyCode.Tab then
			if UI.currentModal then
				UI.closeModal()
			else
				Menus.ShowMenu(not mainMenu.Visible)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			local p = prof()
			if p and dailyBtn then
				local left = Config.Daily.cooldown - (os.time() - p.lastDaily)
				dailyBtn.Text = left <= 0 and "🎁  ЗАБРАТЬ НАГРАДУ!" or "🎁  НАГРАДА ЧЕРЕЗ " .. math.ceil(left / 3600) .. " Ч"
			end
		end
	end)
end

return Menus
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX39">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Client/UI — библиотека интерфейса (адаптивный масштаб, кнопки, окна, уведомления, 3D-превью)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local AnimLib = require(Shared:WaitForChild("AnimLib"))

local lp = Players.LocalPlayer
local C = Config.Colors

local UI = {}
UI.C = C
UI.S = { profile = nil, phase = "Lobby", inMatch = false, role = nil, match = nil, queue = { queued = false, count = 0 }, lobby = { players = 1, queue = 0 }, mobile = false }
UI.mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
UI.S.mobile = UI.mobile

local listeners = {}
function UI.on(ev, fn)
	listeners[ev] = listeners[ev] or {}
	table.insert(listeners[ev], fn)
end
function UI.emit(ev, ...)
	for _, fn in ipairs(listeners[ev] or {}) do
		task.spawn(fn, ...)
	end
end

local function safeFont(name, fallback)
	local ok, f = pcall(function()
		return (Enum.Font :: any)[name]
	end)
	if ok and f then
		return f
	end
	return fallback
end
UI.fontTitle = safeFont("Creepster", Enum.Font.GothamBlack)
UI.fontBody = Enum.Font.GothamMedium
UI.fontBold = Enum.Font.GothamBold

--// ------------------------------------------------------------ КОРНЕВОЙ GUI
local gui = Instance.new("ScreenGui")
gui.Name = "HollowfallUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = lp:WaitForChild("PlayerGui")
UI.gui = gui

local root = Instance.new("Frame")
root.Name = "Root"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = gui
local uiScale = Instance.new("UIScale")
uiScale.Parent = root
UI.root = root

local function resize()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local v = cam.ViewportSize
	local lo = UI.mobile and 0.7 or 0.62
	local s = math.clamp(math.min(v.X / 1100, v.Y / 620), lo, 1.5)
	uiScale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
	UI.scaleValue = s
end
resize()
task.spawn(function()
	local cam = workspace.CurrentCamera or workspace:WaitForChild("Camera")
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	resize()
end)

--// ------------------------------------------------------------ ПРИМИТИВЫ
function UI.make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		(o :: any)[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

function UI.corner(o, r)
	return UI.make("UICorner", { CornerRadius = UDim.new(0, r or 10) }, o)
end
function UI.stroke(o, color, thick, trans)
	return UI.make("UIStroke", { Color = color or C.line, Thickness = thick or 1.5, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
function UI.pad(o, p)
	return UI.make("UIPadding", { PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p) }, o)
end
function UI.list(o, dir, gap, ha, va)
	return UI.make("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 6), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left, VerticalAlignment = va or Enum.VerticalAlignment.Top,
	}, o)
end
function UI.gradient(o, c0, c1, rot)
	return UI.make("UIGradient", { Color = ColorSequence.new(c0, c1), Rotation = rot or 90 }, o)
end

function UI.frame(parent, props)
	local p = { BackgroundColor3 = C.panel, BorderSizePixel = 0 }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UI.make("Frame", p, parent)
end

function UI.label(parent, text, size, color, props)
	local p = {
		BackgroundTransparency = 1, Text = text, TextSize = size or 18, TextColor3 = color or C.text, Font = UI.fontBody,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, BorderSizePixel = 0, TextWrapped = true,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UI.make("TextLabel", p, parent)
end

function UI.tween(o, props, t, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function UI.rarityColor(r)
	return Config.Rarity[r] and Config.Rarity[r].color or C.dim
end

--// ------------------------------------------------------------ ЗВУК ИНТЕРФЕЙСА
local sndFolder = Instance.new("Folder")
sndFolder.Name = "UISounds"
sndFolder.Parent = SoundService
function UI.sfxVolume()
	local p = UI.S.profile
	return p and p.settings.sfx or 1
end
function UI.play(key, vol, pitch)
	local id = Config.Audio[key]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = (vol or 0.5) * UI.sfxVolume()
	s.PlaybackSpeed = pitch or 1
	s.Parent = sndFolder
	s:Play()
	task.delay(3, function()
		s:Destroy()
	end)
end

--// ------------------------------------------------------------ КНОПКИ
local STYLES = {
	primary = { bg = C.blood, hover = Color3.fromRGB(225, 50, 65), text = Color3.fromRGB(255, 255, 255) },
	ghost = { bg = C.panel2, hover = Color3.fromRGB(48, 48, 66), text = C.text },
	gold = { bg = Color3.fromRGB(190, 140, 40), hover = Color3.fromRGB(230, 175, 55), text = Color3.fromRGB(20, 14, 6) },
	good = { bg = Color3.fromRGB(46, 130, 80), hover = Color3.fromRGB(62, 170, 104), text = Color3.fromRGB(255, 255, 255) },
	dark = { bg = Color3.fromRGB(16, 16, 22), hover = Color3.fromRGB(34, 34, 46), text = C.text },
}
function UI.button(parent, text, cb, o)
	o = o or {}
	local st = STYLES[o.style or "ghost"]
	local b = UI.make("TextButton", {
		Text = text, Font = o.font or UI.fontBold, TextSize = o.size or 18, TextColor3 = st.text, BackgroundColor3 = st.bg, AutoButtonColor = false,
		Size = o.dim or UDim2.fromOffset(160, 42), BorderSizePixel = 0, LayoutOrder = o.order or 0,
	}, parent)
	UI.corner(b, o.radius or 8)
	if o.stroke ~= false then
		UI.stroke(b, o.strokeColor or C.line, 1.2, 0.2)
	end
	b:SetAttribute("Style", o.style or "ghost")
	b.MouseEnter:Connect(function()
		if b:GetAttribute("Disabled") then
			return
		end
		UI.tween(b, { BackgroundColor3 = st.hover }, 0.12)
		UI.play("hover", 0.15)
	end)
	b.MouseLeave:Connect(function()
		UI.tween(b, { BackgroundColor3 = b:GetAttribute("Disabled") and C.panel2 or st.bg }, 0.15)
	end)
	b.Activated:Connect(function()
		if b:GetAttribute("Disabled") then
			UI.play("error", 0.3)
			return
		end
		UI.play("click", 0.4)
		if cb then
			cb(b)
		end
	end)
	return b
end

function UI.setButton(b, text, style, disabled)
	local st = STYLES[style or "ghost"]
	b.Text = text
	b:SetAttribute("Disabled", disabled or false)
	b.BackgroundColor3 = disabled and C.panel2 or st.bg
	b.TextColor3 = disabled and C.dim or st.text
end

--// ------------------------------------------------------------ ОКНА
UI.modals = {}
UI.currentModal = nil
function UI.closeModal()
	local m = UI.currentModal
	if m then
		UI.currentModal = nil
		m.group.Visible = false
		m.dim.Visible = false
		if m.onClose then
			m.onClose()
		end
	end
end

function UI.modal(title, w, h)
	local m: any = {}
	m.dim = UI.frame(root, { Name = title, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 20, Active = true })
	m.group = UI.make("CanvasGroup", {
		BackgroundColor3 = C.bg, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h),
		Visible = false, ZIndex = 21,
	}, root)
	UI.corner(m.group, 16)
	UI.stroke(m.group, C.line, 2)
	UI.gradient(m.group, Color3.fromRGB(26, 20, 30), Color3.fromRGB(10, 10, 14), 90)
	local scale = UI.make("UIScale", { Scale = 1 }, m.group)
	local function fitK()
		local cam = workspace.CurrentCamera
		local s = UI.scaleValue or 1
		if not cam then
			return 1
		end
		local v = cam.ViewportSize / s
		return math.clamp(math.min((v.X - 24) / w, (v.Y - 24) / h), 0.45, 1)
	end
	UI.label(m.group, string.upper(title), 36, C.blood, { Font = UI.fontTitle, Position = UDim2.fromOffset(22, 10), Size = UDim2.fromOffset(500, 44), TextWrapped = false })
	local close = UI.button(m.group, "✕", function()
		UI.closeModal()
	end, { dim = UDim2.fromOffset(40, 36), style = "dark", size = 20 })
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -16, 0, 12)
	m.body = UI.frame(m.group, { BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 64), Size = UDim2.new(1, -36, 1, -80) })
	function m:Open()
		UI.closeModal()
		UI.currentModal = m
		m.dim.Visible = true
		m.group.Visible = true
		m.group.GroupTransparency = 1
		local k = fitK()
		scale.Scale = k * 0.94
		UI.tween(m.group, { GroupTransparency = 0 }, 0.22)
		UI.tween(scale, { Scale = k }, 0.25, Enum.EasingStyle.Back)
		UI.play("click", 0.3, 0.8)
		if m.onOpen then
			m.onOpen()
		end
	end
	function m:Close()
		if UI.currentModal == m then
			UI.closeModal()
		end
	end
	m.dim.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			-- клик по затемнению закрывает окно
			local pos = i.Position
			local ap, as = m.group.AbsolutePosition, m.group.AbsoluteSize
			if pos.X < ap.X or pos.X > ap.X + as.X or pos.Y < ap.Y or pos.Y > ap.Y + as.Y then
				UI.closeModal()
			end
		end
	end)
	return m
end

--// ------------------------------------------------------------ УВЕДОМЛЕНИЯ
local toastBox = UI.frame(root, { Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 78), Size = UDim2.fromOffset(460, 300), ZIndex = 60 })
UI.list(toastBox, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
local KIND = { info = Color3.fromRGB(120, 150, 255), good = C.good, bad = C.blood, warn = C.warn }
function UI.toast(text, kind)
	local col = KIND[kind or "info"] or KIND.info
	local f = UI.frame(toastBox, { BackgroundColor3 = Color3.fromRGB(14, 14, 20), BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 61 })
	UI.corner(f, 8)
	local st = UI.stroke(f, col, 1.5, 1)
	local lbl = UI.label(f, text, 17, C.text, { Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, TextTransparency = 1, ZIndex = 62, Font = UI.fontBold })
	UI.pad(lbl, 12)
	UI.tween(f, { BackgroundTransparency = 0.15 }, 0.2)
	UI.tween(st, { Transparency = 0.1 }, 0.2)
	UI.tween(lbl, { TextTransparency = 0 }, 0.2)
	for _, c in ipairs(toastBox:GetChildren()) do
		if c:IsA("Frame") and #toastBox:GetChildren() > 7 then
			c:Destroy()
			break
		end
	end
	task.delay(4.2, function()
		if f.Parent then
			UI.tween(f, { BackgroundTransparency = 1 }, 0.4)
			UI.tween(st, { Transparency = 1 }, 0.4)
			UI.tween(lbl, { TextTransparency = 1 }, 0.4)
			task.wait(0.45)
			f:Destroy()
		end
	end)
end

--// ------------------------------------------------------------ ЭКРАННЫЙ ПЕРЕХОД
local fader = UI.frame(root, { Name = "Fader", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Active = false })
function UI.fade(toBlack, t)
	fader.Active = toBlack
	local tw = UI.tween(fader, { BackgroundTransparency = toBlack and 0 or 1 }, t or 0.5)
	return tw
end

--// ------------------------------------------------------------ 3D-ПРЕВЬЮ ПЕРСОНАЖА
local baseDummy
local function getDummy()
	if baseDummy then
		return baseDummy:Clone()
	end
	local desc = Instance.new("HumanoidDescription")
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	desc:Destroy()
	if not ok or not model then
		return nil
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	baseDummy = model
	return baseDummy:Clone()
end

function UI.newPreview(parent, props)
	local vp = UI.make("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(18, 16, 24), BorderSizePixel = 0, Ambient = Color3.fromRGB(150, 150, 170), LightColor = Color3.fromRGB(255, 235, 210),
		LightDirection = Vector3.new(-0.5, -0.6, -0.8),
	}, parent)
	for k, v in pairs(props or {}) do
		(vp :: any)[k] = v
	end
	UI.corner(vp, 12)
	UI.stroke(vp, C.line, 1.5)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.Parent = vp
	vp.CurrentCamera = cam
	local P: any = { vp = vp, cam = cam, yaw = 0.5, token = 0, drag = false }
	local conn
	local function frame(k)
		local h = 2.6 * k
		cam.CFrame = CFrame.lookAt(Vector3.new(0, h + 0.6, -13 * math.max(k, 0.9)), Vector3.new(0, h, 0))
	end
	function P:Show(o)
		P.token += 1
		local tk = P.token
		task.spawn(function()
			local model = getDummy()
			if not model or tk ~= P.token then
				return
			end
			if P.model then
				P.model:Destroy()
			end
			model.Parent = vp
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
			root.Anchored = true
			local cfg = Config.GetChar(o.char)
			Cosmetics.Apply(model, o.char, o.skin, o.acc, { showFx = true, effect = o.effect })
			P.model = model
			P.ctrl = AnimLib.new(model)
			P.o = o
			P.k = (cfg and cfg.scale or 1)
			frame(P.k)
		end)
		if not conn then
			conn = RunService.RenderStepped:Connect(function(dt)
				local m = P.model
				if not m or not m.Parent then
					return
				end
				if not P.drag then
					P.yaw += dt * 0.5
				end
				local root = m:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					root.CFrame = CFrame.new(0, 3.2, 0) * CFrame.Angles(0, P.yaw, 0)
				end
				local o = P.o or {}
				local isKiller = Config.Killers[o.char] ~= nil
				P.ctrl:Update(dt, { speed = 0, state = "Healthy", emote = o.emote, style = o.style, killerId = isKiller and o.char or nil })
			end)
		end
	end
	vp.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			P.drag = true
			local last = i.Position
			local c
			c = UserInputService.InputChanged:Connect(function(ch)
				if ch.UserInputType == Enum.UserInputType.MouseMovement or ch.UserInputType == Enum.UserInputType.Touch then
					P.yaw += (ch.Position.X - last.X) * 0.012
					last = ch.Position
				end
			end)
			local e
			e = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					P.drag = false
					c:Disconnect()
					e:Disconnect()
				end
			end)
		end
	end)
	function P:Clear()
		P.token += 1
		if P.model then
			P.model:Destroy()
			P.model = nil
		end
	end
	function P:Destroy()
		P:Clear()
		if conn then
			conn:Disconnect()
		end
		vp:Destroy()
	end
	return P
end

--// ------------------------------------------------------------ ПРОЧЕЕ
function UI.formatTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

function UI.pill(parent, text, color, size)
	local f = UI.frame(parent, { BackgroundColor3 = color or C.panel2, Size = UDim2.fromOffset(0, size or 28), AutomaticSize = Enum.AutomaticSize.X })
	UI.corner(f, 14)
	local l = UI.label(f, text, 16, C.text, { Size = UDim2.fromOffset(0, size or 28), AutomaticSize = Enum.AutomaticSize.X, TextWrapped = false, Font = UI.fontBold })
	UI.pad(l, 10)
	return f, l
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="RBX3A">
        <Properties>
          <string name="Name">ClientMain</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: точка входа клиента
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")

local lp = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local LightingFx = require(Shared:WaitForChild("LightingFx"))
local Client = script.Parent:WaitForChild("Client")
local UI = require(Client:WaitForChild("UI"))
local Menus = require(Client:WaitForChild("Menus"))
local HUD = require(Client:WaitForChild("HUD"))
local Controls = require(Client:WaitForChild("Controls"))
local AnimClient = require(Client:WaitForChild("AnimClient"))
local Audio = require(Client:WaitForChild("AudioClient"))

local S = UI.S

-- отключаем стандартный интерфейс Roblox
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
	pcall(function()
		StarterGui:SetCore("ResetButtonCallback", false)
	end)
end)

UI.fade(true, 0)
local loading = UI.label(UI.root, "HOLLOWFALL", 64, UI.C.blood, {
	Font = UI.fontTitle, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(700, 90),
	TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101, TextWrapped = false,
})
local loadingSub = UI.label(UI.root, "Загрузка профиля…", 20, UI.C.dim, {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(500, 30),
	TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101,
})
Menus.Init()
HUD.Init()
Controls.Init()
AnimClient.Init()
Audio.Init()

lp.CameraMaxZoomDistance = 22
lp.CameraMinZoomDistance = 0.5

--// Графика: слабые устройства / настройка «низкая графика»
local function applyGfx()
	local low = UI.mobile or (S.profile and S.profile.settings.lowGfx)
	Lighting.GlobalShadows = not low
	local bloom = Lighting:FindFirstChild("HFBloom")
	if bloom then
		bloom.Enabled = not low
	end
end
UI.on("settings", applyGfx)

--// Порталы лобби
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local key = prompt:GetAttribute("Portal")
	if key then
		Menus.OpenPortal(key)
	end
end)

--// События сервера
Net.E("ProfileUpdate").OnClientEvent:Connect(function(p)
	S.profile = p
	UI.emit("profile")
	applyGfx()
end)
Net.E("Notify").OnClientEvent:Connect(function(text, kind)
	UI.toast(text, kind)
	if kind == "bad" then
		UI.play("error", 0.25, 1.3)
	elseif kind == "good" then
		UI.play("buy", 0.25)
	end
end)
Net.E("QueueUpdate").OnClientEvent:Connect(function(d)
	S.queue = d
	UI.emit("queue")
end)
Net.E("LobbyState").OnClientEvent:Connect(function(d)
	S.lobby = d
	S.phase = d.phase
	UI.emit("lobby")
end)
local function matchGfx()
	if UI.mobile then
		pcall(function()
			local tg = lp.PlayerGui:FindFirstChild("TouchGui")
			local jb = tg and tg:FindFirstChild("JumpButton", true)
			if jb then
				jb.Visible = false
			end
		end)
	end
	task.delay(2, function()
		local low = UI.mobile or (S.profile and S.profile.settings.lowGfx)
		local map = workspace:FindFirstChild("Map")
		if map and low then
			local i = 0
			for _, d in ipairs(map:GetDescendants()) do
				if d:IsA("PointLight") then
					i += 1
					d.Enabled = (i % 2 == 0)
				end
			end
		end
	end)
end

Net.E("MatchStart").OnClientEvent:Connect(function(d)
	S.inMatch = true
	S.role = d.role
	S.match = { endTime = d.endTime, need = d.need, info = d }
	S.queue = { queued = false, count = 0 }
	Menus.HideResults()
	Menus.SetLobbyVisible(false)
	Menus.OrbitCamera(false)
	LightingFx.Apply(d.lighting, false)
	Audio.SetMode("match", d.wind)
	HUD.Show(d)
	Controls.OnMatchStart()
	matchGfx()
	lp.CameraMaxZoomDistance = 16
	lp.CameraMinZoomDistance = 6
	UI.fade(true, 0)
	UI.fade(false, 1.2)
end)
Net.E("MatchEnd").OnClientEvent:Connect(function(d)
	S.inMatch = false
	HUD.Hide()
	Menus.ShowResults(d)
end)
Net.E("ToLobby").OnClientEvent:Connect(function(lobbyLighting)
	S.inMatch = false
	S.role = nil
	S.match = nil
	S.terror = 0
	S.chased = false
	UI.fade(true, 0.3)
	task.wait(0.35)
	HUD.Hide()
	Menus.HideResults()
	if lobbyLighting then
		LightingFx.Apply(lobbyLighting, true)
	end
	Audio.SetMode("lobby", 0.5)
	lp.CameraMaxZoomDistance = 22
	lp.CameraMinZoomDistance = 0.5
	Menus.SetLobbyVisible(true)
	Menus.ShowMenu(true)
	UI.fade(false, 0.8)
end)

--// Загрузка профиля и вход в лобби
local profile
for _ = 1, 3 do
	local ok, p = pcall(function()
		return Net.F("GetProfile"):InvokeServer()
	end)
	if ok and p then
		profile = p
		break
	end
	task.wait(1)
end
if not profile then
	profile = Config.DefaultProfile()
	UI.toast("Не удалось загрузить профиль — демо-режим", "warn")
end
S.profile = profile
UI.emit("profile")
applyGfx()
Menus.RefreshTop()
Menus.ShowMenu(true)
Audio.SetMode("lobby", 0.5)
task.wait(0.4)
loading:Destroy()
loadingSub:Destroy()
UI.fade(false, 1.5)
UI.toast("Добро пожаловать в Hollowfall", "info")
-- ежедневная награда доступна?
if os.time() - profile.lastDaily >= Config.Daily.cooldown then
	task.delay(2.5, function()
		UI.toast("🎁 Ежедневная награда готова — заберите её в меню!", "good")
	end)
end
print("[Hollowfall] Клиент запущен", CollectionService)
