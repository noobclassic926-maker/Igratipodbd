--// СКИНЫ
Config.Skins = {} -- Skins[charId] = { skin, ... }
Config.SkinById = {}
local function addSkin(charId, id, name, rarity, price, palette, items, aura)
	local s = { id = id, char = charId, name = name, rarity = rarity, price = price, pal = palette, items = items, aura = aura }
	Config.Skins[charId] = Config.Skins[charId] or {}
	table.insert(Config.Skins[charId], s)
	Config.SkinById[id] = s
end
local function pal(skin, hair, shirt, pants, shoes, acc)
	return { skin = skin, hair = hair, shirt = shirt, pants = pants, shoes = shoes, acc = acc }
end

