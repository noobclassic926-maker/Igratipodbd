	style_zombie = { id = "style_zombie", kind = "style", name = "Шаркающий", desc = "Руки вперёд и вялая походка.", price = 900, rarity = "Rare" },
	style_ninja = { id = "style_ninja", kind = "style", name = "Бег ниндзя", desc = "Руки назад, корпус вперёд.", price = 1600, rarity = "Epic" },
}

--// ЭФФЕКТЫ (аура персонажа; в матче скрыты у выживших ради честности)
Config.EffectOrder = { "fx_blood", "fx_ember", "fx_mist", "fx_ghost", "fx_neon", "fx_stars" }
Config.Effects = {
	fx_blood = { id = "fx_blood", name = "Кровавые капли", desc = "Тёмно-красные капли стекают с вас.", price = 600, rarity = "Common", color = "#b91c1c" },
