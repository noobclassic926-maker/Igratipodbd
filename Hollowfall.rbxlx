}

--// КАРТЫ
Config.MapOrder = { "hospital", "forest", "factory", "city", "underground" }
Config.Maps = {
	hospital = { id = "hospital", name = "Больница «Святой Агаты»", desc = "Тесные коридоры, палаты и операционные. Много окон и укрытий.", color = "#7dd3c0" },
	forest = { id = "forest", name = "Лес Шепчущих Сосен", desc = "Туманный лес, охотничьи домики и старая часовня. Простор и кочки.", color = "#86a96b" },
	factory = { id = "factory", name = "Фабрика «Железный рассвет»", desc = "Цеха, конвейеры и ржавые мостки. Вертикаль и шум.", color = "#d08c4a" },
	city = { id = "city", name = "Городок Тихий Холм", desc = "Улицы, дома и автомобили. Много обходов и петель.", color = "#8aa4d6" },
	underground = { id = "underground", name = "Комплекс «Нулевой уровень»", desc = "Подземные туннели и лаборатории. Тесно, темно, опасно.", color = "#b78bd6" },
}

--// РЕЕСТР ПРЕДМЕТОВ
Config.Items = {}
local function addItem(it)
	Config.Items[it.id] = it
end
for _, id in ipairs(Config.SurvivorOrder) do
	local c = Config.Survivors[id]
	addItem({ id = id, cat = "survivor", name = c.name .. " — " .. c.title, price = c.price, rarity = c.rarity, desc = c.desc })
end
for _, id in ipairs(Config.KillerOrder) do
	local c = Config.Killers[id]
	addItem({ id = id, cat = "killer", name = c.name .. " — " .. c.title, price = c.price, rarity = c.rarity, desc = c.desc })
end
for charId, list in pairs(Config.Skins) do
	for _, s in ipairs(list) do
		addItem({ id = s.id, cat = "skin", char = charId, name = s.name, price = s.price, rarity = s.rarity, desc = "Скин для персонажа." })
	end
end
for _, a in ipairs(Config.ShopAccessories) do
	addItem({ id = "acc_" .. a.cos, cat = "accessory", cos = a.cos, slot = a.slot, name = a.name, price = a.price, rarity = a.rarity, desc = "Аксессуар: " .. Config.AccSlotNames[a.slot] })
end
for _, id in ipairs(Config.AnimationOrder) do
	local a = Config.Animations[id]
	addItem({ id = id, cat = "animation", kind = a.kind, name = a.name, price = a.price, rarity = a.rarity, desc = a.desc })
end
for _, id in ipairs(Config.EffectOrder) do
	local e = Config.Effects[id]
	addItem({ id = id, cat = "effect", name = e.name, price = e.price, rarity = e.rarity, desc = e.desc })
end

function Config.GetChar(id)
	return Config.Survivors[id] or Config.Killers[id]
end

function Config.DefaultSkinFor(charId)
	local list = Config.Skins[charId]
	return list and list[1] and list[1].id or nil
end

function Config.DefaultProfile()
	local owned = { alex = true, theo = true, reaper = true }
	local skins = {}
	for charId, list in pairs(Config.Skins) do
		skins[charId] = list[1].id
		for _, s in ipairs(list) do
			if s.price == 0 then
				owned[s.id] = true
			end
		end
	end
	return {
		version = 1,
		shards = 500,
		xp = 0,
		level = 1,
		owned = owned,
		equipped = { survivor = "alex", killer = "reaper", skins = skins, acc = {}, emote = "", style = "", effect = "" },
		stats = { matches = 0, wins = 0, escapes = 0, kills = 0, hooks = 0, repairs = 0, rescues = 0, hits = 0 },
		settings = { music = 0.6, sfx = 1.0, role = "Any", shake = true, sprintToggle = false, lowGfx = false },
		lastDaily = 0,
		streak = 0,
		lastKiller = 0,
	}
end

function Config.XpForLevel(level)
	return 150 + 90 * (level - 1)
end

function Config.ProcessXp(profile, gained)
	profile.xp = profile.xp + gained
	local levelUps = 0
	while profile.xp >= Config.XpForLevel(profile.level) and profile.level < 100 do
		profile.xp = profile.xp - Config.XpForLevel(profile.level)
		profile.level = profile.level + 1
		profile.shards = profile.shards + 100 + profile.level * 10
		levelUps = levelUps + 1
	end
	return levelUps
end

function Config.Hex(hex)
	return Color3.fromHex(hex)
end

Config.Daily = { cooldown = 20 * 3600, base = 200, perStreak = 50, maxStreak = 7 }

--// Палитра интерфейса
Config.Colors = {
	bg = Color3.fromRGB(10, 10, 14),
	panel = Color3.fromRGB(20, 20, 28),
	panel2 = Color3.fromRGB(30, 30, 42),
	line = Color3.fromRGB(70, 36, 44),
	blood = Color3.fromRGB(190, 30, 45),
	bloodDark = Color3.fromRGB(110, 14, 24),
	text = Color3.fromRGB(235, 232, 228),
	dim = Color3.fromRGB(150, 146, 150),
	good = Color3.fromRGB(90, 200, 120),
	warn = Color3.fromRGB(240, 180, 60),
	gold = Color3.fromRGB(245, 190, 70),
}

return Config
]]></ProtectedString>
