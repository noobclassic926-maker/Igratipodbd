      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">Cosmetics</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Shared/Cosmetics
--// Процедурные модели одежды/аксессуаров (из деталей), применение скинов и эффектов к R15-модели.
local Config = require(script.Parent.Config)

local Cosmetics = {}
local Z = { 0, 0, 0 }

--// Формат детали: {прикрепление, форма, размер, позиция, поворот(°), цвет, материал, опции}
local function P(att, shape, size, pos, rot, col, mat, opt)
	return { att, shape, size, pos, rot or Z, col, mat or "Fabric", opt }
end

--// Одежда: оверлей на торс/руки/юбка
local function garment(col, mat, g, skirt)
	local parts = {
		P("UpperTorso", "Block", { 2 + g, 1.6 + g * 0.5, 1 + g }, { 0, 0, 0 }, Z, col, mat),
		P("LowerTorso", "Block", { 2 + g, 0.4 + g * 0.4, 1 + g }, { 0, 0, 0 }, Z, col, mat),
	}
	for _, side in ipairs({ "Left", "Right" }) do
		table.insert(parts, P(side .. "UpperArm", "Block", { 1 + g, 1.2, 1 + g }, { 0, 0, 0 }, Z, col, mat))
		table.insert(parts, P(side .. "LowerArm", "Block", { 1 + g * 0.9, 1.05, 1 + g * 0.9 }, { 0, 0, 0 }, Z, col, mat))
	end
	if skirt and skirt > 0 then
		table.insert(parts, P("LowerTorso", "Block", { 2 + g, skirt, 1 + g }, { 0, -(0.2 + skirt / 2), 0 }, Z, col, mat))
	end
	return parts
end

local function merge(a, b)
	for _, v in ipairs(b) do
		table.insert(a, v)
	end
	return a
end

local function wings(n, size, col, mat, tr)
	local parts = {}
	for _, side in ipairs({ -1, 1 }) do
		for i = 1, n do
			local len = size * (2.8 - 0.32 * i)
			parts[#parts + 1] = P("UpperTorso", "Block", { 0.08, len, 0.55 * size },
				{ side * (0.75 + 0.42 * i * size), 0.75 - 0.1 * i * size, 0.8 }, { 0, side * -12, -side * (14 + 9 * i) }, col, mat, { tr = tr })
		end
	end
	return parts
end

local function crown()
	local parts = { P("Head", "Cylinder", { 0.3, 1.5, 1.5 }, { 0, 0.82, 0 }, { 0, 0, 90 }, "gold", "Metal") }
	for i = 0, 5 do
		local a = math.rad(i * 60)
		parts[#parts + 1] = P("Head", "Block", { 0.18, 0.42, 0.18 }, { math.cos(a) * 0.66, 1.12, math.sin(a) * 0.66 }, Z, "gold", "Metal")
	end
	parts[#parts + 1] = P("Head", "Ball", { 0.22, 0.22, 0.12 }, { 0, 0.86, -0.78 }, Z, "glow", "Neon")
	return parts
end

