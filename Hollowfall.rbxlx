      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">AnimLib</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Shared/AnimLib
--// Процедурные анимации R15-моделей через Motor6D.Transform (без внешних ассетов).
--// Клиент прогоняет Update() каждый кадр для каждого персонажа.
local AnimLib = {}
AnimLib.__index = AnimLib

local NAMES = {
	"Root", "Waist", "Neck",
	"RightShoulder", "RightElbow", "RightWrist", "LeftShoulder", "LeftElbow", "LeftWrist",
	"RightHip", "RightKnee", "RightAnkle", "LeftHip", "LeftKnee", "LeftAnkle",
}
local ID = CFrame.new()
local A = CFrame.Angles
local sin, cos, abs, max, clamp = math.sin, math.cos, math.abs, math.max, math.clamp

local function blank()
	local t = {}
	for _, n in ipairs(NAMES) do
		t[n] = ID
	end
	return t
end

function AnimLib.new(model)
	local self = setmetatable({}, AnimLib)
	self.model = model
	self.motors = {}
	self.cur = blank()
	self.t = math.random() * 10
	self.phase = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			for _, n in ipairs(NAMES) do
				if d.Name == n then
					self.motors[n] = d
				end
			end
		end
	end
	return self
end

function AnimLib:Compute(inp)
	local T = blank()
	local t = self.t
	local ph = self.phase
	local s, c = sin(ph), cos(ph)
	local speed = inp.speed or 0
	local moving = speed > 0.8
	local state = inp.state or "Healthy"
	local style = inp.style or ""
	local amp = 0
	if moving then
		amp = clamp(0.3 + speed / 16 * 0.7, 0, 1.15)
	end
	local rate = 14

	local br = sin(t * 1.6) * 0.02
	T.Waist = A(br, 0, 0)
	T.Neck = A(-br * 0.5, sin(t * 0.45) * 0.06, 0)
	T.RightShoulder = A(0, 0, 0.07)
	T.LeftShoulder = A(0, 0, -0.07)
	T.RightElbow = A(0.12, 0, 0)
	T.LeftElbow = A(0.12, 0, 0)

	--// ---------- особые состояния
	if state == "Downed" then
		local sw = moving and 1 or 0
		T.Root = CFrame.new(0, -2.25, 0.2) * A(-1.5, 0, 0)
		T.Neck = A(1.0, 0, 0)
		T.RightShoulder = A(-2.7 + s * 0.45 * sw, 0, 0.35)
		T.LeftShoulder = A(-2.7 - s * 0.45 * sw, 0, -0.35)
		T.RightElbow = A(0.5 + max(0, s) * 0.6 * sw, 0, 0)
		T.LeftElbow = A(0.5 + max(0, -s) * 0.6 * sw, 0, 0)
		T.RightHip = A(0.1 + s * 0.2 * sw, 0, 0.1)
		T.LeftHip = A(0.1 - s * 0.2 * sw, 0, -0.1)
		T.RightKnee = A(-0.3, 0, 0)
		T.LeftKnee = A(-0.3, 0, 0)
		return T, rate
	elseif state == "Hooked" then
		local stage = inp.hookStage or 1
		local struggle = stage >= 2 and sin(t * 9) * 0.06 or 0
		T.Root = CFrame.new(0, 0.4, 0) * A(0, 0, struggle)
		T.Neck = A(0.45 + sin(t * 1.3) * 0.08, 0, 0)
		T.Waist = A(0.15, 0, 0)
		T.RightShoulder = A(-2.95, 0, 0.35)
		T.LeftShoulder = A(-2.95, 0, -0.35)
		T.RightElbow = A(0.1, 0, 0)
		T.LeftElbow = A(0.1, 0, 0)
		T.RightHip = A(sin(t * 1.4) * 0.12 + struggle * 4, 0, 0)
		T.LeftHip = A(-sin(t * 1.4) * 0.12 - struggle * 4, 0, 0)
		T.RightKnee = A(-0.2, 0, 0)
		T.LeftKnee = A(-0.2, 0, 0)
		return T, rate
	elseif state == "Carried" then
		T.Root = A(0, 0, 0)
		T.Waist = A(0.6, 0, 0)
		T.Neck = A(0.3, 0, 0)
		T.RightShoulder = A(-3.0 + sin(t * 2) * 0.1, 0, 0.3)
		T.LeftShoulder = A(-3.0 - sin(t * 2) * 0.1, 0, -0.3)
		T.RightHip = A(0.2, 0, 0)
		T.LeftHip = A(0.1, 0, 0)
		T.RightKnee = A(-0.4, 0, 0)
		T.LeftKnee = A(-0.2, 0, 0)
		return T, rate
	end

	--// ---------- перемещение
	if inp.vault then
		T.Root = CFrame.new(0, 0.3, 0) * A(-0.25, 0, 0)
		T.RightHip = A(1.3, 0, 0)
		T.LeftHip = A(-0.25, 0, 0)
		T.RightKnee = A(-1.5, 0, 0)
		T.LeftKnee = A(-0.8, 0, 0)
		T.RightShoulder = A(-2.1, 0, 0.2)
		T.LeftShoulder = A(-2.1, 0, -0.2)
		return T, 18
	end

	if moving then
		T.RightHip = A(s * amp, 0, 0)
		T.LeftHip = A(-s * amp, 0, 0)
		T.RightKnee = A(-max(0, c) * amp * 1.3, 0, 0)
		T.LeftKnee = A(-max(0, -c) * amp * 1.3, 0, 0)
		T.RightShoulder = A(-s * amp * 0.9, 0, 0.07)
		T.LeftShoulder = A(s * amp * 0.9, 0, -0.07)
		local eb = 0.15 + amp * 0.55
		T.RightElbow = A(eb, 0, 0)
		T.LeftElbow = A(eb, 0, 0)
		local lean = amp * 0.1 + (inp.sprint and 0.1 or 0)
		T.Waist = A(-lean, s * amp * 0.12, 0)
		T.Neck = A(lean * 0.8, -s * amp * 0.06, 0)
		T.Root = CFrame.new(0, -abs(s) * amp * 0.08, 0)
	end

	if inp.crouch or style == "style_stealth" then
		local deep = inp.crouch and 1 or 0.5
		local sw = moving and amp * 0.35 or 0
		T.Root = CFrame.new(0, -1.05 * deep, 0)
		T.RightHip = A(1.15 * deep + s * sw, 0, 0)
		T.LeftHip = A(1.15 * deep - s * sw, 0, 0)
		T.RightKnee = A(-2.0 * deep, 0, 0)
		T.LeftKnee = A(-2.0 * deep, 0, 0)
		T.RightAnkle = A(0.85 * deep, 0, 0)
		T.LeftAnkle = A(0.85 * deep, 0, 0)
		T.Waist = A(-0.3 * deep, 0, 0)
		T.Neck = A(0.3 * deep, 0, 0)
		T.RightShoulder = A(-0.4, 0, 0.07)
		T.LeftShoulder = A(-0.4, 0, -0.07)
		T.RightElbow = A(0.7, 0, 0)
		T.LeftElbow = A(0.7, 0, 0)
	end

	if style == "style_zombie" then
		T.RightShoulder = A(-1.5 + s * amp * 0.1, 0, 0.1)
		T.LeftShoulder = A(-1.5 - s * amp * 0.1, 0, -0.1)
		T.RightElbow = A(0.15, 0, 0)
		T.LeftElbow = A(0.15, 0, 0)
		T.Waist = A(-0.15, 0, sin(t * 1.2) * 0.04)
		T.Neck = A(0.1, 0, 0.22)
	elseif style == "style_ninja" and moving then
		T.RightShoulder = A(1.2, 0, 0.1)
		T.LeftShoulder = A(1.2, 0, -0.1)
		T.RightElbow = A(0.2, 0, 0)
		T.LeftElbow = A(0.2, 0, 0)
		T.Waist = A(-0.5, 0, 0)
		T.Neck = A(0.5, 0, 0)
	end

	--// ---------- ранен
	if state == "Injured" then
		T.Waist = T.Waist * A(-0.1, 0, 0.05)
		T.Neck = T.Neck * A(0.1, 0, 0)
		T.LeftShoulder = A(-0.5, 0, -0.15)
		T.LeftElbow = A(1.5, 0, 0)
	end

	--// ---------- убийцы: фирменная осанка
	local kid = inp.killerId
	if kid == "reaper" then
		T.RightShoulder = A(-0.25 - (moving and s * amp * 0.25 or 0), 0, 0.1)
		T.RightElbow = A(0.5, 0, 0)
		T.Waist = A(-0.08 - (moving and 0.08 or 0), s * amp * 0.1, 0)
	elseif kid == "whisper" then
		T.RightShoulder = A(-0.25 + (moving and -s * amp * 0.3 or 0), 0, 0.12)
		T.LeftShoulder = A(-0.25 + (moving and s * amp * 0.3 or 0), 0, -0.12)
		T.RightElbow = A(0.35, 0, 0)
		T.LeftElbow = A(0.35, 0, 0)
		T.Neck = A(-0.1, sin(t * 0.8) * 0.15, 0.25)
		T.Waist = A(-0.22, s * amp * 0.1, 0)
	elseif kid == "puppeteer" then
		T.RightShoulder = A(-0.95 + sin(t * 2.4) * 0.08, 0, 0.12)
		T.RightElbow = A(1.15 + sin(t * 3.1) * 0.1, 0, 0)
		T.Waist = A(-0.04, s * amp * 0.08, 0)
	elseif kid == "crow" then
		T.Waist = A(-0.38 - (moving and 0.06 or 0), s * amp * 0.1, 0)
		T.Neck = A(0.42, sin(t * 0.7) * 0.25, 0)
		T.LeftElbow = A(0.9, 0, 0)
	end

	if inp.carrying then
		T.RightShoulder = A(-1.3, 0, 0.3)
		T.LeftShoulder = A(-1.3, 0, -0.3)
		T.RightElbow = A(1.4, 0, 0)
		T.LeftElbow = A(1.4, 0, 0)
	end

	--// ---------- эмоции
	local em = inp.emote
	if em and em ~= "" and not moving and not inp.crouch then
		if em == "emote_wave" then
			T.RightShoulder = A(0, 0, 2.5 + sin(t * 8) * 0.28)
			T.RightElbow = A(0.3, 0, 0)
			T.Neck = A(0, 0.2, 0.1)
		elseif em == "emote_salute" then
			T.RightShoulder = A(-2.4, 0, 0.1)
			T.RightElbow = A(0.2, 0, 0)
			T.Waist = A(0.05, 0, 0)
		elseif em == "emote_dance" then
			local b = sin(t * 6)
			T.Root = CFrame.new(0, -abs(b) * 0.28, 0) * A(0, sin(t * 3) * 0.3, 0)
			T.Waist = A(0, 0, sin(t * 3) * 0.14)
			T.RightShoulder = A(0, 0, 1.3 + b * 0.5)
			T.LeftShoulder = A(0, 0, -(1.3 - b * 0.5))
			T.RightElbow = A(0.6, 0, 0)
			T.LeftElbow = A(0.6, 0, 0)
			T.RightHip = A(b * 0.4, 0, 0)
			T.LeftHip = A(-b * 0.4, 0, 0)
			T.RightKnee = A(-max(0, b) * 0.9, 0, 0)
			T.LeftKnee = A(-max(0, -b) * 0.9, 0, 0)
			T.Neck = A(0, 0, -sin(t * 3) * 0.12)
			rate = 20
		elseif em == "emote_flex" then
			T.RightShoulder = A(0, 0, 2.3)
			T.LeftShoulder = A(0, 0, -2.3)
			T.RightElbow = A(sin(t * 3) * 0.2, 0, 0)
			T.LeftElbow = A(sin(t * 3) * 0.2, 0, 0)
			T.Waist = A(0.1, 0, 0)
			T.Neck = A(-0.1, 0, 0)
		elseif em == "emote_pray" then
			T.RightShoulder = A(-1.0, 0, -0.1)
			T.LeftShoulder = A(-1.0, 0, 0.1)
			T.RightElbow = A(2.0, 0, 0)
			T.LeftElbow = A(2.0, 0, 0)
			T.Waist = A(-0.2, 0, 0)
			T.Neck = A(-0.35, 0, 0)
		end
	end

	--// ---------- оглушение
	if inp.stunned then
		T.RightShoulder = A(-2.7, 0, 0.2)
		T.LeftShoulder = A(-2.7, 0, -0.2)
		T.RightElbow = A(1.6, 0, 0)
		T.LeftElbow = A(1.6, 0, 0)
		T.Waist = A(-0.4, sin(t * 14) * 0.08, 0)
		T.Neck = A(-0.4, 0, 0)
	end

	--// ---------- атака убийцы
	local ag = inp.attackAge
	if ag and ag >= 0 and ag < 0.75 then
		local W = { sh = A(-2.5, 0, 0.4), el = A(0.7, 0, 0), wa = A(0.1, -0.5, 0) }
		local S = { sh = A(0.2, 0, -0.1), el = A(0.15, 0, 0), wa = A(-0.35, 0.9, 0) }
		local N = { sh = T.RightShoulder, el = T.RightElbow, wa = T.Waist }
		local from, to, u
		if ag < 0.2 then
			from, to, u = N, W, ag / 0.2
		elseif ag < 0.38 then
			from, to, u = W, S, (ag - 0.2) / 0.18
		else
			from, to, u = S, N, (ag - 0.38) / 0.37
		end
		T.RightShoulder = from.sh:Lerp(to.sh, u)
		T.RightElbow = from.el:Lerp(to.el, u)
		T.Waist = from.wa:Lerp(to.wa, u)
		rate = 35
	end

	return T, rate
end

--// inp: speed, state, crouch, sprint, emote, style, attackAge, killerId, carrying, stunned, vault, hookStage
function AnimLib:Update(dt, inp)
	self.t = self.t + dt
	if (inp.speed or 0) > 0.8 then
		self.phase = self.phase + dt * (inp.speed or 0) * 0.55
	end
	local T, rate = self:Compute(inp)
	local a = 1 - math.exp(-dt * rate)
	for _, n in ipairs(NAMES) do
		local m = self.motors[n]
		if m then
			local cur = self.cur[n]:Lerp(T[n], a)
			self.cur[n] = cur
			m.Transform = cur
		end
	end
end

function AnimLib:Reset()
	for _, n in ipairs(NAMES) do
		local m = self.motors[n]
		if m then
			m.Transform = ID
		end
		self.cur[n] = ID
	end
end

return AnimLib
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--// HOLLOWFALL :: Shared/Config
--// Единый источник данных: правила, персонажи, убийцы, скины, магазин, карты, звук.
local Config = {}

Config.GameName = "HOLLOWFALL"
Config.Tagline = "Туман приходит ночью. Не все выходят из него."
Config.DataStoreName = "Hollowfall_Profile_v1"
Config.Currency = "Осколки"

Config.Rarity = {
	Common = { name = "Обычный", color = Color3.fromRGB(156, 163, 175), order = 1 },
	Rare = { name = "Редкий", color = Color3.fromRGB(59, 130, 246), order = 2 },
	Epic = { name = "Эпический", color = Color3.fromRGB(168, 85, 247), order = 3 },
	Legendary = { name = "Легендарный", color = Color3.fromRGB(245, 158, 11), order = 4 },
}

--// ПРАВИЛА МАТЧА / БАЛАНС
Config.Rules = {
	MatchTime = 600, -- секунд
	Intro = 6, -- заморозка перед стартом
	SurvivorCount = 4,
	MinPlayersToStart = 2, -- при меньшем числе игроков матч с ботами стартует после таймера поиска
	SearchTime = 20, -- сколько ждём других игроков перед заполнением ботами
	FullQueueDelay = 5,
	ResultsTime = 12,

	GenTotal = 7,
	GenNeeded = 5,
	RepairTime = 70, -- секунд при одном ремонтнике
	SabotageTime = 2.4,
	SabotageLoss = 14, -- % потери прогресса
	SkillCheckEvery = { 7, 13 },
	SkillCheckFail = 7, -- % штраф
	SkillCheckGood = 1.5,
	SkillCheckGreat = 3,

	HealTime = 14,
	SelfHealTime = 34,
	UnhookTime = 3.5,
	GateTime = 12,
	PickupTime = 1.3,
	HangTime = 1.6,
	PalletBreakTime = 2.3,
	PalletStun = 2.0,
	LockerSearchTime = 1.6,
	LockerEnterTime = 0.5,
	HookTimes = { 60, 32 }, -- первый и второй крюк; третий — смерть
	BleedOut = 80,
	SnareTime = 2.5,

	VaultSurvivor = 0.65,
	VaultKiller = 1.15,

	AttackWindup = 0.2,
	AttackRange = 7.2,
	AttackMissCd = 1.2,
	AttackHitCd = 2.1,
	LungeSpeed = 11, -- прибавка скорости во время броска
	LungeTime = 0.35,

	SurvWalk = 10,
	SurvRun = 16,
	SurvCrouch = 5.5,
	SurvCrawl = 3.2,
	HasteMul = 1.28,
